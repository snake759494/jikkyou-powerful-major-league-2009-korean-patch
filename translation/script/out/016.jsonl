{"id": 2602, "ko": "그럼 어떻게 낚는 거예요?{FC03}"}
{"id": 2603, "ko": "여기서 {FC07}원투낚시{FC05}를 한다.{FFE8:0387}{FC03}"}
{"id": 2604, "ko": "네, 여기서요?{FC01}{F128}150야드는 되겠는데요.{F113}{FC03}"}
{"id": 2605, "ko": "그래.{FC01}{F120}하지만 내 어깨라면 못 닿을 거리는 아니지.{FC01}{F121}보여 주마.{FC03}{F120}{F001}{F126}이얍!!{FC03}"}
{"id": 2606, "ko": "오오, 정말 닿았다!{FC01}{F137}역시 메이저리거.{FC03}"}
{"id": 2607, "ko": "전 메이저리거야.{FC01}지금은 너희 동료니까.{FC03}{F120}{F124}그러니까 너도 해 봐.{FC03}"}
{"id": 2608, "ko": "네!{FC01}{F12F}무리예요.{FC03}"}
{"id": 2609, "ko": "무리고 뭐고, 안 하면 고기는 못 낚아.{FC03}"}
{"id": 2610, "ko": "하아.{FC01}{F123}그럼 갑니다.{FC03}"}
{"id": 2611, "ko": "얍!!{FC03}"}
{"id": 2612, "ko": "몇십 야드쯤인가.{FC03}"}
{"id": 2613, "ko": "대단하잖아!{FC01}{F121}이제 내가 가르칠 건 아무것도 없어.{FC03}"}
{"id": 2614, "ko": "네에??{FC03}"}
{"id": 2615, "ko": "그 낚싯대는 빌려줄 테니 나머진 맘대로 낚아.{FC01}{F12F}참고로 여기 메기는 정말 맛있어.{FC01}{F121}낚으면 집에서 먹는 게 좋아.{FC03}"}
{"id": 2616, "ko": "고, 고맙습니다.{FC03}"}
{"id": 2617, "ko": "꽤 멀리 던졌군.{FC01}{F12F}조금만 더 하면 돼.{FC03}{F120}{F124}여기서 종일 던지는 연습을 해 봐.{FC01}{F121}언젠가 고기가 낚일 거다.{FC03}"}
{"id": 2618, "ko": "그럭저럭 날았군.{FC01}{F125}하지만 이래선 일반인과 다를 게 없어.{FC01}{F123}우린 프로 야구 선수야.{FC03}{F124}그런 힘으론 프로로서 망신이야{FC03}"}
{"id": 2619, "ko": "알겠습니다.{FC01}{F123}더 연습해서 멀리 던지겠습니다.{FC03}"}
{"id": 2620, "ko": "전혀 늘지 않았군.{FC01}"}
{"id": 2621, "ko": "역시 말도 안 돼.{FC03}"}
{"id": 2622, "ko": "크, 크윽.{FC03}"}
{"id": 2623, "ko": "연습으로 근력을 더 붙여 보라고.{FC05}{FC03}"}
{"id": 2624, "ko": "전혀 안 돼.{FC01}"}
{"id": 2625, "ko": "말도 안 돼.{FC03}"}
{"id": 2626, "ko": "크, 크윽.{FC01}"}
{"id": 2627, "ko": "던지는 요령은 없어요?{FC03}"}
{"id": 2628, "ko": "있지만 그런 것에 기대면 안 돼.{FC01}"}
{"id": 2629, "ko": "야구 선수라면 네 힘만으로\n"}
{"id": 2630, "ko": "150야드 날려 봐!{FC03}"}
{"id": 2631, "ko": "연습으로 근력을 더 붙이자.{FC05}{FC03}"}
{"id": 2632, "ko": "아, {FFE8:026F}씨, 오늘도 낚시 가르쳐 줄래요{FC03}"}
{"id": 2633, "ko": "그래, 좋고말고.{FC03}{F120}{FC22}"}
{"id": 2634, "ko": "고기는 늘 포인트에 있어.{FC01}{F121}여기서 힘껏 던져 저 포인트에\n떨어뜨리는 거다.{FC03}"}
{"id": 2635, "ko": "그럼 갑니다.{FC03}"}
{"id": 2636, "ko": "라고 하고 싶지만 오늘은\n공교롭게 고기가 없어서.{FC03}"}
{"id": 2637, "ko": "어쩔 수 없지.{FC01}{F121}스포츠맨답게 시내까지 뛰어서 갈까?{FC03}"}
{"id": 2638, "ko": "아뇨, 오늘은 좀{FFE8:02D3}{FC03}"}
{"id": 2639, "ko": "그래?{FC01}{F123}뭐, 맨날 운동만 하면 지치겠지.{FC01}{F121}좋아, 오늘은 내가 스테이크를 쏘마!{FC03}"}
{"id": 2640, "ko": "앗싸!!{F110}{FC03}"}
{"id": 2641, "ko": "아~, 왠지 한가하네{FFE8:02D3}.{FC03}"}
{"id": 2642, "ko": "아~, 왠지 몸이 나른하네{FFE8:02D3}.{FC03}"}
{"id": 2643, "ko": "응?{FC01}거기 당신, 잠깐 기다려요~!{FC03}"}
{"id": 2644, "ko": "어, 저요?{FC03}"}
{"id": 2645, "ko": "그래요, 당신!{FC01}"}
{"id": 2646, "ko": "보아하니 컨디션 나빠 보여요?{FC03}"}
{"id": 2647, "ko": "하아, 야구 연습에서 좀 무리를\n했나 봐요{FFE8:02D3}{FC03}"}
{"id": 2648, "ko": "엄청 한가해 보여요?{FC03}"}
{"id": 2649, "ko": "아뇨, 야구 연습하러 가는\n길이에요.{FC03}"}
{"id": 2650, "ko": "오우, 당신 애슬리트예요!{FC01}"}
{"id": 2651, "ko": "그러면 나한테 맡겨요~!{FC01}"}
{"id": 2652, "ko": "좋은 치료 해요!!{FC03}"}
{"id": 2653, "ko": "애슬리트는 몸이 중요.{FC01}"}
{"id": 2654, "ko": "메인터넌스, 내가 해 줘요!{FC03}"}
{"id": 2655, "ko": "당신은 대체 누구세요?{FC03}"}
{"id": 2656, "ko": "나는\n{FFE8:027B}예요.{FC01}"}
{"id": 2657, "ko": "스포츠 의학 해요!!{FC03}"}
{"id": 2658, "ko": "스포츠 의학?{FC03}"}
{"id": 2659, "ko": "그래요.{FC01}나는 스포츠 의학의 권위예요.{FC01}"}
{"id": 2660, "ko": "내 치료 받을래요?"}
{"id": 2661, "ko": "나한테 메인터넌스 맡겨요?"}
{"id": 2662, "ko": "모처럼이니 부탁해 볼까.{FC03}"}
{"id": 2663, "ko": "그래요.\n{F123}그럼 바로 내 연구실에\n가요.{FC03}"}
{"id": 2664, "ko": "아뇨, 관심 없으니 사양할게요.{FC03}"}
{"id": 2665, "ko": "그래요.\n그럼 맘대로 해요.{FC01}{F125}아까운 사람 놓쳤어요.{FC03}"}
{"id": 2666, "ko": "무슨 말인지{FFE8:02D3}.{FC03}"}
{"id": 2667, "ko": "아~, 왠지 몸이 나른하네{FFE8:02D3}{FC03}"}
{"id": 2668, "ko": "오우~, 당신 기운 없어요{FC03}"}
{"id": 2669, "ko": "어, 누구셨더라!?{FC03}"}
{"id": 2670, "ko": "나, {FFE8:027B}예요!{FC01}"}
{"id": 2671, "ko": "나를 잊다니 꽤~애\n몸이 지쳐 있어요.{FC01}바로 치료해요~.{FC03}"}
{"id": 2672, "ko": "치료?{FC03}"}
{"id": 2673, "ko": "다이죠부!{FC01}나한테 맡겨요~.{FC03}{F123}그럼 바로 내 연구실에\n가요.{FC03}"}
{"id": 2674, "ko": "자~, 어떤 치료를\n원해요?{FC03}"}
{"id": 2675, "ko": "음, 글쎄{FFE8:02D3}{FC03}"}
{"id": 2676, "ko": "없다"}
{"id": 2677, "ko": "심신을 개운하게"}
{"id": 2678, "ko": "약점을 없애고 싶다"}
{"id": 2679, "ko": "부상에 강해지고파"}
{"id": 2680, "ko": "더 강해지고 싶다"}
{"id": 2681, "ko": "생각해 봤는데, 딱히\n심각한 몸 이상은 없어요.{FC03}"}
{"id": 2682, "ko": "오우~, 그래요?{FC01}내 눈엔 여기저기 다친 것처럼\n보여요.{FC03}"}
{"id": 2683, "ko": "아뇨, 정말 괜찮은데{FFE8:02D3}.{FC03}"}
{"id": 2684, "ko": "절대 안 괜찮아요.{FC01}{F120}적어도 이거 마셔요~.{FC03}"}
{"id": 2685, "ko": "뭐, 뭐예요?\n이 걸쭉한 하얀 액체는?{FC03}"}
{"id": 2686, "ko": "내가 조합한 특제\n원기 드링크예요!{FC03}"}
{"id": 2687, "ko": "아, 아니, 정말 쌩쌩해요{FFE8:02D3}.{FC03}"}
{"id": 2688, "ko": "당신 위해 열심히 만들었는데{FFE8:02D3}{FC03}"}
{"id": 2689, "ko": "그래요?{FC01}{F134}그, 그럼 잘 마실게요.{FC03}"}
{"id": 2690, "ko": "응? 어라~?{FC01}왠지 졸려{FFE8:02D3}.{FC03}"}
{"id": 2691, "ko": "자, 본인 동의 없인 치료 못 해요\n그러니 돌려보내요.{FC03}"}
{"id": 2692, "ko": "으음, 따끈따끈\n{FFE8:02D3}말랑말랑 몽글몽글.{FC03}"}
{"id": 2693, "ko": "자네,\n이런 데서 뭐 하고 있양스?{FC03}"}
{"id": 2694, "ko": "무슨 꿈을 꿨양스?{FC03}"}
{"id": 2695, "ko": "그건 그게{FFE8:02D3}어라?{FC01}여긴?{FC03}"}
{"id": 2696, "ko": "공원이양스.{FC03}"}
{"id": 2697, "ko": "어?{FC01}어~, 뭐 하고 있었더라?{FC03}"}
{"id": 2698, "ko": "정신 차리양스!{FC03}"}
{"id": 2699, "ko": "뭐 했는지 기억 안 나지만\n뭐 괜찮겠지!{FC03}"}
{"id": 2700, "ko": "괜찮은 거양스!{FC03}"}
{"id": 2701, "ko": "자네,\n이런 데서 뭐 하고 있사옵니까?{FC03}"}
{"id": 2702, "ko": "무슨 꿈을 꾸었사옵니까?{FC03}"}
{"id": 2703, "ko": "공원이옵니다.{FC03}"}
{"id": 2704, "ko": "정신 차리시옵소서!{FC03}"}
{"id": 2705, "ko": "괜찮사옵니까!{FC03}"}
{"id": 2706, "ko": "자네,\n이런 데서 뭐 하고 있양스?{FC03}"}
{"id": 2707, "ko": "무슨 꿈을 꿨양스?{FC03}"}
{"id": 2708, "ko": "공원이양스.{FC03}"}
{"id": 2709, "ko": "정신 차리양스!{FC03}"}
{"id": 2710, "ko": "괜찮은 거양스!{FC03}"}
{"id": 2711, "ko": "심신을 개운하게 하고 싶군요!{FC01}{F123}그러면 좋은 장치 있어요.{FC03}{FC21}"}
{"id": 2712, "ko": "뭔가 삼엄한 철 캡슐이\n내려왔는데.{FC03}"}
{"id": 2713, "ko": "「초강력 상쾌 머신」이에요!{FC01}{F123}사우나 효과로 심신 모두 리프레시\n해요!{FC03}"}
{"id": 2714, "ko": "그렇구나!{FC01}사우나면 피로도 풀리고\n건강도 좋아지겠네요.{FC03}"}
{"id": 2715, "ko": "그럼 들어가요~.{FC03}"}
{"id": 2716, "ko": "네~에.{FC03}"}
{"id": 2717, "ko": "조, 좀 숨이 막히네요{FFE8:02D3}{FC03}"}
{"id": 2718, "ko": "그럼 지금부터 평소의\n256배 열과 압력으로\n사우나 효과를 강제 발생!{FC03}"}
{"id": 2719, "ko": "네? 안 들려!{FC01}잠까~안 기다려!{FC03}"}
{"id": 2720, "ko": "스위치 온!{FC03}{FC21}"}
{"id": 2721, "ko": "뜨거! {F139}답답해!{FC01}{F001}{F13C}우아아아아악!{FC03}"}
{"id": 2722, "ko": "약점이 없어지면 좋겠어요~.{FC03}"}
{"id": 2723, "ko": "야구엔 좌타자에 약한\n그런 게 있어서요.{FC03}"}
{"id": 2724, "ko": "야구엔 좌투수에 약한\n그런 게 있어서요.{FC03}"}
{"id": 2725, "ko": "그거 큰일이에요.{FC01}알겠어요!{FC01}내가 어떻게든 해요~!{FC03}"}
{"id": 2726, "ko": "이 위험한 헤드기어는{FFE8:02D3}?{FC03}"}
{"id": 2727, "ko": "어느새 씌워져 있잖아~!{FC03}"}
{"id": 2728, "ko": "이건 당신 뇌에서 약점 의식을\n제거하는 장치예요!{FC03}"}
{"id": 2729, "ko": "제거?{FC03}"}
{"id": 2730, "ko": "신속하게 없애 줘요~!{FC03}"}
{"id": 2731, "ko": "잠, {FC21}"}
{"id": 2732, "ko": "잠깐!{FC01}싫은 소리가{FFE8:02D3}{FC03}"}
{"id": 2733, "ko": "다이죠부!{FC01}금방 끝나요!{FC03}"}
{"id": 2734, "ko": "으갸아아아아아아아아아아아아아악!{FC03}"}
{"id": 2735, "ko": "으음, 역시\n부상에 강한 몸이 되고 싶어요.{FC03}"}
{"id": 2736, "ko": "과연, 알겠어요!{FC03}"}
{"id": 2737, "ko": "큰 상자, 이거 뭐예요?{FC03}"}
{"id": 2738, "ko": "설명하면 어렵지만 부상의\n대부분은 근육과 뼈의 파손이에요.{FC01}{F135}그러니 이걸 강화해요.{FC03}"}
{"id": 2739, "ko": "어떻게요?{FC03}"}
{"id": 2740, "ko": "시멘트로 굳혀서{FFE8:02D3}{FC03}"}
{"id": 2741, "ko": "왜 입 다물어! 대답해!!{FC01}{F001}{F139}앗! {FC21}"}
{"id": 2742, "ko": "어느새 장치 안에!!{FC03}"}
{"id": 2743, "ko": "닥치고 해요!{FC01}{F12C}스위치 온!{FC03}"}
{"id": 2744, "ko": "우구우우우우우우우우우우우우!{FC03}"}
{"id": 2745, "ko": "딱 잘라!\n강해지고 싶어요!{FC03}"}
{"id": 2746, "ko": "그럼 이 서류에 사인해 줘요.{FC01}"}
{"id": 2747, "ko": "잠깐만요"}
{"id": 2748, "ko": "여기 사인하면 되는 거죠.{FC03}{F003}{FC09}쓱싹쓱싹{FFE8:02D3}{FC05}{FC03}"}
{"id": 2749, "ko": "사인했어요.{FC03}"}
{"id": 2750, "ko": "으음, 딱 봐도 수상한 서류{FFE8:02D3}{FC03}"}
{"id": 2751, "ko": "사인 안 해 줘요?{FC01}아쉬워요.\n어쩔 수 없어요, 안전한 쪽으로 가요.{FC03}"}
{"id": 2752, "ko": "알겠어요.{FC01}그럼 다시 한 번 물어요.{FC01}어떤 치료를 원해요?{FC03}"}
{"id": 2753, "ko": "이쪽으로{FFE8:02D3}{FC03}"}
{"id": 2754, "ko": "왠지 달콤한 냄새가 나요.{FC03}"}
{"id": 2755, "ko": "꿀 냄새예요.{FC01}여기엔 꿀벌 집이 잔뜩\n있어요~.{FC03}"}
{"id": 2756, "ko": "왜 그런 게?{FC03}"}
{"id": 2757, "ko": "물론 치료를 위해서예요.{FC01}육체는 대미지에 대해\n저항력이 붙어요~!{FC03}"}
{"id": 2758, "ko": "그, 그 대미지라는 건\n설마{FFE8:02D3}?{FC03}"}
{"id": 2759, "ko": "어라!? 못 움직여!{FC03}"}
{"id": 2760, "ko": "그럼 벌집을 10개쯤\n떨어뜨려요~!{FC03}"}
{"id": 2761, "ko": "우와아아아!{FC01}그만해애!{FC03}"}
{"id": 2762, "ko": "아아아아악!!{FC03}"}
{"id": 2763, "ko": "자, 여기 앉아요.{FC03}"}
{"id": 2764, "ko": "여기요?{FC03}"}
{"id": 2765, "ko": "이제 못 도망가요{FFE8:02D3}.{FC03}"}
{"id": 2766, "ko": "후후, 각오하세요~.{FC03}"}
{"id": 2767, "ko": "박사님, 무슨 소리예요?{FC03}{F13A}어라!? 못 움직여!{FC03}"}
{"id": 2768, "ko": "자아{FFE8:02D3}.{FC01}나한테 모든 걸 맡기는 거예요{FFE8:02D3}.{FC03}"}
{"id": 2769, "ko": "바, 박사님!?{FC01}{F139}뭐, 뭐예요 그 눈!? 그 미소!{FC01}{F139}뭐예요!?\n그 장치는!{FC03}"}
{"id": 2770, "ko": "가요{FFE8:02D3}.{FC03}"}
{"id": 2771, "ko": "우, 우, 우와악!{FC03}"}
{"id": 2772, "ko": "후후후{FFE8:02D3}.{FC03}"}
{"id": 2773, "ko": "우와아아아아아아악!{FC03}"}
