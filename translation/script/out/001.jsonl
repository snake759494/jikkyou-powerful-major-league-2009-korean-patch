{"id": 165, "ko": "고마워요, 언니!{FC03}"}
{"id": 166, "ko": "그 조약돌 4개에는 이런 뜻이 있단다.{FC03}"}
{"id": 167, "ko": "큰 조약돌 2개는 아빠랑 엄마.{FC01}작은 2개는 우리들.{FC03}{F121}그러니까 가족이 언제까지나 함께하길\n바라는 소원이 담겨 있는 거야.{FC03}"}
{"id": 168, "ko": "그랬군요{FFE8:02D3}{FC03}"}
{"id": 169, "ko": "그럼 나도{FFE8:02D3}{FC03}"}
{"id": 170, "ko": "이 돌은?{F10D}{FC03}"}
{"id": 171, "ko": "나야.{FC03}"}
{"id": 172, "ko": "네? 언니랑 결혼하는 거예요?{FC03}"}
{"id": 173, "ko": "그, 그런 거 아냐.{FC01}{F125}그냥 나도 잊지 말아 줬으면 해서.{FC03}"}
{"id": 174, "ko": "응, 고마워요오!{FC01}"}
{"id": 175, "ko": "왠지 마음이 밝아진\n것 같아요오!{FC03}"}
{"id": 176, "ko": "그런데 언니는 왜 조약돌에 대해\n그렇게 잘 알아요?{FC03}"}
{"id": 177, "ko": "글쎄, 왜일까{FFE8:02D3}{FC03}"}
{"id": 178, "ko": "호수에 가자!{FC03}"}
{"id": 179, "ko": "어머, 내 일터네.{FC01}{F121}좋아, 가자.{FC03}"}
{"id": 180, "ko": "자, 여기 왔으니 일 좀 도와줘야겠어.{FC03}"}
{"id": 181, "ko": "응? 무슨 소리?{FC03}"}
{"id": 182, "ko": "걱정 마, 몫은 제대로 챙겨 줄 테니까.{FC03}"}
{"id": 183, "ko": "아니, 그게 아니라,\n"}
{"id": 184, "ko": "우리 데이트하러 온 거 아니었어?{FC03}"}
{"id": 185, "ko": "그럼 호수를 헤엄쳐 건널래?{FC01}"}
{"id": 186, "ko": "나한테 지면 맞는다?{FC03}"}
{"id": 187, "ko": "아뇨, 일 도울게요{FFE8:02D3}{F113}{FC03}"}
{"id": 188, "ko": "뭐, 돕는다고 해도 간단해.{FC01}"}
{"id": 189, "ko": "넌 내 묘기를 보고\n"}
{"id": 190, "ko": "대충 뭐라고 하면 돼.{FC03}"}
{"id": 191, "ko": "대충?{FC03}"}
{"id": 192, "ko": "아무거나 괜찮아. 뒤는 내가 알아서 할게.{FC03}"}
{"id": 193, "ko": "아, 알았어.{FC03}{FC29}"}
{"id": 194, "ko": "자, 어서 오세요, 구경하세요!{FC03}"}
{"id": 195, "ko": "오세요!{FC03}"}
{"id": 196, "ko": "신기한 문어 여인이올시다!!{FC03}"}
{"id": 197, "ko": "올시다!!{FC03}"}
{"id": 198, "ko": "뭐야?{FFE8:02D3}{FC03}"}
{"id": 199, "ko": "뭐야 뭐야{FFE8:02D3}{FC03}"}
{"id": 200, "ko": "내 몸은 말랑말랑 큐트!!{FC03}"}
{"id": 201, "ko": "좋다!!{FC03}"}
{"id": 202, "ko": "브리지!!{FC03}"}
{"id": 203, "ko": "와, 대단해!!{FC03}"}
{"id": 204, "ko": "자, 박수 박수!{FC03}"}
{"id": 205, "ko": "박수가 좀 모자라잖아!{FC03}"}
{"id": 206, "ko": "모자라요!{FC03}"}
{"id": 207, "ko": "너한테 한 말이야!!!{FC03}"}
{"id": 208, "ko": "죄, 죄송해요{FFE8:02D3}{FC03}"}
{"id": 209, "ko": "와하하하하!!!{FC03}{FC29}"}
{"id": 210, "ko": "오늘 고마웠어.{FC01}"}
{"id": 211, "ko": "자, 네 몫{FFE8:02D3}{FC03}"}
{"id": 212, "ko": "어, 이렇게나?{FC03}"}
{"id": 213, "ko": "그야, 맞는 거 힘들잖아?{FC03}"}
{"id": 214, "ko": "그럼 평소에 괜히 때리지 마{FFE8:02D3}{FC03}"}
{"id": 215, "ko": "뭐?{FC01}불만?{FC03}"}
{"id": 216, "ko": "아, 아뇨, 아무것도요{FFE8:02D3}{FC03}"}
{"id": 217, "ko": "는 {FFE8:029E}의 일을 도왔다{FC03}"}
{"id": 218, "ko": "산에 가자!{FC03}"}
{"id": 219, "ko": "어머, 좋지.{FC01}{F121}가자.{FC03}"}
{"id": 220, "ko": "자, 먹는 거야!!{FC03}"}
{"id": 221, "ko": "뭘 먹는데!?{FC03}"}
{"id": 222, "ko": "뻔하잖아.{FC01}"}
{"id": 223, "ko": "산 별미{FC05}!{FFE8:037D}{FC03}"}
{"id": 224, "ko": "산 별미라니?{FC03}"}
{"id": 225, "ko": "이 산에서는 버섯이나 꿀 같은 게\n"}
{"id": 226, "ko": "잔뜩 나거든!{FC03}"}
{"id": 227, "ko": "봐, 저기 꿀벌 집이!{FC03}"}
{"id": 228, "ko": "저, 정말!{FC01}"}
{"id": 229, "ko": "근데 벌이{FFE8:02D3}{FC03}"}
{"id": 230, "ko": "벌쯤이야 괜찮아.{FC01}"}
{"id": 231, "ko": "간파해서 쳐 떨어뜨리면 돼.{FC03}"}
{"id": 232, "ko": "간파하라니{FFE8:02D3}{FC03}"}
{"id": 233, "ko": "우가!!{FC03}"}
{"id": 234, "ko": "꺄악.{FC03}"}
{"id": 235, "ko": "자, 따 볼까?{FC03}"}
{"id": 236, "ko": "바, 바, 방금 곰 나왔지?{F113}{FC03}"}
{"id": 237, "ko": "아, 가끔 나와.{FC03}"}
{"id": 238, "ko": "걔들도 꿀을 엄청 좋아하거든~{FC03}"}
{"id": 239, "ko": "아, 네{FFE8:02D3}{FC03}"}
{"id": 240, "ko": "와 별미를 먹었다{FC03}"}
{"id": 241, "ko": "어머, 나도 마침 배고프던 참이야.{FC01}{F121}가자.{FC03}"}
{"id": 242, "ko": "이상하네.{FC01}먹을 만한 게 없어{FFE8:02D3}{FC03}"}
{"id": 243, "ko": "뭐, 산에 오른 것만으로 충분히\n운동이 됐으니 됐나.{FC03}"}
{"id": 244, "ko": "전~혀 안 괜찮거든.{FC03}{F124}나한텐 운동도 소화도 안 됐다고!{FC03}"}
{"id": 245, "ko": "그, 그래?{FC03}"}
{"id": 246, "ko": "아~ 풀고 싶다~{FC03}{F123}맞다, 오늘은 강가의 돌을\n가라테 촙으로 마구 깨자!{FC03}"}
{"id": 247, "ko": "되겠냐!{FC03}"}
{"id": 248, "ko": "어머, 되는데.{FC03}{F001}{F13B}이~얍!!{FC03}"}
{"id": 249, "ko": "봐, 간단하지?{F110}{FC01}{F123}자, 해 봐.{FC03}"}
{"id": 250, "ko": "아, 네.{F113}{FC03}{F001}{F13B}아쵸~!!!{FC03}"}
{"id": 251, "ko": "아야야!!!{FC03}"}
{"id": 252, "ko": "한심하긴~.{FC03}"}
{"id": 253, "ko": "야구 선수한테 이런 거 시키지 마!!{FC03}{F124}다치면 어쩔 건데!{FC03}"}
{"id": 254, "ko": "어머, 연약한 소녀인 내가 하는 걸\n넌 못 한다고?{FC03}"}
{"id": 255, "ko": "어디가 연약하다는 거야!!{FC01}{F124}그보다 너, 가라테 주니어 전국 대회에서\n우승한 적도 있다며?{FC03}"}
{"id": 256, "ko": "뭐?{FC01}그걸 어떻게{FFE8:02D3}{FC03}"}
{"id": 257, "ko": "운동 안 해 봤다는 거 거짓말이었어?{FC03}"}
{"id": 258, "ko": "응, 맞아{FFE8:02D3}{FC03}"}
{"id": 259, "ko": "왜 그런 거짓말을 해.{FC03}{FC29}"}
{"id": 260, "ko": "내가 행복하면 안 되니까{FFE8:02D3}{FC03}"}
{"id": 261, "ko": "무, 무슨 말?{FC03}{FC29}"}
{"id": 262, "ko": "우리 집은 옛날에 아빠가 사장이라서\n아주 부유했어.{FC03}{F121}갖고 싶은 건 뭐든 사 주셨고,\n생일엔 많은 사람이 축하해 줬지.{FC03}{F124}몸 움직이는 걸 좋아했던 나는\n테니스, 배구, 수영{FFE8:02D3}\n"}
{"id": 263, "ko": "좋아하는 스포츠의 영재 교육을\n마음껏 받을 수 있었어{FC03}"}
{"id": 264, "ko": "그래서 그렇게 유연하고 강하구나{FFE8:02D3}{FC03}"}
{"id": 265, "ko": "동생이 3살 때, 어떤 일로{FFE8:02D3}{FC01}"}
{"id": 266, "ko": "아빠 회사가 망해 버렸어{FFE8:02D3}{FC03}"}
{"id": 267, "ko": "그 뒤로 우린 먹을 것도 없을 만큼\n가난하게 살아야 했어.{FC03}{F120}나는 이렇게 좋은 재능을 받았는데,\n동생은 교육은커녕 생일 선물도 없었어{FFE8:02D3}{FC03}"}
{"id": 268, "ko": "그뿐인가, 먹을 것조차\n제대로 사 주지 못했어.{FC03}"}
{"id": 269, "ko": "그래서 동생은 늘 배를 곯았고,\n몸도 튼튼하지 못했어{FFE8:02D3}{FC03}"}
{"id": 270, "ko": "이건 불공평하잖아.{FC03}"}
{"id": 271, "ko": "그렇게 된 건 {FFE8:029E} 탓이 아니잖아.{FC03}"}
{"id": 272, "ko": "아니야!{FC01}"}
{"id": 273, "ko": "나만 행복해지는 건 용납 못 해{FC03}"}
{"id": 274, "ko": "가족은 모두가 행복해져야 하는 거야.{FC01}{F125}그런데 나만 좋은 일을 누리고{FFE8:02D3}{FC03}"}
{"id": 275, "ko": "있잖아?{FC01}교육도 제대로 못 받은 그 애가\n대학에 들어가려고 얼마나 고생했는지 알아?{FC03}{F123}그런데 돈이 없어서 퇴학이라니,\n너무 불쌍하잖아.{FC03}"}
{"id": 276, "ko": "그, 그 마음은 알겠지만{FFE8:02D3}{FC03}"}
{"id": 277, "ko": "그렇다고 네가 행복해지면\n안 될 이유는 없어.{FC03}"}
{"id": 278, "ko": "가족 모두가 행복해져야 한다며?{FC01}너만 불행해지면 어쩌자는 거야.{FC03}"}
{"id": 279, "ko": "너는 평범한 거리 예인으로 끝나기엔\n아까울 만큼 재능이 넘쳐.{FC03}{F121}과거에 얽매이지 말고 더 양지에서\n활약해야 해.{FC03}"}
{"id": 280, "ko": "하지만 난 학력도 경력도 없으니까\n이제 와서 써 줄 데도 없어.{FC01}아르바이트할 바에는\n지금이 더 벌이가 좋고.{FC03}"}
{"id": 281, "ko": "꿈이 없네.{FC03}"}
{"id": 282, "ko": "는 어릴 때\n"}
{"id": 283, "ko": "사실 뭐가 되고 싶었어?{FC03}"}
{"id": 284, "ko": "그건 역시 운동선수려나?{FC03}"}
{"id": 285, "ko": "그럼 그 꿈을 좇으면 돼.{FC03}"}
{"id": 286, "ko": "하지만 난{FFE8:02D3}{FC03}"}
{"id": 287, "ko": "가족은 모두가 행복해져야 한다며?{FC03}"}
{"id": 288, "ko": "나도{FFE8:02D3}{FC01}"}
{"id": 289, "ko": "행복해져도 되는 걸까{FFE8:02D3}{FC03}"}
{"id": 290, "ko": "당연하지.{FC03}"}
{"id": 291, "ko": "고마워, {F010}!!{FC03}{FC29}"}
{"id": 292, "ko": "그런 의미에서 내놔.{FC03}"}
{"id": 293, "ko": "돈 말이야!!{FC03}{F123}테스트가 공짜일 리 없고,\n일 쉬는 동안에도 학비는 들어!{FC03}"}
{"id": 294, "ko": "뭐, 나한테 뜯겠다고?{FC03}"}
{"id": 295, "ko": "네가 방금 나더러 꿈을 좇으라고 멋진 말\n했잖아!{FC03}{F125}게다가 기댈 사람은 너밖에 없고{FFE8:02D3}{FC01}"}
{"id": 296, "ko": "일단 200달러면 돼.{FC03}"}
{"id": 297, "ko": "뭐야, 쩨쩨하긴.{FC01}{F124}그럼 100달러로 깎아 줄게.{FC03}"}
{"id": 298, "ko": "잠깐, 무슨 할인이야 그게?{F113}{FC03}"}
{"id": 299, "ko": "됐고, 낼 거야, 말 거야?{FC03}"}
{"id": 300, "ko": "뭐야, 한심하긴!!{FC03}{F123}됐어.{FC01}내 돈으로 할게.{FC03}"}
{"id": 301, "ko": "돈 있잖아!!!{FC03}"}
{"id": 302, "ko": "누군가의 생일 선물을 사려고\n모아 둔 돈이야.{FC03}"}
{"id": 303, "ko": "누군가가 누군데?{F10D}{FC03}"}
{"id": 304, "ko": "정말 너무 둔해!!{FC03}"}
{"id": 305, "ko": "근데 100달러도 없네.{FC03}"}
{"id": 306, "ko": "고마워!!{FC03}"}
{"id": 307, "ko": "왜 때려?{FC03}"}
{"id": 308, "ko": "미안.{FC01}네 말 듣고 기운이 나서 그만.{FC03}"}
{"id": 309, "ko": "근데 그렇게 돈이 없네.{FC03}"}
{"id": 310, "ko": "바다에 가자!{FC03}"}
{"id": 311, "ko": "어머, 또 단련하게?{FC01}{F121}좋아.{FC03}"}
{"id": 312, "ko": "못 이기겠어{FFE8:02D3}{FC03}"}
{"id": 313, "ko": "그렇게 강하면 여러 스포츠에서\n"}
{"id": 314, "ko": "챔피언을 노릴 수 있잖아.{FC01}"}
{"id": 315, "ko": "길거리{FC07}예인{FC05}보다 훨씬 벌이가 좋을걸.{FFE8:036F}{FC03}"}
{"id": 316, "ko": "싫어.{FC01}"}
{"id": 317, "ko": "난 연약한 소녀이고 싶단 말이야.{FC03}"}
{"id": 318, "ko": "게다가 남을 즐겁게 하면 나도 즐거워서,\n"}
{"id": 319, "ko": "이 일이 좋아.{FC03}"}
{"id": 320, "ko": "그, 그 마음은 알겠지만{FFE8:02D3}{FC01}"}
{"id": 321, "ko": "거리 예인으론 {FFE8:029D}의 학비가 힘들잖아?{FC03}"}
{"id": 322, "ko": "아, 거리 예인을 무시하는군.{FC01}"}
{"id": 323, "ko": "이래 봬도 보통 알바보다는 벌이가 좋거든.{FC03}"}
{"id": 324, "ko": "뭐, 그렇다 해도 수입이 많다곤 못 하잖아?{FC03}"}
{"id": 325, "ko": "뭐, 그렇지.{FC01}"}
{"id": 326, "ko": "나도 몇 번 본격적으로 운동을\n"}
{"id": 327, "ko": "시작한 적 있어.{FC01}"}
{"id": 328, "ko": "하지만 늘 금방 그만두게 됐지.{FC03}"}
{"id": 329, "ko": "왜?{FC03}"}
{"id": 330, "ko": "코치를 때려 버려서.{FC03}"}
{"id": 331, "ko": "아야야!!!{FC03}"}
{"id": 332, "ko": "아직 아무 말도 안 했어!{FC03}"}
{"id": 333, "ko": "눈이 살짝 웃고 있었어!{FC03}"}
{"id": 334, "ko": "그보다 사람 때리는 거 못 참아?{FC03}"}
{"id": 335, "ko": "뭐, 못 참을 것도 없지.{FC01}"}
{"id": 336, "ko": "가족, 여자, 애는 안 때려.{FC01}"}
{"id": 337, "ko": "다만 너 같은 젊은 남자는 안 돼.{FC01}"}
{"id": 338, "ko": "보고만 있어도 짜증 날 때가 있어!{FC03}"}
{"id": 339, "ko": "그럼 갈게.{FC03}"}
{"id": 340, "ko": "가면 안 돼!{FC03}"}
{"id": 341, "ko": "왜?{FC01}"}
{"id": 342, "ko": "나 보면 짜증 난다며?{FC03}"}
{"id": 343, "ko": "가 버리면 못 때리잖아!!{FC03}"}
{"id": 344, "ko": "간다!{FC03}"}
{"id": 345, "ko": "그래.{FC03}"}
{"id": 346, "ko": "와 바다에서 수행{FC03}"}
{"id": 347, "ko": "전혀 이길 것 같지 않아{FFE8:02D3}{FC03}"}
{"id": 348, "ko": "너 약점 같은 거 없냐?{FC03}"}
{"id": 349, "ko": "없진 않아.{FC01}"}
