{"id": 9274, "ko": "아, 질투해? {F010}씨?{FC03}"}
{"id": 9275, "ko": "아, 아니야,{FC21}"}
{"id": 9276, "ko": "그런 게 아니라…{FC03}"}
{"id": 9277, "ko": "참 솔직하지 못하다니까.{FC01}{F120}그래도 수줍은 점도{F13E}좋・{FC21}"}
{"id": 9278, "ko": "또 오글거리는 소리를…{FC20}"}
{"id": 9279, "ko": "{FFE8:029B}랑 뭐 했는데?{FC03}"}
{"id": 9280, "ko": "그야 당연히 데이트지.{FC01}{F121}{FFE8:029B}씨 멋지잖아!{F10F}{FC01}"}
{"id": 9281, "ko": "잘생겼고, 나 완전 이상형이야!{FC03}"}
{"id": 9282, "ko": "뭐야 그게…!?{FC20}"}
{"id": 9283, "ko": "나한테도 비슷한 말 했었지?{FC01}{F123}너 아무나 상관없는 거냐!!?{FC03}"}
{"id": 9284, "ko": "응!{FC03}"}
{"id": 9285, "ko": "뭐야, 그거 진짜야?{FC03}"}
{"id": 9286, "ko": "아무나 좋다는 건 좀 아닌가.{FC01}{F120}난 야구하는 사람이 좋아.{FC01}{F121}그게 메이저리거면 정말 최고지!{FC03}게다가 한 사람하고만 친하기보다\n여러 사람과 친한 게 더 즐겁잖아?{FC03}"}
{"id": 9287, "ko": "뭐, 넌 그렇겠지만…{FC20}"}
{"id": 9288, "ko": "게다가 기억이 없다고 하면 다들\n동정해서 잘해 주거든.{FC01}{F121}거짓말인데 말이야.{FC03}"}
{"id": 9289, "ko": "어, 거짓말!?{FC01}그게 거짓말이었어!?{FC03}"}
{"id": 9290, "ko": "응, 거짓말이야. 그걸로 관심을 끌고\n적당히 어리광 부리면\n다들 잘해 주거든.{FC01}"}
{"id": 9291, "ko": "단순해, 남자들은.{FC03}{F120}{FFE8:029B}씨도 그래, 그 사람은 특히 다정했어.{FC01}"}
{"id": 9292, "ko": "엄청 성실하고.{FC01}{F121}{FC20}"}
{"id": 9293, "ko": "아~ 난 죄 많은 여자~{FC20}"}
{"id": 9294, "ko": "뭐 이런 녀석이…{FC20}"}
{"id": 9295, "ko": "알았어, 내가 {FFE8:029B}에게 진실을 알리고\n"}
{"id": 9296, "ko": "이런 녀석은 상대하지 말라고 해 두겠어.{FC03}"}
{"id": 9297, "ko": "응, 좋아.{FC01}{F120}{FFE8:029B}씨랑 틀어져도\n"}
{"id": 9298, "ko": "놀 상대는 그 밖에도 많으니까.{FC01}{F010}씨는 어쩔 거야?{FC01}"}
{"id": 9299, "ko": "뻔하잖아"}
{"id": 9300, "ko": "어~ 음…"}
{"id": 9301, "ko": "뻔하잖아, 너랑은 이제 안 만나!{FC01}"}
{"id": 9302, "ko": "뭐야?{FC01}"}
{"id": 9303, "ko": "잘난 척 고상한 소리 하더니\n"}
{"id": 9304, "ko": "우유부단하네!{FC01}"}
{"id": 9305, "ko": "그래도 그런 점이 또{F13E}좋・{FC21}"}
{"id": 9306, "ko": "역시 오글거려…{FC21}"}
{"id": 9307, "ko": "게다가 피곤해…{FC01}"}
{"id": 9308, "ko": "잠깐이라도 고민한 내가 바보였어…{FC03}"}
{"id": 9309, "ko": "나도 너랑은 이제 안 만날 거야!{FC01}"}
{"id": 9310, "ko": "뭔가 바보 같아…{FC20}"}
{"id": 9311, "ko": "난 왜 또 여기 와 있는 거지?{FC01}{FFE8:029C}는 없나…{FC01}"}
{"id": 9312, "ko": "온 김에 뭐라도 먹고 가자.{FC03}"}
{"id": 9313, "ko": "난 왜 또 여기 와 있는 거지?{FC03}"}
{"id": 9314, "ko": "무슨 소리야,\n사실은 보고 싶어서 못 참았으면서.{FC03}"}
{"id": 9315, "ko": "고집 안 부려도 되잖아.{FC01}"}
{"id": 9316, "ko": "또 즐겁게 데이트하자,{FC21}"}
{"id": 9317, "ko": "있잖아…{FC20}"}
{"id": 9318, "ko": "역시 나,{FC01}"}
{"id": 9319, "ko": "씨가 더 좋은가 봐{F10F}{FC01}"}
{"id": 9320, "ko": "그러니까 또 즐겁게 데이트하자,{FC21}"}
{"id": 9321, "ko": "뭐, 뭐야 그게…{FC20}"}
{"id": 9322, "ko": "그럼 준비할 테니 잠깐 기다려!{FC03}"}
{"id": 9323, "ko": "여전히 제멋대로에 막무가내인 녀석.{FC01}"}
{"id": 9324, "ko": "뭐, 모처럼 왔으니… 괜찮겠지.{FC03}"}
{"id": 9325, "ko": "뭐, 괜찮겠지…{FC03}"}
{"id": 9326, "ko": "기분 좋다~~ 높은 곳은!{FC01}뭔가 개운하지 않을 땐 역시 여기지~!{FC01}{F120}어때?"}
{"id": 9327, "ko": "씨도 개운해졌어?{FC01}"}
{"id": 9328, "ko": "그럭저럭"}
{"id": 9329, "ko": "응…"}
{"id": 9330, "ko": "응, 그럭저럭 개운해졌어.{FC03}"}
{"id": 9331, "ko": "그럭저럭이라니,\n"}
{"id": 9332, "ko": "오히려 더 답답해진 거 아냐?{FC01}"}
{"id": 9333, "ko": "응…{FC20}"}
{"id": 9334, "ko": "개운하긴 한데, 다른 뭔가가…{FC20}"}
{"id": 9335, "ko": "개운하긴 한데…{FC20}"}
{"id": 9336, "ko": "안 돼, 얼른 기분 전환해야지!{FC03}"}
{"id": 9337, "ko": "…그렇지.{FC20}"}
{"id": 9338, "ko": "도 {FFE8:029B} 말대로\n"}
{"id": 9339, "ko": "사실은 이런 애가 아닐지도…{FC20}"}
{"id": 9340, "ko": "정말, 우물쭈물한 사람이네!{FC01}{F120}그래도 그게 지적이라{F13E}좋・{FC21}"}
{"id": 9341, "ko": "역시 오글거리기만 하는 녀석…{FC20}"}
{"id": 9342, "ko": "그래도 조금 더 지켜볼까.{FC03}{F000}{F121}자, 뭐 먹으러 갈까, {FFE8:029C}?{FC03}"}
{"id": 9343, "ko": "응, 갈래!{FC01}아, 맞다, 새 레스토랑이 생겼어!{FC01}엄청 맛있대, 거기 가자!{FC03}"}
{"id": 9344, "ko": "괜찮아, 그런 말 해도?{FC01}거기 경쟁 상대잖아?{FC03}"}
{"id": 9345, "ko": "그러니까 정찰하지.{FC01}{F121}자, 빨리 가자!{FC03}"}
{"id": 9346, "ko": "그러고 보니 {FFE8:029C}는\n"}
{"id": 9347, "ko": "언제부터 그 레스토랑에서 일했어?{FC03}"}
{"id": 9348, "ko": "반년 전부터.{FC01}누굴 찾아 이 동네에 왔어.{FC03}"}
{"id": 9349, "ko": "내가 여기 온 거랑 비슷한 때네.{FC01}그래서 누구라는 건?{FC03}"}
{"id": 9350, "ko": "아, 미안,{FC21}"}
{"id": 9351, "ko": "말하기 싫으면 안 해도 돼.{FC03}"}
{"id": 9352, "ko": "링코핀{FC05}이야.{FC03}"}
{"id": 9353, "ko": "링코핀{FC05}??{FC01}"}
{"id": 9354, "ko": "이상한 이름이네…\n"}
{"id": 9355, "ko": "어라,{FC21}"}
{"id": 9356, "ko": "어디서 들어 본 것 같은데…{FC01}"}
{"id": 9357, "ko": "음~… 생각이 안 나네…{FC20}"}
{"id": 9358, "ko": "이상한 이름이네…{FC20}"}
{"id": 9359, "ko": "소중한 사람.{FC03}"}
{"id": 9360, "ko": "소중한 사람…?{FC20}"}
{"id": 9361, "ko": "자, 가자.{FC01}좀 추워지기 시작했어.{FC03}"}
{"id": 9362, "ko": "있잖아, 오늘 쇼핑 같이 가 주지 않을래?{FC03}"}
{"id": 9363, "ko": "응, 좋은데, 뭐 사러 가는데?{FC03}"}
{"id": 9364, "ko": "다음 주가 친구 생일이야.{FC01}그래서 뭐 선물하려고.{FC03}"}
{"id": 9365, "ko": "오, 친구를 위해 뭔가 하다니\n좋은 면도 있잖아.{FC03}"}
{"id": 9366, "ko": "이것도 투자 중 하나야.{FC01}{F124}나중에 몇 배로 돌아올지도 모르니까.{FC03}"}
{"id": 9367, "ko": "역시 그런 거였나…{FC20}"}
{"id": 9368, "ko": "바보, 농담이지 당연히.{FC01}"}
{"id": 9369, "ko": "그보다, 내 생일 알고 싶지 않아?{FC03}"}
{"id": 9370, "ko": "언제야?"}
{"id": 9371, "ko": "들어는 줄게"}
{"id": 9372, "ko": "안 궁금해"}
{"id": 9373, "ko": "의 생일은 언제야?{FC03}"}
{"id": 9374, "ko": "어머, 솔직하네?{FC01}"}
{"id": 9375, "ko": "매달 23일, 잊지 마?{FC03}"}
{"id": 9376, "ko": "OK, 알았어, 자 갈까?{FC03}"}
{"id": 9377, "ko": "야, 모처럼 보케 했는데\n"}
{"id": 9378, "ko": "조금은 태클 좀 걸어 줘!{FC01}"}
{"id": 9379, "ko": "아, 기다려~{FC03}"}
{"id": 9380, "ko": "들어는 줄게.{FC03}"}
{"id": 9381, "ko": "정말 안 귀엽네~.{FC01}"}
{"id": 9382, "ko": "그런 사람한텐 안 알려 줄 거야!{FC01}"}
{"id": 9383, "ko": "바보!{FC03}"}
{"id": 9384, "ko": "선물 뜯길 것 같으니 알고 싶지 않아.{FC03}"}
{"id": 9385, "ko": "7월 23일{FC05}이야!{FC01}"}
{"id": 9386, "ko": "잊으면 안 돼!{FC03}"}
{"id": 9387, "ko": "안 궁금하다고 했잖아!\n"}
{"id": 9388, "ko": "왜 알려 줘!{FC03}"}
{"id": 9389, "ko": "아까 네 입으로 말했잖아?{FC01}"}
{"id": 9390, "ko": "나 기대하고 기다릴게!{FC03}"}
{"id": 9391, "ko": "그러고 보니 오늘 {FFE8:029C} 생일이었지.{FC01}"}
{"id": 9392, "ko": "근데 선물은 아무것도 준비 못 했는데…{FC20}"}
{"id": 9393, "ko": "만나러 가는 건 관두자.{FC03}"}
{"id": 9394, "ko": "만나서 선물을 준다"}
{"id": 9395, "ko": "안 한다"}
{"id": 9396, "ko": "왠지 귀찮네…{FC20}"}
{"id": 9397, "ko": "좋아, {FFE8:029C}랑 어디 가자.{FC01}"}
{"id": 9398, "ko": "일단 뭘 선물할지 정해 두자.{FC01}"}
{"id": 9399, "ko": "하트 펜던트"}
{"id": 9400, "ko": "거대한 곰 인형"}
{"id": 9401, "ko": "비싸 보이는 가방"}
{"id": 9402, "ko": "자, 선물 {FFE8:02D0}도 챙겼으니\n나가 볼까.{FC03}{F037}{FC29}"}
{"id": 9403, "ko": ", 일단 생일 축하해.{FC03}"}
{"id": 9404, "ko": "일단은 뭐야, 일단은!{FC01}{F124}그래도 뭐, 됐어, 오늘은 봐줄게.\n생일을 제대로 기억해 줬으니까.{FC03}"}
{"id": 9405, "ko": "그럼 자, 선물.{FC03}"}
{"id": 9406, "ko": "　정말?{FC21}"}
{"id": 9407, "ko": "　진짜 주는 거야?{FC03}"}
{"id": 9408, "ko": "그래, 진짜야.{FC03}"}
{"id": 9409, "ko": "그럼 나도 줄게!{FC01}"}
{"id": 9410, "ko": "자, 생일 축하해!{FC03}"}
{"id": 9411, "ko": "왜 나도 생일인데?{FC03}"}
{"id": 9412, "ko": "그치만 {F010}씨는\n"}
{"id": 9413, "ko": "생일 기억 못 하잖아?{FC01}"}
{"id": 9414, "ko": "그런 거 쓸쓸하잖아?{FC03}"}
{"id": 9415, "ko": "그래서 같이 축하해 줘.{FC01}"}
{"id": 9416, "ko": "나 착하지,{FC21}"}
{"id": 9417, "ko": "자, 이거!{FC03}"}
{"id": 9418, "ko": "왜 나한테도 주는 거야?{FC03}"}
{"id": 9419, "ko": "괜찮잖아, 내 마음이야.{FC03}"}
{"id": 9420, "ko": "왠지 속셈이 있을 것 같아…{FC20}"}
{"id": 9421, "ko": "없어, 하나도{FC03}"}
{"id": 9422, "ko": "어, 어떻게 알았어!?{FC01}"}
{"id": 9423, "ko": "뭐, 괜찮겠지…{FC20}"}
{"id": 9424, "ko": "그럼 기꺼이 받을게!{FC01}"}
{"id": 9425, "ko": "고마워, {FFE8:029C}!{FC03}"}
{"id": 9426, "ko": "어머, 어서 와, {F010}씨.{FC01}{F126}{F10D}어라, 왜 그래, 좀 이상한데?{FC01}{F121}아, 캐릭터 바꿨구나?{FC03}"}
{"id": 9427, "ko": "기억났어, 나.{FC01}{F123}잊고 있던 거 전부 기억났어.{FC03}"}
{"id": 9428, "ko": "정말!??{FC01}이번엔 농담이라고 하기 없기?{FC03}"}
{"id": 9429, "ko": "아, 들켜?{FC21}"}
{"id": 9430, "ko": "역시 농담…{FC01}{F135}이 아니라 진짜라니까!{FC01}{F120}그러니까 잠깐 같이 가 줄래?{FC01}묻고 싶은 게 있어, {FFE8:029C}에게.{FC03}"}
{"id": 9431, "ko": "응, 알았어.{FC01}금방 끝나니까 기다려!{FC03}{F035}{FC29}"}
{"id": 9432, "ko": "그래서 왜 여기야?{FC03}"}
{"id": 9433, "ko": "그날, 바로 이 자리에서\n처음 이 나라에 와서 {FFE8:029C}를 만났어.{FC03}"}
{"id": 9434, "ko": "씨 거짓말쟁이!{FC01}난 전혀 기억 안 나는걸.{FC03}"}
{"id": 9435, "ko": "하지만 진짜야…{FC01}{FC29}"}
{"id": 9436, "ko": "그때…{FC20}"}
{"id": 9437, "ko": "당신은…?{FC01}혹시 당신, {FC08}링코핀{FC05}씨 아니에요?{FC03}"}
{"id": 9438, "ko": "…?{FC01}{F121}아니야, 그런 이상한 이름 아냐.{FC03}"}
{"id": 9439, "ko": "농담이야,\n얘기하고 싶었을 뿐이야.{FC03}"}
{"id": 9440, "ko": "그보다 이쪽으로 와 봐.{FC03}"}
{"id": 9441, "ko": "오, 이쪽은 바다네.{FC01}파랗고 예쁘다~.{FC03}"}
{"id": 9442, "ko": "봐, 이쪽이 더 예뻐, 봐 봐!{FC03}"}
{"id": 9443, "ko": "야, 너무 그쪽으로 가면 위험해!{FC03}"}
{"id": 9444, "ko": "괜찮아, 괜찮아…{FC21}"}
{"id": 9445, "ko": "위, 위험해!!!{FC03}"}
{"id": 9446, "ko": "와르르!{FC21}"}
{"id": 9447, "ko": "우르르르…{FC05}{FC03}{FC29}"}
{"id": 9448, "ko": "꺄아~~~~~~~!!{FC03}{FC29}"}
{"id": 9449, "ko": "으아~~~~~~~!!!{FC20}"}
{"id": 9450, "ko": "그래서 그때 바다에 떨어진 충격으로\n나는 기억을 잃었던 거야.{FC03}"}
{"id": 9451, "ko": "아아~~~!!{FC21}"}
{"id": 9452, "ko": "에에엑!!!{FC01}{F001}당신이었어!??{FC03}"}
{"id": 9453, "ko": "뭐가…?{FC03}"}
{"id": 9454, "ko": "당신이 언니를 구하려다\n같이 떨어진 사람이었구나!!{FC03}"}
{"id": 9455, "ko": "언니?{FC21}"}
{"id": 9456, "ko": "라니,\n그게 {FFE8:029C}의 언니였어?{FC03}"}
{"id": 9457, "ko": "응, 쌍둥이 언니야.{FC01}오랫동안 행방을 몰랐는데\n드디어 이 동네에 있다는 걸 알아서\n내가 온 거야…{FC03}{F124}그런데 사고를 당해서\n또 행방불명이 돼 버렸어…{FC01}{F125}{FC20}"}
{"id": 9458, "ko": "언제쯤 만날 수 있을까,\n단 하나뿐인 가족인데…{FC20}"}
{"id": 9459, "ko": "그랬구나…{FC20}"}
{"id": 9460, "ko": "그래서, 떨어졌을 때 뭐 기억 안 나?{FC01}뭐든 좋아, 언니를 찾을\n단서가 될지도 모르니까.{FC03}"}
{"id": 9461, "ko": "미안…{FC20}"}
{"id": 9462, "ko": "그때 일은\n방금 말한 것밖에 기억 안 나.{FC01}떨어진 뒤엔 해변에서 깰 때까지\n의식이 없었고…{FC03}"}
