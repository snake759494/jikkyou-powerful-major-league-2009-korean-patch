{"id": 628, "ko": "나, AAA에서 주전이 됐어!{FC03}"}
{"id": 629, "ko": "뭐!? 정말이야?{FC03}"}
{"id": 630, "ko": "그래,\n메이저 데뷔가 점점 다가오고 있어.{FC03}"}
{"id": 631, "ko": "쳇, 좋겠다, 너는.{FC03}"}
{"id": 632, "ko": "하하, 무슨 소리야.{FC01}너도 일본에선 꽤 유명하잖아{FFE8:02D3}{FC03}"}
{"id": 633, "ko": "그건 그렇지만,\n{F12F}메이저행은 남자의 로망이잖아.{FC03}"}
{"id": 634, "ko": "그런가.{FC01}{F124}일본 야구도 세계적으론{FFE8:02D3}{FC03}"}
{"id": 635, "ko": "아니, 위로는 필요 없어.{FC01}"}
{"id": 636, "ko": "너도 날 이기려면 메이저리거가 되는 수밖에\n없다며 일본을 뛰쳐나간 거잖아.{FC03}"}
{"id": 637, "ko": "그건 그렇지만{FFE8:02D3}{FC03}"}
{"id": 638, "ko": "속으론 날 우물 안 대장이 우물 속에서\n개구리헤엄 친다고 생각하고 있겠지?{FC03}"}
{"id": 639, "ko": "그 비유는 뜻을 모르겠다{FFE8:02D3}{FC03}"}
{"id": 640, "ko": "아, 미안.{FC01}친구로서 축하해 줘야 하는데 말이야.{FC03}"}
{"id": 641, "ko": "뭐야?{FC03}"}
{"id": 642, "ko": "너, 왠지 좀 징그럽다{FFE8:02D3}{FC03}"}
{"id": 643, "ko": "뭐, 뭐야.{FC01}모처럼 마음에도 없는 축하를{FFE8:02D3}{FC03}"}
{"id": 644, "ko": "마음에도 없다고!{FC03}"}
{"id": 645, "ko": "당연하잖아!{FC01}{F123}왜 내가 적의 행복을 축하해야 하는데!{FC03}"}
{"id": 646, "ko": "적이 뭐야!{FC01}하다못해 라이벌이라고 해!{FC03}"}
{"id": 647, "ko": "풉.\n드래프트 지명도 못 받은 녀석이\n내 라이벌이라고!?{FC03}"}
{"id": 648, "ko": "뿌갸!!{FC03}{F001}{F132}절교야!!!{FC03}"}
{"id": 649, "ko": "흥, 나야말로!!{FC03}"}
{"id": 650, "ko": "또 저질러 버렸다{FFE8:02D3}{FC03}"}
{"id": 651, "ko": "어이 {F010}.{FC03}"}
{"id": 652, "ko": "그 뒤로 계속 연락이 없던데,\n무슨 일 있어?{FC03}"}
{"id": 653, "ko": "아니, 딱히 전할 게 없어서.{FC03}"}
{"id": 654, "ko": "그래? 괜히 걱정했네, 하하하.{FC03}"}
{"id": 655, "ko": "그럼 간다{FC03}"}
{"id": 656, "ko": "아, 잠깐 잠깐.{FC03}{F120}{F121}그러고 보니, 주전은 됐어?{FC03}"}
{"id": 657, "ko": "너, 알면서 묻는 거지?{FC03}"}
{"id": 658, "ko": "뭐가?{FC03}"}
{"id": 659, "ko": "아니, 내 착각인가 보다.{FC03}"}
{"id": 660, "ko": "그래서, 주전은 됐어?{FC03}"}
{"id": 661, "ko": "그러니까 전할 게 없다고 했잖아!{FC03}"}
{"id": 662, "ko": "왜 화를 내?{FC01}{F121}힘들면 일본으로 돌아와.{FC01}우리 팀에 추천해 줄게.{FC03}"}
{"id": 663, "ko": "그 말은 네가 내 선배가 된다는 거야?{FC03}"}
{"id": 664, "ko": "그런데, 뭐 불만 있어?{FC01}{F121}2군 유니폼이면 내가 입던 거 있어.{FC03}"}
{"id": 665, "ko": "후우, 후우.{FC03}{F12A}힘내라, 나.{FC03}"}
{"id": 666, "ko": "이(가) 미국에 왔다.{FC03}"}
{"id": 667, "ko": "어라, {FFE8:02A1}하고는 절교했을 텐데{FFE8:02D3}{FC03}"}
{"id": 668, "ko": "흥, 잘못 걸었을 뿐이야.{FC03}"}
{"id": 669, "ko": "그래서 왜?{FC03}"}
{"id": 670, "ko": "뭐, 뭔 일이야?{FC03}"}
{"id": 671, "ko": "아니, 나 결혼했거든.{FC03}"}
{"id": 672, "ko": "네네, 축하해.{FC01}{F124}거긴 한밤중일지 몰라도\n난 지금 연습하러 가야 돼.{FC03}{F123}밥 먹을 시간 없으니까 끊는다!{FC03}"}
{"id": 673, "ko": "아, 잠깐{FFE8:02D3}{FC03}"}
{"id": 674, "ko": "정말, 타이밍 나쁜 녀석이야.{FC03}{FC29}"}
{"id": 675, "ko": "모처럼 화해하려고 전화했는데, 너무하네.{FC03}"}
{"id": 676, "ko": "오랜만이다, {F010}!{FC03}"}
{"id": 677, "ko": "그런데 여긴 어떻게?{FC03}"}
{"id": 678, "ko": "하하, 신혼여행 좀 왔지!{FC03}"}
{"id": 679, "ko": "뭐, 진짜 결혼했어!?{FC03}{F127}져, 졌다{FFE8:02D3}{FC01}"}
{"id": 680, "ko": "야구에 정신 팔려서 방심했어{FFE8:02D3}{FC03}"}
{"id": 681, "ko": "뭐, 인생은 야구만이 아니란 거지.{FC03}"}
{"id": 682, "ko": "젠장, 이렇게 된 이상 메이저에\n올라가서 너를{FFE8:02D3}{FC03}"}
{"id": 683, "ko": "메이저 안 가도 지금 나랑 승부하면 돼!{FC03}"}
{"id": 684, "ko": "오, 오랜만이지만 받아 주마.{FC03}"}
{"id": 685, "ko": "아, 그 전에 잠깐만 기다려 줘.{FC03}"}
{"id": 686, "ko": "에이~, 흥 깨지네~.{FC03}"}
{"id": 687, "ko": "기다렸지!{FC03}"}
{"id": 688, "ko": "뭐, 뭐야, 그 유니폼은?{FC03}"}
{"id": 689, "ko": "유니폼이지.{FC01}"}
{"id": 690, "ko": "모르는 거야?{FC03}"}
{"id": 691, "ko": "아니, 그게 아니라\n왜 네가 그걸 입고 있냐고?{FC03}"}
{"id": 692, "ko": "미국에 왔으면 이걸 입어야지!{FC01}{F124}이 세련된 검정과 빨강 디자인.{FC01}{F126}진품엔 못 미쳐도 땀 흡수 특수섬유 안감.{FC03}{F12F}크으!!{FC03}"}
{"id": 693, "ko": "진품?{FC01}설마 그거 직접 만들어 온 거야?{F113}{FC03}"}
{"id": 694, "ko": "그래.{FC01}{F123}이걸 입고 {FFE8:0286}에 잠입해\n"}
{"id": 695, "ko": "몰래 시합에 나갈 거야.{FC03}"}
{"id": 696, "ko": "너, 신혼여행에 뭘 들고 온 거야?{FC03}"}
{"id": 697, "ko": "흥, 상어가 된 내가 무섭냐?{FC03}"}
{"id": 698, "ko": "너야말로 옷 좀 바꿨다고\n날 이길 것 같아?{FC03}"}
{"id": 699, "ko": "승부다!!{FC03}"}
{"id": 700, "ko": "후후후, 어떠냐?{FC01}{F123}미국 야구의 진수를 알겠냐?{FC03}"}
{"id": 701, "ko": "젠장!{FC03}"}
{"id": 702, "ko": "여보, 언제까지 있을 거야?{FC03}"}
{"id": 703, "ko": "아아, 미안 미안.{FC03}"}
{"id": 704, "ko": "미안하지만 아내가 기다려서 이만 갈게.{FC01}"}
{"id": 705, "ko": "너도 빨리 행복해져라!{FC03}"}
{"id": 706, "ko": "으, 응{FFE8:02D3}{FC03}"}
{"id": 707, "ko": "그럼 간다{FC03}"}
{"id": 708, "ko": "이긴 것 같지 않다{FFE8:02D3}{F113}{FC03}"}
{"id": 709, "ko": "그나저나 저 녀석, 시즌 중인데 여유롭네{FFE8:02D3}{FC03}"}
{"id": 710, "ko": "뭐야, 완전 약하잖아.{FC03}"}
{"id": 711, "ko": "뭐, 오늘은 컨디션이 좀{FFE8:02D3}{FC03}"}
{"id": 712, "ko": "그래, 그거 아쉽네.{FC01}"}
{"id": 713, "ko": "네가 이렇게 약할 리 없지.{FC03}"}
{"id": 714, "ko": "여보, 슬슬 가요~!{FC03}"}
{"id": 715, "ko": "그래, 금방 갈게{FC03}"}
{"id": 716, "ko": "너, 캐릭터가 좀 어른스러워졌는데?{FC03}"}
{"id": 717, "ko": "아내 앞에서 바보짓은 못 해{FC01}"}
{"id": 718, "ko": "그럼 또 보자.{FC03}"}
{"id": 719, "ko": "응{FFE8:02D3}{FC03}"}
{"id": 720, "ko": "왠지 여러모로 진 기분이다{FFE8:02D3}{F113}{FC03}"}
{"id": 721, "ko": "자네, GM이 부른다콘.{FC03}"}
{"id": 722, "ko": "네? GM이?{FC03}"}
{"id": 723, "ko": "짧은 시간이었양스.{FC03}"}
{"id": 724, "ko": "재, 재수 없게{FFE8:02D3}{FC03}"}
{"id": 725, "ko": "어이, 컨디션은?{FC03}"}
{"id": 726, "ko": "전 언제나 절호조예요.{FC03}"}
{"id": 727, "ko": "보세요!{FC03}"}
{"id": 728, "ko": "엄청 안 좋아 보이는데{FFE8:02D3}{F113}{FC03}"}
{"id": 729, "ko": "아, 아뇨.{FC01}{F125}그래도 아직 잘리고 싶진 않아요.{FC03}"}
{"id": 730, "ko": "하하, 오늘은 그 얘기가 아냐.{FC03}"}
{"id": 731, "ko": "뭐예요, 놀라게 하지 마세요.{FC03}"}
{"id": 732, "ko": "실은 메이저 선수가 하나 다쳤어.{FC01}{F120}대신할 선수를 도통 못 찾는다더군.{FC03}"}
{"id": 733, "ko": "그거 참 안됐네요.{FC03}{F124}하루빨리 회복하길 바랍니다.{FC03}{F120}{FC29}"}
{"id": 734, "ko": "그래서, {F010}.{FC01}"}
{"id": 735, "ko": "메이저리그에서 뛰어 보지 않겠나?{FC03}"}
{"id": 736, "ko": "네!?{FC03}"}
{"id": 737, "ko": "자네한텐 말 안 했지만\n{FC07}40인 로스터{FC05}에는 올려 놨네.{FFE8:0381}{FC03}"}
{"id": 738, "ko": "나머진 자네 마음이지{FFE8:02D3}{FC03}"}
{"id": 739, "ko": "제, 제가 메이저리거!?{FC03}"}
{"id": 740, "ko": "어, 어이, 착각 말게.{FC01}어디까지나 대역으로 단기 계약이야.{FC03}"}
{"id": 741, "ko": "그래도 그 선수가 다친 동안\n 뛸 수 있는 거죠?{FC03}"}
{"id": 742, "ko": "뭐, 그렇지{FC03}"}
{"id": 743, "ko": "야호!!{FC03}"}
{"id": 744, "ko": "아, 어이!{FC03}{F13B}차, 참 속 보이는 녀석이구먼!{FC03}{F125}뭐, 어쩔 수 없나.{FC01}{F12F}메이저는 저 녀석들의 꿈의 무대니까.{FC03}"}
{"id": 745, "ko": "여러분, 잠깐 모이라콘.{FC03}"}
{"id": 746, "ko": "오늘부터 1개월간 {FFE8:026F}이(가)\n"}
{"id": 747, "ko": "메이저에서 뛰게 됐다콘.{FC03}"}
{"id": 748, "ko": "네!? 정말요?{FC03}"}
{"id": 749, "ko": "대단하양스!!{FC03}"}
{"id": 750, "ko": "아니아니, 그렇게 대단한 건 아니야.{FC03}{F124}한 달 동안 대타로 나갈 뿐이니까.{FC03}"}
{"id": 751, "ko": "그래도 꿈의 메이저에서 뛰다니,\n역시 {FFE8:026F} 선배는 대단해요.{FC03}"}
{"id": 752, "ko": "저, 응원할 테니까 힘내세요.{FC03}"}
{"id": 753, "ko": "그래.{FC03}{F120}{FC29}"}
{"id": 754, "ko": "이(가) 잠시 이탈했다.{FC03}"}
{"id": 755, "ko": "어이, {F010}, 메이저는 어땠나?{FC03}"}
{"id": 756, "ko": "정말 즐거웠어요.{FC01}{F13E}그 관중, 함성, 모든 게 다{FFE8:02D3}{FC03}"}
{"id": 757, "ko": "그거 잘됐군.{FC03}"}
{"id": 758, "ko": "메이저에서 겪은 일은 자네만의 보물이야.{FC01}"}
{"id": 759, "ko": "꺾일 것 같을 땐 메이저 무대를 떠올려.{FC01}{F121}그러면 언젠가 반드시\n그곳에 닿을 수 있을 거야.{FC03}"}
{"id": 760, "ko": "네, 명심하고 힘내겠습니다!!{FC03}"}
{"id": 761, "ko": "음.{FC03}"}
{"id": 762, "ko": "어이, 너희들.{FC03}"}
{"id": 763, "ko": "{FFE8:026F} 형!{FC03}"}
{"id": 764, "ko": "돌아왔양스!{FC03}"}
{"id": 765, "ko": "그래, 너희한테 좀 폐를 끼쳤구나.{FC03}"}
{"id": 766, "ko": "전혀 그렇지 않아요.{FC03}"}
{"id": 767, "ko": "뭐?\n나는 없어도 똑같다는 거냐?{FC03}"}
{"id": 768, "ko": "그런 뜻이 아니에요!{FC03}"}
{"id": 769, "ko": "하하, 농담이야.{FC03}"}
{"id": 770, "ko": "그런데 메이저는 어땠양스?{FC03}"}
{"id": 771, "ko": "그건 말 못 해.{FC03}"}
{"id": 772, "ko": "에이~, 알려 주세요.{FC03}"}
{"id": 773, "ko": "그 멋짐은 말로는 설명 못 한다는 거야!{FC01}"}
{"id": 774, "ko": "뭐, 너희도 언젠가 겪어 볼 날이 오겠지.{FC01}{F121}기대하마!{FC03}"}
{"id": 775, "ko": "네!!{FC03}{F120}{FC29}"}
{"id": 776, "ko": "이(가) 팀에 복귀했다{FC01}"}
{"id": 777, "ko": "의 리턴매치다.{FC03}"}
{"id": 778, "ko": "어이 {F010}!{FC03}"}
{"id": 779, "ko": "너, 언제까지 미국에 있을 거야?{FC01}{F124}일본에 안 돌아가도 돼?{FC03}"}
{"id": 780, "ko": "일본에선 이 유니폼 입어도\n아무도 못 알아보잖아?{FC03}{F124}이젠 이걸 안 입으면 잠이 안 와.{FC03}"}
{"id": 781, "ko": "{FFE8:0286}이(가) 좋으면\n"}
{"id": 782, "ko": "입단하지 그래?{FC03}"}
{"id": 783, "ko": "바보 소리.{FC01}{F124}내가 {FFE8:0286}에\n"}
{"id": 784, "ko": "가려면 몇 년 걸릴 것 같아?{FC01}{F12F}그땐 넌 더 위에 있겠지.{FC03}"}
{"id": 785, "ko": "그런 건 해 봐야 아는 거잖아?{FC03}"}
{"id": 786, "ko": "못 하니까 이런 가짜를 입고\n너랑 승부하러 오는 거잖아!{FC03}"}
{"id": 787, "ko": "너, 무슨 일 있었어?{FC03}"}
{"id": 788, "ko": "알고 싶어?{FC01}{F123}그럼 나랑 한 번 더 승부해!{FC03}"}
{"id": 789, "ko": "좋아!{FC01}{F135}널 위해 받아 주마!!{FC03}"}
{"id": 790, "ko": "어떠냐!!{FC01}알겠냐!{FC03}{F12B}{FC29}"}
{"id": 791, "ko": "흥, 이제 알겠지?{FC01}{F124}넌 이미 내 위에 있어.{FC03}{F120}{F125}손이 닿지 않을 만큼{FFE8:02D3}{FC03}"}
{"id": 792, "ko": "그럼 쫓아오면 되잖아?{FC01}"}
{"id": 793, "ko": "왜 등을 돌리는 거야!{FC03}"}
{"id": 794, "ko": "네 꿈이 너무 큰 거야.{FC01}{F123}지금의 난 이제 따라잡을 수 없게 돼 버렸어!{FC01}{F124}그래서{FFE8:02D3}{FC21}"}
{"id": 795, "ko": "일본 프로야구도 그만뒀어{FFE8:02D3}{FC03}"}
