{"id": 7845, "ko": "그, 그렇죠, 감독님{FC03}"}
{"id": 7846, "ko": "이런, 아쉽군.{FC03}{F121}기왕 왔으니.{FC01}"}
{"id": 7847, "ko": "선물로 이걸 가져가게.{FC03}"}
{"id": 7848, "ko": "가, 감사합니다!{FC03}{FC29}"}
{"id": 7849, "ko": "야, 이거 진짜 비싸 보이는 선물이다.{FC03}"}
{"id": 7850, "ko": "아직 {FC08}라인하르트{FC05}를 조사할 거예요?{FC01}{F125}왠지 위험하지 않아요?{FC03}"}
{"id": 7851, "ko": "그렇지.{FC01}{F121}적어도 그 영감은 위험해.{FC03}"}
{"id": 7852, "ko": "게다가 그 옷.{FC03}"}
{"id": 7853, "ko": "옷이 왜?{FC03}"}
{"id": 7854, "ko": "얼굴이 똑같은 건 그렇다 쳐도\n아버지가 아들이랑 같은 옷을 입을까요?{FC03}"}
{"id": 7855, "ko": "뭘 말하고 싶은 거야.{FC03}"}
{"id": 7856, "ko": "전 그 사람이 {FC08}라인하르트{FC05} 본인 같아요.{FC03}"}
{"id": 7857, "ko": "서, 설마!?{FC01}그렇다면 속은 건 우리 쪽이란 거야?{FC01}{F124}근데 왜 그런 짓을?{FC03}"}
{"id": 7858, "ko": "거기까진 모르겠어요.{FC01}{F124}하지만 만약 그렇다면 분명 이번 일은\n더 이상 간섭하지 말라는 경고 같은\n느낌이 들어요.{FC03}"}
{"id": 7859, "ko": "그 사람, 실은 어딘가의 귀인이고\n뭔가를 이루려고{FFE8:02D3}{FC03}"}
{"id": 7860, "ko": "쳇, 바보 같긴.{FC01}{F124}그 녀석은 그냥 바보야.{FC03}"}
{"id": 7861, "ko": "하지만 이제 그 녀석 조사는 관두자.{FC01}"}
{"id": 7862, "ko": "왠지 흥이 깨졌거든.{FC03}"}
{"id": 7863, "ko": "저, {FFE8:02A4}감독{FFE8:02D3}{FC03}"}
{"id": 7864, "ko": "뭐야, 연습 중이야.{FC03}"}
{"id": 7865, "ko": "씨가 쓰러진 거, 혹시\n"}
{"id": 7866, "ko": "라인하르트{FC05}가 꾸민 거 아녜요?{FC03}"}
{"id": 7867, "ko": "바보, 그럴 리 없잖아!!{FC03}"}
{"id": 7868, "ko": "둥둥~.{FC03}"}
{"id": 7869, "ko": "라, {FC08}라인하르트{FC05}님!{F113}{FC03}"}
{"id": 7870, "ko": "둥둥 둥둥둥~!{FC01}"}
{"id": 7871, "ko": "이거 줄게둥~!{FC03}"}
{"id": 7872, "ko": "이, 이 돈은!?{FC03}"}
{"id": 7873, "ko": "두~웅~두~웅, 두~웅~두~웅!\n{F121}사~랑하는~그 애는 북~치기~{FC03}"}
{"id": 7874, "ko": "보스가 쓰러졌는데 기분이 꽤 좋아 보이네?{FC01}{F124}흥, 그 녀석 생각은 도통 모르겠어{FFE8:02D3}{FC03}"}
{"id": 7875, "ko": "이거 분명 입막음 돈이야{FFE8:02D3}{FC03}"}
{"id": 7876, "ko": "야, {F010}!{FC01}잠깐 와!{FC03}"}
{"id": 7877, "ko": "너, 뭐냐.{FC01}그, 요즘, 그거다.{FC03}"}
{"id": 7878, "ko": "뭔데요?{FC03}"}
{"id": 7879, "ko": "아, 진짜!{FC01}너를 칭찬하려는 거잖아.{FC01}바보!!{FC03}"}
{"id": 7880, "ko": "아, 네.{FC01}그건 감사합니다.{FC03}"}
{"id": 7881, "ko": "그래서 상담인데.{FC01}{FC23}》"}
{"id": 7882, "ko": "。，너 {FFE8:011B}를 해 볼 생각 없냐?{FC03}"}
{"id": 7883, "ko": "네, 포지션 변경이요!?{FC03}"}
{"id": 7884, "ko": "뭐, 억지로 하란 건 아냐.{FC01}할지 말지는 네 맘이다.{FC03}{F120}어때, 해 볼래?{FC03}"}
{"id": 7885, "ko": "오, 뭘 좀 아는군!{FC01}"}
{"id": 7886, "ko": "뭐, 내 눈은 절대 틀림없어!{FC01}"}
{"id": 7887, "ko": "분명 넌 더 성장할 거다!{FC03}"}
{"id": 7888, "ko": "쳇, 뭐야!{FC01}"}
{"id": 7889, "ko": "모처럼 친절하게 말해 줬더니.{FC03}"}
{"id": 7890, "ko": "뭐, 됐다.{FC01}"}
{"id": 7891, "ko": "맘대로 해.{FC01}"}
{"id": 7892, "ko": "너에 대해선 네가 제일 잘 안다 이거냐?{FC03}"}
{"id": 7893, "ko": "하아, 뭐 그렇죠.{FC03}"}
{"id": 7894, "ko": "야, {FFE8:02A3} 아냐?{FC03}"}
{"id": 7895, "ko": "야, {F010}.{FC03}"}
{"id": 7896, "ko": "이런 데서 뭐 하는 거야?{FC03}"}
{"id": 7897, "ko": "장 보는 중이야.{FC03}"}
{"id": 7898, "ko": "그렇지, 너 시식 아르바이트 해 볼래?{FC03}"}
{"id": 7899, "ko": "시식 알바?{FC01}{F121}뭘 먹는데?{FC03}"}
{"id": 7900, "ko": "내 요리다.{FC03}"}
{"id": 7901, "ko": "어, {FFE8:02A3} 요리?{FC03}"}
{"id": 7902, "ko": "어떡할래?{FC03}"}
{"id": 7903, "ko": "한다"}
{"id": 7904, "ko": "안 함"}
{"id": 7905, "ko": "사양할게.{FC03}"}
{"id": 7906, "ko": "그래, 그거 아쉽군.{FC01}{F12F}뭐, 그 마음 모르는 건 아니지만.{FC03}"}
{"id": 7907, "ko": "올해는 월급도 없으니 참고 먹어 볼까.{FC03}"}
{"id": 7908, "ko": "참는다니, 말 한번 심하네.{FC01}{F124}싫으면 됐어.{FC03}"}
{"id": 7909, "ko": "아니, 기꺼이 먹겠습니다.{FC03}{FC29}"}
{"id": 7910, "ko": "여기가 {FFE8:02A3} 집.{FC01}"}
{"id": 7911, "ko": "꽤 깔끔하게 해 놨네.{FC03}"}
{"id": 7912, "ko": "그래, 허니가 깔끔쟁이라서.{FC03}"}
{"id": 7913, "ko": "어, {FFE8:02A3} 결혼했어?{FC03}"}
{"id": 7914, "ko": "그럼 왜 요리 같은 걸 하는 거야?{FC01}{F125}부인 요리가 맛없어?{FC03}"}
{"id": 7915, "ko": "아니, 허니 요리는 최고야.{FC03}"}
{"id": 7916, "ko": "좋아, 요리가 다 된 것 같군.{FC03}"}
{"id": 7917, "ko": "헤에, 햄버거네.{FC01}{F137}잘 먹을게요!{F110}{FC03}"}
{"id": 7918, "ko": "오, 의외로 맛있네.{FC03}"}
{"id": 7919, "ko": "그래, 다행이군.{FC01}{F125}괜찮으면 또 먹으러 와 주겠나?{FC03}"}
{"id": 7920, "ko": "그래, 이렇게 맛있는 요리면 언제든 환영이야!{FC03}{F120}{F12B}근데 이게 왜 아르바이트야?{FC03}"}
{"id": 7921, "ko": "뭐, 그 얘긴 다음에.{FC03}"}
{"id": 7922, "ko": "아, {FFE8:02A3} 아냐.{FC03}"}
{"id": 7923, "ko": "오늘도 그 알바 하러 올래?{FC03}"}
{"id": 7924, "ko": "오늘은 사양할게.{FC03}"}
{"id": 7925, "ko": "그래, 그거 아쉽군.{FC01}{F121}그럼 다른 데 알아보지.{FC03}"}
{"id": 7926, "ko": "미안하다.{FC03}"}
{"id": 7927, "ko": "그래, 물론 가지.{FC03}{F120}{FC29}"}
{"id": 7928, "ko": "자, 됐다.{FC03}"}
{"id": 7929, "ko": "잘 먹을게{FC03}"}
{"id": 7930, "ko": "헤에, 저번 거랑 맛이 좀 다르네.{FC03}{F120}{F122}그래도 이건 이것대로 맛있어{FC03}"}
{"id": 7931, "ko": "하하, 다들 처음엔 그렇게 말해.{FC03}"}
{"id": 7932, "ko": "어, 무슨 뜻?{F10D}{FC03}"}
{"id": 7933, "ko": "아, 아니.{FC03}{F124}실은 옛날에 햄버거를 매일\n계속 먹은 적이 있어서.{FC03}"}
{"id": 7934, "ko": "그렇게 햄버거가 좋아?{FC03}"}
{"id": 7935, "ko": "반대야.{FC01}{F125}일 때문에 먹어야 했지.{FC03}"}
{"id": 7936, "ko": "일?{FC03}"}
{"id": 7937, "ko": "정확히는 전 팀 스폰서가\n버거 가게였거든.{FC01}{F125}시합에 질 때마다 시식품을 지겹도록\n먹어야 했어.{FC03}{F125}지금은 버거만 봐도 싫은데 정신 차리면\n먹고 있는 버거 중독이 돼 버렸지.{FC01}{F124}지난달부턴 의사도 버거를 금지했어.{FC03}"}
{"id": 7938, "ko": "헤에.{FC01}{F12E}그럼 왜 햄버거 같은 걸 만들어?{FC03}"}
{"id": 7939, "ko": "허니 때문.{FC03}"}
{"id": 7940, "ko": "부인을?{FC03}"}
{"id": 7941, "ko": "시식으로 가져온 햄버거 중에 딱 하나\n허니가 극찬한 일품이 있었지.{FC03}{F121}허니는 그 맛을 도저히 못 잊는 거야.{FC03}"}
{"id": 7942, "ko": "시식품이었다면\n이미 가게에서 팔고 있지 않아?{FC03}"}
{"id": 7943, "ko": "그래서 찾아봤는데 아무래도\n제품화는 안 된 모양이야.{FC03}"}
{"id": 7944, "ko": "흐응.{FC01}{F125}그래서 직접 만들려던 거야?{FC03}"}
{"id": 7945, "ko": "그래.{FC01}{F124}다만 버거는 의사가 금지해서 말이지.{FC01}{F12F}실패작은 이렇게 {F010}에게\n먹어 달라고 하기로 한 거다.{FC03}"}
{"id": 7946, "ko": "그건 상관없지만\n나보다 부인한테 먹어 보라 하면?{FC01}{F121}아니, 같이 만들면 되잖아?{FC03}"}
{"id": 7947, "ko": "물론 처음엔 둘이 같이 만들었지.{FC03}"}
{"id": 7948, "ko": "하지만 케첩 맛을 논하던 중\n{F125}1년 넘게 테스터를 한 내 자존심과\n허니의 요리 자존심이 격렬하게 부딪혀{FFE8:02D3}{FC03}"}
{"id": 7949, "ko": "그야말로 사랑싸움이네.{FC03}"}
{"id": 7950, "ko": "친정에 간 허니를 되돌리려면\n내 손으로 그 맛을 재현하는 수밖에 없어.{FC03}"}
{"id": 7951, "ko": "아니, 솔직하게 사과하면 되잖아?{FC03}"}
{"id": 7952, "ko": "그건 내 자존심이 용납 못 해!{FC03}"}
{"id": 7953, "ko": "이 녀석, 꽤 쪼잔한 남자네{FFE8:02D3}{FC03}"}
{"id": 7954, "ko": "아무튼 이대로면 햄버거 이혼이다.{FC01}{F12F}사례는 두둑이 할 테니 어떻게 좀 도와줘.{FC03}"}
{"id": 7955, "ko": "아니, 도와 달래도\n내가 할 수 있는 건 햄버거를\n먹는 것뿐인데{FFE8:02D3}{FC03}"}
{"id": 7956, "ko": "오늘도 햄버거 만들어?{FC03}"}
{"id": 7957, "ko": "그래, 또 알바 와 줄 텐가?{FC03}"}
{"id": 7958, "ko": "그래, 좋아.{FC03}{F120}{FC29}"}
{"id": 7959, "ko": "헤에, 저번 것보다 더 매콤해졌네.{FC03}"}
{"id": 7960, "ko": "하는 김에 이것도 먹어.{FC03}"}
{"id": 7961, "ko": "아니, 두 개는 좀{FFE8:02D3}{F113}{FC03}"}
{"id": 7962, "ko": "하루 하나씩은 너무 비효율적이야.{FC01}{F124}부탁해.{FC03}"}
{"id": 7963, "ko": "알았어.{FC03}"}
{"id": 7964, "ko": "후우.{FC01}{F128}좀 질리기 시작했어.{FC03}"}
{"id": 7965, "ko": "그렇지.{FC01}{F124}난 1년 넘게 이걸 해 왔다고.{FC03}"}
{"id": 7966, "ko": "왠지 그 고생을 알 것 같아.{FC03}"}
{"id": 7967, "ko": "그래, 그럼 하나 더.{FC03}"}
{"id": 7968, "ko": "아니, 이젠 무리야!{FC03}"}
{"id": 7969, "ko": "우, 우욱{FFE8:02D3}{FC03}"}
{"id": 7970, "ko": "으음.{FC01}이것도 아니야.{FC03}{F121}다음은 이 조합으로.{FC03}"}
{"id": 7971, "ko": "잠깐만.{FC01}{F123}너 혹시 모든 재료를\n하나하나 다 시험해 볼 셈이야?{FC03}"}
{"id": 7972, "ko": "그게 제일 논리적이지?{FC03}"}
{"id": 7973, "ko": "그 조합이 몇 개나 되는데?{FC03}"}
{"id": 7974, "ko": "12×12×12로 1728가지다.{FC01}{F121}하루 4개씩 먹으면 1년에 답이 나와!{FC03}"}
{"id": 7975, "ko": "먹겠냐!!{FC03}"}
{"id": 7976, "ko": "오늘도 햄버거를{FFE8:02D3}{FC03}"}
{"id": 7977, "ko": "아니, 미안한데 이제 질렸어.{FC03}"}
{"id": 7978, "ko": "그, 그런{FFE8:02D3}\n"}
{"id": 7979, "ko": "난 허니와 햄버거 이혼하는 건가?{FC03}"}
{"id": 7980, "ko": "안 돼!{FC01}{F123}야구나 할 때가 아니야!{FC01}"}
{"id": 7981, "ko": "당장 퇴단해 요리학교에{FFE8:02D3}{FC03}"}
{"id": 7982, "ko": "가면 되잖아, 가면!{FC03}{F120}{FC29}"}
{"id": 7983, "ko": "그래그래, 어제 제조사에 문의했더니\n그 햄버거 재료를 자세히 알려 주더군.{FC03}"}
{"id": 7984, "ko": "여태 안 물어봤던 거냐{FFE8:02D3}{FC03}"}
{"id": 7985, "ko": "이제 후추, 고기, 빵 조합으로\n8가지만 해 보면 꼭 답이 나올 거야.{FC01}"}
{"id": 7986, "ko": "이제 조금만 더야!{FC03}"}
{"id": 7987, "ko": "알았어, 알았어.{FC01}{F124}그래도 어느 조합을 시험할지는\n내가 정하게 해 줄래?{FC01}{F123}먹는 건 나니까.{FC03}"}
{"id": 7988, "ko": "그 조합은 전에 해 봤어!{FC03}"}
{"id": 7989, "ko": "어, 그래?{FC03}{F120}{F120}미안, 다시 고를게.{FC03}"}
{"id": 7990, "ko": "그 조합도 전에 해 봤어!{FC03}"}
{"id": 7991, "ko": "어, 그랬나?{FC03}"}
{"id": 7992, "ko": "아무래도 꽤 지친 모양이군.{FC01}{F124}오늘은 그만하자.{FC03}"}
{"id": 7993, "ko": "미안{FFE8:02D4}{FC03}"}
{"id": 7994, "ko": "그럼 먼저 후추는 뭘로 할래?{FC03}"}
{"id": 7995, "ko": "빨간 후추"}
{"id": 7996, "ko": "검은 후추"}
{"id": 7997, "ko": "고기는 뭘로?{FC03}"}
{"id": 7998, "ko": "흰 고기"}
{"id": 7999, "ko": "붉은 고기"}
{"id": 8000, "ko": "빵은 뭘로 할래?{FC03}"}
{"id": 8001, "ko": "단단한빵"}
{"id": 8002, "ko": "부드러운 빵"}
{"id": 8003, "ko": "좋아, 알았다.{FC01}{F121}바로 만들어 보지.{FC03}"}
{"id": 8004, "ko": "좋아, 다 됐다.{FC03}{F120}{F124}바로 맛을 볼까!{FC03}"}
{"id": 8005, "ko": "오오, 이건{FFE8:02D3}{FC01}"}
{"id": 8006, "ko": "성공?{FC03}"}
{"id": 8007, "ko": "실패다.{FC03}"}
{"id": 8008, "ko": "역시나.{FC03}"}
{"id": 8009, "ko": "맛없어!!{FC03}"}
{"id": 8010, "ko": "에이, 뭐야.{FC03}"}
{"id": 8011, "ko": "그러니 먹어 줘.{FC03}"}
