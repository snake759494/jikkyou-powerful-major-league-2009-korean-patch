{"id": 7522, "ko": "앗!{FC03}"}
{"id": 7523, "ko": "여, 기다렸지.{FC03}"}
{"id": 7524, "ko": "어라, {F010} 아냐?{FC03}"}
{"id": 7525, "ko": "안녕하세요, {FFE8:0279}씨.{FC03}"}
{"id": 7526, "ko": "둘이 사이가 좋구나.{FC03}"}
{"id": 7527, "ko": "그래서 {FFE8:0279}씨.\n용건이란 게?{FC03}"}
{"id": 7528, "ko": "실은 내 딸을 만나 주게.{FC03}"}
{"id": 7529, "ko": "그럼 난 이만{FFE8:02D3}{FC03}"}
{"id": 7530, "ko": "큰일이양스!{FC03}{F138}현재 1위인 {FFE8:027E}에\n"}
{"id": 7531, "ko": "랑 {FFE8:02A2}가 있양스.{FC03}"}
{"id": 7532, "ko": "알고 있어{FFE8:02D3}{FC03}"}
{"id": 7533, "ko": "배신당했양스!{FC03}"}
{"id": 7534, "ko": "따지자면 우리 구단이 쫓아낸 거잖아?{FC03}"}
{"id": 7535, "ko": "뭐, 그렇게 되는 거양스?{FC03}{F138}다 그 구두쇠 영감이 나쁜 거양스!{FC03}"}
{"id": 7536, "ko": "왓, 죄송하양스!!{FC03}"}
{"id": 7537, "ko": "하하, 나야.{FC03}"}
{"id": 7538, "ko": "뭐야, {FFE8:026C}인 줄 알고 깜짝 놀랐양스.{FC03}"}
{"id": 7539, "ko": "그보다 {FFE8:026C}는 어떻게 됐어요?{FC03}"}
{"id": 7540, "ko": "지금은 {FFE8:027E}에 있대.{FC03}"}
{"id": 7541, "ko": "네, 진짜요?{FC03}"}
{"id": 7542, "ko": "다만 내가 마지막으로 봤을 땐\n상태가 꽤 이상했으니까{FFE8:02D3}{FC01}"}
{"id": 7543, "ko": "원래 {FFE8:026C}의 실력이 나올지는 의문이야.{FC03}"}
{"id": 7544, "ko": "그래도 입단했다는 건 그만한 실력이\n있단 거잖아요?{FC03}"}
{"id": 7545, "ko": "그 말대로다.{FC01}지금은 네 걱정이나 해.{FC03}{F124}{FFE8:026B}랑 {FFE8:026C}가 간 {FFE8:027E}는\n유례없는 강적이야!{FC03}"}
{"id": 7546, "ko": "안 져요!{FC01}{F123}{FFE8:026B}랑 약속했어요.{FC01}"}
{"id": 7547, "ko": "최고의 경기를 하자고!{FC03}"}
{"id": 7548, "ko": "너희는 언젠가 날 넘어설 것 같은 예감이야{FC03}"}
{"id": 7549, "ko": "저, 정말요!?{FC03}{F003}{FFE8:02A6}씨에게 격려를 받았다.{FC03}"}
{"id": 7550, "ko": "왜 그래{F010}?\n고민이야?{FC03}"}
{"id": 7551, "ko": "아, {FFE8:02A6}씨.{FC03}"}
{"id": 7552, "ko": "가 {FFE8:026B}의 성장을 보면\n"}
{"id": 7553, "ko": "자신이 없어진다고 해서,\n나도 조금 신경 쓰여서요.{FC03}"}
{"id": 7554, "ko": "확실히 그놈이 너희보다 소질은 있어{FC03}"}
{"id": 7555, "ko": "역시 그런가요?{FC03}"}
{"id": 7556, "ko": "하지만 걱정 마.{FC01}{F124}너희도 아직 이제부터야.{FC03}"}
{"id": 7557, "ko": "난 포수라서 팀 선수들 능력은\n어느 정도 볼 줄 알아.{FC03}"}
{"id": 7558, "ko": "그래, 그러니 자신을 가져!{FC03}"}
{"id": 7559, "ko": "씨와 거리에서 만남{FC03}"}
{"id": 7560, "ko": "또 그라운드에서 만나면 좋겠네요.{FC03}"}
{"id": 7561, "ko": "그래.{FC03}{F123}그때는 네가 성장한 모습을 보는 걸\n기대하고 있으마!{FC03}"}
{"id": 7562, "ko": "네, 기대하세요!{FC03}"}
{"id": 7563, "ko": "오랜만에 같이 달릴까?{FC03}"}
{"id": 7564, "ko": "앗, {FFE8:02A6} 씨 아니에요?{FC03}"}
{"id": 7565, "ko": "'여' 가 아니죠.{FC01}{F124}한마디도 없이 그만두다니 너무해요.{FC03}"}
{"id": 7566, "ko": "미안 미안.{FC03}"}
{"id": 7567, "ko": "하지만 {FFE8:0286} 규정상\n"}
{"id": 7568, "ko": "징계로 떠나는 자는 아무 말도 하면 안 돼.{FC03}"}
{"id": 7569, "ko": "그, 그래요?{FC03}"}
{"id": 7570, "ko": "뭐, 다른 선수들한테 영향이 있으니\n이해는 가지만.{FC03}{F121}팀 녀석들은 잘 지내냐?{FC03}"}
{"id": 7571, "ko": "네, {FFE8:026C} 같은 건 여전해요.{FC03}"}
{"id": 7572, "ko": "그런데 {FFE8:02A6} 씨는 이제 어쩔 거예요?{FC03}"}
{"id": 7573, "ko": "실은 {FFE8:0284}에 있는 아는\n"}
{"id": 7574, "ko": "투수한테 입단 좀 시켜 달라고 부탁하러\n갔었어.{FC03}"}
{"id": 7575, "ko": "네?\n{FFE8:0284}에?{FC03}"}
{"id": 7576, "ko": "하지만 그 녀석 힘으론 어쩔 수 없다고\n거절당했어.{FC03}"}
{"id": 7577, "ko": "그렇군요{FFE8:02D3}{FC01}"}
{"id": 7578, "ko": "야구 선수는 재취업이 어렵겠네요{FC03}"}
{"id": 7579, "ko": "이봐, 남 일처럼 말하지 마.{FC01}"}
{"id": 7580, "ko": "내일은 너야!{FC03}"}
{"id": 7581, "ko": "그, 그렇네요{FFE8:02D3}{FC03}"}
{"id": 7582, "ko": "뭐, 내 걱정은 마.{FC01}이래 봬도 아는 사람은 많은 편이야.{FC03}{F12F}일단 친척 중에도 야구계 관계자가 있으니\n내일 상담해 볼게.{FC03}"}
{"id": 7583, "ko": "그래요.{FC01}{F121}또 그라운드에서 만나면 좋겠네요.{FC03}"}
{"id": 7584, "ko": "씨가 밥을 사 줬다.{FC03}"}
{"id": 7585, "ko": "앗, {FFE8:026B}랑 {FFE8:02A6}씨.{FC03}"}
{"id": 7586, "ko": "아니, 이 녀석이랑 조깅하고 오는 길이야.{FC01}{F121}이제 밥 먹을 건데 너도 갈래?{FC03}물론 내가 쏜다.{FC03}"}
{"id": 7587, "ko": "네, 기꺼이!!{FC03}"}
{"id": 7588, "ko": "사이가 좋네요.{FC01}{F120}예전부터 알던 사이예요?{FC03}"}
{"id": 7589, "ko": "그런 건 아냐.{FC01}{F121}하지만 나랑 {FFE8:02A2}가 배터리를 짤 때\n"}
{"id": 7590, "ko": "서로 마음을 모르면 곤란하잖아?{FC03}"}
{"id": 7591, "ko": "그러니까 이름 부르지 마!{FC03}"}
{"id": 7592, "ko": "자자.{FC03}{F120}그럼 {FFE8:02A6} 씨는 {FFE8:026C} 씨하고도\n"}
{"id": 7593, "ko": "사이가 좋아요?{FC03}"}
{"id": 7594, "ko": "그 녀석은 거북해.{FC01}{F124}무슨 생각인지 잘 모르겠거든.{FC03}"}
{"id": 7595, "ko": "무슨 말이에요?{FC03}"}
{"id": 7596, "ko": "아무튼 야구랑 구단주 생각밖에 없는 듯해.{FC03}"}
{"id": 7597, "ko": "그, 그래요{FFE8:02D3}{FC03}"}
{"id": 7598, "ko": "좋은 공을 가졌는데 내 사인을\n무시해서 지기도 해.{FC03}"}
{"id": 7599, "ko": "하긴, 내 사인을 무시하는 건\n{FFE8:026B}도 마찬가지지.{FC03}"}
{"id": 7600, "ko": "그건 {FFE8:02A2}의 사인 탓이지!{FC03}"}
{"id": 7601, "ko": "이름 부르지 말라고!!{FC03}"}
{"id": 7602, "ko": "너, 우리 팀이 얼마나 냉정한지 알지?{FC03}"}
{"id": 7603, "ko": "네, 성적이 나쁘면 언제든 잘리죠.{FC03}"}
{"id": 7604, "ko": "그래, 잘 알고 있구나.{FC01}"}
{"id": 7605, "ko": "설명이 필요 없군.{FC03}"}
{"id": 7606, "ko": "무슨 말씀이세요?{FC03}"}
{"id": 7607, "ko": "그런 말이다.{FC03}"}
{"id": 7608, "ko": "잘려 버렸양스{FFE8:02D3}{FC03}"}
{"id": 7609, "ko": "아쉽양스.{FC01}"}
{"id": 7610, "ko": "하지만 우리 팀은 선수를 부품 취급하니\n"}
{"id": 7611, "ko": "어쩔 수 없양스.{FC03}"}
{"id": 7612, "ko": "네 몫까지 내가 힘낼 테니\n"}
{"id": 7613, "ko": "응원해 주양스.{FC03}"}
{"id": 7614, "ko": "너, 해고다.{FC03}"}
{"id": 7615, "ko": "저 구단주 험담 같은 건 안 했어요.{FC03}"}
{"id": 7616, "ko": "아니, 그런 게 아니라 진짜 성적이 나빠서야.{FC03}"}
{"id": 7617, "ko": "그렇다니까.{FC03}"}
{"id": 7618, "ko": "미안하지만 넌 해고하기로 했다.{FC03}"}
{"id": 7619, "ko": "네!?{FC01}{F132}갑자기 무슨?{FC03}"}
{"id": 7620, "ko": "그야 넌 가망이 없거든.{FC03}"}
{"id": 7621, "ko": "그, 그런{FFE8:02D3}{F113}{FC03}"}
{"id": 7622, "ko": "앗, {FFE8:026A}씨!{FC01}"}
{"id": 7623, "ko": "도와주세요!{FC03}"}
{"id": 7624, "ko": "그런 거다.{FC01}{F121}포기해.{FC03}"}
{"id": 7625, "ko": "너\n잘려 버렸양스{FFE8:02D3}{FC03}"}
{"id": 7626, "ko": "아쉽양스.{FC01}{F121}뭐, 네 몫까지 내가 힘낼 테니\n응원해 주양스.{FC03}"}
{"id": 7627, "ko": "드디어 오늘부터 시즌 개막이양스.{FC03}"}
{"id": 7628, "ko": "오늘은 경기 날이양스.{FC03}"}
{"id": 7629, "ko": "오늘 상대는"}
{"id": 7630, "ko": "상대로 부족함 없어!!{FC03}"}
{"id": 7631, "ko": "좋아, {FFE8:02A6} 씨 몫까지 힘내자!!{FC03}"}
{"id": 7632, "ko": "오늘은\n"}
{"id": 7633, "ko": "와 대결이양스!{FC03}"}
{"id": 7634, "ko": "늘 그렇듯 대결 전엔 두근거리양스!{FC03}"}
{"id": 7635, "ko": "오늘은 경기 날이양스.{FC03}"}
{"id": 7636, "ko": "상대가 누구든 이길 뿐이다!{FC03}"}
{"id": 7637, "ko": "좋아, {FFE8:026B}랑 {FFE8:02A6}씨 몫까지 힘내자!{FC03}"}
{"id": 7638, "ko": "좋아, 연습 성과를 보여 주마!{FC03}"}
{"id": 7639, "ko": "좋아, 이기고 말겠어{FC03}"}
{"id": 7640, "ko": "좋아, 떠나간 모두의 몫까지 힘내자!{FC03}"}
{"id": 7641, "ko": "오늘은\n그"}
{"id": 7642, "ko": "와 결승전이양스!{FC03}"}
{"id": 7643, "ko": "드디어 이날이 왔구나!{FC03}"}
{"id": 7644, "ko": "좋아, 이 경기만은 절대 질 수 없어!{FC03}{FC29}"}
{"id": 7645, "ko": ", 드디어 결판이구나!{FC03}"}
{"id": 7646, "ko": "앗, {F010}이슈!!{FC03}"}
{"id": 7647, "ko": "누구?{FC03}"}
{"id": 7648, "ko": "이슈.{FC03}"}
{"id": 7649, "ko": "설마 그 {FFE8:026C}?{FC03}"}
{"id": 7650, "ko": "꼬, 꽤 변했네?{FC03}"}
{"id": 7651, "ko": "그래도 실력은 별로 안 변했으니\n얕보지 않는 게 좋아.{FC03}"}
{"id": 7652, "ko": "그보다 약속은 기억하냐?{FC03}"}
{"id": 7653, "ko": "물론, 최고의 경기로 만들자!{FC03}"}
{"id": 7654, "ko": "도 힘낼 거슈.{FC03}"}
{"id": 7655, "ko": "그래, 바라던 바다!!{FC03}"}
{"id": 7656, "ko": "역시 대단해{FC01}"}
{"id": 7657, "ko": "설마 우리 팀이 질 줄은 몰랐어!{FC03}"}
{"id": 7658, "ko": "드디어 패배 인정이냐.{FC03}"}
{"id": 7659, "ko": "하지만 정말 최고의 경기를\n"}
{"id": 7660, "ko": "보여 줬다고 생각해?{FC03}"}
{"id": 7661, "ko": "왠지 난 아쉬운걸.{FC03}"}
{"id": 7662, "ko": "흥, 당연하지.{FC01}"}
{"id": 7663, "ko": "이래선 나도 만족 못 해!{FC03}"}
{"id": 7664, "ko": "다음엔 더 많은 관객을 우리 플레이로\n"}
{"id": 7665, "ko": "열광시켜 주자!{FC03}"}
{"id": 7666, "ko": "그래, 메이저 마운드에서!{FC03}"}
{"id": 7667, "ko": "젠장, 져 버렸어{FFE8:02D3}{FC03}"}
{"id": 7668, "ko": "하지만 너 혼자 탓은 아냐.{FC01}"}
{"id": 7669, "ko": "넌 좋은 움직임을 보여 줬어.{FC03}"}
{"id": 7670, "ko": "아니, 내 실력은 아직 이 정도가 아냐!{FC01}"}
{"id": 7671, "ko": "다음에 붙을 땐 반드시 이기겠어!{FC03}"}
{"id": 7672, "ko": "그러려면 빨리 메이저로 올라와야지.{FC03}"}
{"id": 7673, "ko": "난 메이저 무대에서 너와 경기할\n"}
{"id": 7674, "ko": "날을 기대하고 있을게!{FC03}"}
{"id": 7675, "ko": "그래!{FC03}"}
{"id": 7676, "ko": "반드시 갈 테니 꼭 기다려!!{FC03}"}
{"id": 7677, "ko": "어떻게 보나?{FC03}"}
{"id": 7678, "ko": "열심히 했지만 아직 힘을\n"}
{"id": 7679, "ko": "다 쏟아내진 못했다고나{FFE8:02D3}{FC03}"}
{"id": 7680, "ko": "그럼 아직 더 클 거라고\n"}
{"id": 7681, "ko": "기대해도 되겠군?{FC03}"}
{"id": 7682, "ko": "그야 물론!{FC03}"}
{"id": 7683, "ko": "그 의욕이 마음에 들어.{FC01}"}
{"id": 7684, "ko": "의욕 가산점으로\n"}
{"id": 7685, "ko": "아슬아슬 합격선인가{FFE8:02D3}{FC03}"}
{"id": 7686, "ko": "메이저 선수로선 아직 멀었군.{FC03}"}
{"id": 7687, "ko": "하지만 AAA에 머물 그릇은\n"}
{"id": 7688, "ko": "아니야.{FC03}"}
{"id": 7689, "ko": "음, 오늘 확신했네.{FC01}{F123}자넨 10년에 1명 나올 인재야.{FC03}"}
{"id": 7690, "ko": "그 후{FFE8:02D3}{FC03}{FC20}"}
{"id": 7691, "ko": "씨는 {FFE8:0286}을 떠났다.{FC03}{F003}하지만 공적을 높이 평가받아\n{F003}현재 메이저리그 GM으로 활약 중이다.{FC03}{F102}{FC20}"}
{"id": 7692, "ko": "는 나와의 맹세를 지켜 메이저 선수가 되어\n{F003}지금도 내 라이벌로 야구계에서 활약 중이다.{FC03}{F003}{FFE8:026A}씨는 {FFE8:026B}를 자기 팀에\n{F003}넣으려 했지만 {FFE8:026B}는 거절하고\n{F003}나와 같은 지구 팀에 입단했다.{FC03}{F003}참 그 녀석다운 선택이다.{FC03}{F102}{FC20}"}
{"id": 7693, "ko": "는 야구를 접고 자신을 찾아 떠났다.{FC03}{F003}그 실력이면 메이저에서도 통하겠지만\n{F003}그에게 야구는 인생의 통과점에\n{F003}불과한지도 모른다{FFE8:02D3}{FC03}{F102}{FC20}"}
{"id": 7694, "ko": "씨는 {FFE8:027E}의\n{F003}기둥으로 지금도 활약 중이다.{FC03}{F003}빨리 메이저에 와 줬으면 하지만,\n{F003}본인은 후배 투수 육성이 더 즐거운 듯하다.{FC01}{F003}아마 그대로 코치가 되려는 게\n{F003}아닐까{FFE8:02D3}{FC03}"}
