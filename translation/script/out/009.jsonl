{"id": 1478, "ko": "어?\n뭐라고?{FC03}"}
{"id": 1479, "ko": "뭐, 뭐야.{FC03}"}
{"id": 1480, "ko": "아무것도 아냐, 바보!{FC03}{F124}아무튼{FFE8:02D3},{FC01}"}
{"id": 1481, "ko": "한텐 개 얘기 하지 마.{FC03}"}
{"id": 1482, "ko": "싫어"}
{"id": 1483, "ko": "알았어"}
{"id": 1484, "ko": "싫어.{FC03}"}
{"id": 1485, "ko": "그럼 다신 여기 오지 마.{FC03}"}
{"id": 1486, "ko": "뭐?{FC03}"}
{"id": 1487, "ko": "여긴 내 집.{FC03}"}
{"id": 1488, "ko": "난 {FFE8:029D}한테{FFE8:02D3}{FC03}"}
{"id": 1489, "ko": "난 그 애를 지킬 의무가 있어.{FC01}{F124}너처럼 중요한 얘기를 안 듣는 사람을\n가까이 둘 순 없어!{FC03}{F001}{F13B}알았으면 나가!!{FC03}"}
{"id": 1490, "ko": "뭐야, 자기가 불러 놓고!{FC01}{F001}{F13B}나가면 될 거 아냐!!{FC03}"}
{"id": 1491, "ko": "바보{FFE8:02D3}{FC03}"}
{"id": 1492, "ko": "아, 알았어.{FC01}그래도 놀러 오는 건 괜찮잖아?{FC01}{F124}{FFE8:029D}랑 개 얘긴 안 할게.{FC03}"}
{"id": 1493, "ko": "안 돼.{FC01}{F123}그 애가 너한테 말을 거니까.{FC03}"}
{"id": 1494, "ko": "엉망진창이네.{F113}{FC03}"}
{"id": 1495, "ko": "그래.{FC01}{F121}그럼 동생한텐 네가 내 남자친구라고 해서\n포기하게 할게.{FC03}"}
{"id": 1496, "ko": "뭐야, 그게!{FC03}{F128}나, 너랑 사귀는 거야?{FC03}"}
{"id": 1497, "ko": "싫어?{FC03}"}
{"id": 1498, "ko": "싫어!"}
{"id": 1499, "ko": "싫진 않지만…"}
{"id": 1500, "ko": "당연히 싫지!!!{FC03}"}
{"id": 1501, "ko": "그럼 나가!!!{FC03}"}
{"id": 1502, "ko": "그래, 나간다!!{FC03}"}
{"id": 1503, "ko": "싫진 않지만{FFE8:02D3}{FC03}"}
{"id": 1504, "ko": "왠지 엄청 불만스러워 보이네.{FC03}"}
{"id": 1505, "ko": "아, 아니야.{FC01}{F129}{FFE8:029E}도 꽤 귀여운 구석이 있고{FFE8:02D3}{FC03}"}
{"id": 1506, "ko": "정말?{F113}{FC03}"}
{"id": 1507, "ko": "어, 응.{FC03}"}
{"id": 1508, "ko": "예를 들면?{FC03}"}
{"id": 1509, "ko": "어, 예를{FFE8:02D3}{FC03}"}
{"id": 1510, "ko": "대충 둘러대지 마!!!{FC03}"}
{"id": 1511, "ko": "미안합니다{FFE8:02D3}{FC03}"}
{"id": 1512, "ko": "오늘 {FFE8:029E}는 없어?{FC03}"}
{"id": 1513, "ko": "언니는 일 갔어요.{FC03}"}
{"id": 1514, "ko": "그, 그래{FC03}"}
{"id": 1515, "ko": "는 지금 대학에 다녀올게요.{FC01}"}
{"id": 1516, "ko": "도 같이 갈래요?{FC03}"}
{"id": 1517, "ko": "그래"}
{"id": 1518, "ko": "아니, 난 됐어"}
{"id": 1519, "ko": "공부엔 관심 없거든.{FC03}{F124}대학이란 게 다 월급 올리려고\n공부하는 거잖아?{FC03}"}
{"id": 1520, "ko": "그, 그렇지 않아요오!{FC03}"}
{"id": 1521, "ko": "그럼 묻겠는데, 우주물리학이나 철학이\n실생활에 도움이 돼?{FC03}"}
{"id": 1522, "ko": "그래도 {FFE8:029D}한텐 중요한 의미예요오!{FC03}"}
{"id": 1523, "ko": "뭔데.{FC01}중요한 의미라니?{FC03}"}
{"id": 1524, "ko": "그 개의 정체를 알려면 필요해요오.{FC03}"}
{"id": 1525, "ko": "뭐?\n개가 우주에서 왔다는 거야?{FC03}"}
{"id": 1526, "ko": "그럴지도 몰라요{FFE8:02D3}{FC03}"}
{"id": 1527, "ko": "뭐?{F113}{FC03}"}
{"id": 1528, "ko": "앗, 늦겠어요오.{FC01}{F12F}그럼 {FFE8:029D}는 안녕히예요오!{FC03}"}
{"id": 1529, "ko": "그래, 조심해.{FC03}"}
{"id": 1530, "ko": "그래, 한가하니까 같이 갈게.{FC03}"}
{"id": 1531, "ko": "저, 저기, 언니랑 데이트는 어땠어요?{FC03}"}
{"id": 1532, "ko": "응?{FC01}{F125}어땠냐니, 보기 좋게 차였지만{FFE8:02D3}{FC03}"}
{"id": 1533, "ko": "하나 물어봐도 돼요?{FC03}"}
{"id": 1534, "ko": "씨는 언니의 어디가\n좋았어요?{FC03}"}
{"id": 1535, "ko": "그, 그야, 어디더라?{FC03}"}
{"id": 1536, "ko": "땡이에요오!{FC03}"}
{"id": 1537, "ko": "뭐야, 땡이라니?{F113}{FC03}"}
{"id": 1538, "ko": "그럴 땐 거짓말이라도 바로 상냥한 점이\n좋다거나 귀엽다고 해야 해요.{FC03}{F124}{F010}씨는\n여자 마음을 전혀 몰라요오!{FC03}{F126}지금이라도 늦지 않았어요.{FC01}{F121}{FFE8:029D}가 사랑의 큐피드가 되어 두 사람 사이를\n"}
{"id": 1539, "ko": "회복시켜 줄게요오!{FC03}"}
{"id": 1540, "ko": "아니, 그만둬.{FC03}"}
{"id": 1541, "ko": "그렇군요.{FC01}{F124}마음이 아직 언니 일로 상처받는 걸\n두려워하는 거죠.{FC01}{F12A}알아요오{FFE8:02D3}{FC03}"}
{"id": 1542, "ko": "뭐, 상처받는다는 것만은 맞네{FFE8:02D3}{FC03}"}
{"id": 1543, "ko": "동생 울리면 가만 안 둬!!{FC03}"}
{"id": 1544, "ko": "안 울린다니까요!!{FC03}"}
{"id": 1545, "ko": "저기, 날씨도 좋은데 어디 안 갈래?{FC03}"}
{"id": 1546, "ko": "와 {F010}가\n어디 가요?{FC03}"}
{"id": 1547, "ko": "아~ 정말!{FC01}{F126}얘는 너한테 데이트 신청하는 거라고!{FC03}"}
{"id": 1548, "ko": "그래요?{FC03}"}
{"id": 1549, "ko": "뭐, 뭐 그렇지.{FC03}{F12F}어디 갈지는 {FFE8:029D}가 정해.{FC03}"}
{"id": 1550, "ko": "난 네가 가고 싶은 데를 모르니까.{FC03}"}
{"id": 1551, "ko": "너 남자잖아!{FC01}{F001}{F124}네가 {FC07}에스코트{FC05}해야지!!{FFE8:037A}{FC03}"}
{"id": 1552, "ko": "아, 알았어, 정말!!{FC01}{F124}그럼{FFE8:02D3}{FC03}"}
{"id": 1553, "ko": "영화 보러 갈래?"}
{"id": 1554, "ko": "드라이브 갈래?"}
{"id": 1555, "ko": "놀이공원 갈래?"}
{"id": 1556, "ko": "왜 그런 시시한 데를 고르는 거야!!{FC03}"}
{"id": 1557, "ko": "너 일일이 시끄럽다{FFE8:02D3}{FC03}"}
{"id": 1558, "ko": "뭐라고!?{FC03}"}
{"id": 1559, "ko": "아니{FFE8:02D3}{F113}{FC03}"}
{"id": 1560, "ko": "그냥 내가 정할게{FFE8:02D3}{FC03}"}
{"id": 1561, "ko": "호수가 좋아{FFE8:02D3}{FC03}"}
{"id": 1562, "ko": "뭔가 수수해~{FC03}"}
{"id": 1563, "ko": "도 호수 좋아요!{FC03}"}
{"id": 1564, "ko": "씨{FFE8:02D3}{FC03}"}
{"id": 1565, "ko": "사실 {FFE8:029D}를 어떻게 생각해요?{FC03}"}
{"id": 1566, "ko": "응, 갑자기 왜?{FC03}"}
{"id": 1567, "ko": "왜 {FFE8:029D}를 만나러 와 주는 거예요?{FC01}"}
{"id": 1568, "ko": "언니가 부탁했다든가{FFE8:02D3}{FC03}"}
{"id": 1569, "ko": "하하, 그런 거 아냐.{FC01}그냥 {FFE8:029D}랑 같이 있으면\n왠지 즐거워서.{FC03}"}
{"id": 1570, "ko": "글쎄.{FC01}{F12F}왜일까{FFE8:02D3}{FC03}{FC29}"}
{"id": 1571, "ko": "도 그래요오{FFE8:02D3}{FC03}"}
{"id": 1572, "ko": "뭐가?{F113}{FC03}{FC29}"}
{"id": 1573, "ko": "도 함께만 있어도 즐거운\n"}
{"id": 1574, "ko": "개가 있었어요오{FFE8:02D3}{FC03}"}
{"id": 1575, "ko": "개 얘기구나{FFE8:02D3}{FC03}"}
{"id": 1576, "ko": "그 개를 또 만나고 싶어요.{FC03}"}
{"id": 1577, "ko": "마음속에선 늘 만나고 있잖아?{FC03}"}
{"id": 1578, "ko": "그렇지만 마음속의 개는 소원을\n들어주지 않아요오{FFE8:02D3}{FC03}"}
{"id": 1579, "ko": "예전 그 개는 소원을 들어줬어?{FC03}"}
{"id": 1580, "ko": "네, 물론이에요오!{FC03}{F120}부모님은 일하러 나가고 언니가 감기로\n앓아누웠을 때 {FFE8:029D}가 외로워서 울면,\n"}
{"id": 1581, "ko": "어느새 곁에 있어 줬어요.{FC03}{F121}{FFE8:029D}가 언니 감기를 빨리 낫게 해 달라고\n"}
{"id": 1582, "ko": "부탁했더니 정말로 언니가 기운을 차리고\n방에서 나왔어요오!{FC03}"}
{"id": 1583, "ko": "대, 대단하네.{FC03}"}
{"id": 1584, "ko": "그런데 {FFE8:029E}는 그걸 기억 못 하나?{FC03}"}
{"id": 1585, "ko": "글쎄요, 언니한텐 개 얘기를 안 하려고\n하니까{FFE8:02D3}{FC03}"}
{"id": 1586, "ko": "잘 말은 못 하겠지만 언니는\n{FFE8:029D}랑 그 얘기 하는 걸 피하는\n"}
{"id": 1587, "ko": "것 같아요오{FFE8:02D3}{FC03}"}
{"id": 1588, "ko": "그래도 어떤 소원만은 그 개도\n들어주지 못했어요오{FFE8:02D3}{FC03}"}
{"id": 1589, "ko": "무슨 소원?{FC03}"}
{"id": 1590, "ko": "밤하늘을 별똥별로 가득 채워 달라고 했어요.{FC01}{F13E}그러면 별빛으로 집 안이 밝아질 테니까{FFE8:02D3}{FC03}"}
{"id": 1591, "ko": "그랬더니 개가 마당에서 예쁜 조약돌을\n주워 왔어요오{FFE8:02D3}{FC03}"}
{"id": 1592, "ko": "조약돌?{FC01}전에 그런 얘기 했었지.{FC03}"}
{"id": 1593, "ko": "예쁜 조약돌을 주워 와서\n{FFE8:029D}를 달래 줬다고{FFE8:02D3}{FC03}"}
{"id": 1594, "ko": "네, 흙투성이가 된 손에\n예쁜 조약돌 4개를 쥐고 있었어요오.{FC03}{F124}조금 큰 게 2개{FFE8:02D3}{FC01}"}
{"id": 1595, "ko": "작은 게 2개{FFE8:02D3}{FC03}"}
{"id": 1596, "ko": "그런데 {FFE8:029D}가 이건 별똥별이 아니라고\n했더니{FFE8:02D3}{FC03}"}
{"id": 1597, "ko": "했더니?{FC03}"}
{"id": 1598, "ko": "개가 떨면서 작은 목소리로\n미안해 하고 자꾸 그랬어요{FFE8:02D3}{FC03}"}
{"id": 1599, "ko": "개가?{FC03}"}
{"id": 1600, "ko": "네, 게다가 수컷인 줄 알았는데\n암컷 목소리였어요{FC03}"}
{"id": 1601, "ko": "그렇구나{FFE8:02D3}{FC03}"}
{"id": 1602, "ko": "그때 {FFE8:029D}는 정말 나쁜 짓을 했다고\n"}
{"id": 1603, "ko": "생각했어요오{FFE8:02D3}{FC03}"}
{"id": 1604, "ko": "훌쩍훌쩍.{FC03}"}
{"id": 1605, "ko": "의 눈이 새빨개!{FC01}"}
{"id": 1606, "ko": "너 동생 울렸지!!{FC03}"}
{"id": 1607, "ko": "언니!{FC01}{F010}는 잘못 없어!{FC03}"}
{"id": 1608, "ko": "맞아!{FC01}난 잘못 없어!{FC03}"}
{"id": 1609, "ko": "불쌍해라.{FC01}"}
{"id": 1610, "ko": "이놈한테 협박당했구나!{FC03}"}
{"id": 1611, "ko": "어디까지 의심해!!{FC03}"}
{"id": 1612, "ko": "아, {F010}!{FC03}{F145}{FFE8:029D}라면 남자친구랑 나가고 없어.{FC03}"}
{"id": 1613, "ko": "뭐, 뭐라고!{FC03}"}
{"id": 1614, "ko": "하하, 농담이야.{FC01}대학 갔어{FC03}"}
{"id": 1615, "ko": "너무해{FFE8:02D3}{FC03}"}
{"id": 1616, "ko": "그래도 그 반응을 보니 꽤 진지하게\n사귀어 주나 보네.{FC01}{F121}안심했어.{FC03}"}
{"id": 1617, "ko": "그보다 너한테 좀 물어볼 게\n있었는데{FFE8:02D3}{FC03}"}
{"id": 1618, "ko": "한테 돌을 준 개의 정체,\n"}
{"id": 1619, "ko": "너 아니야?{FC03}"}
{"id": 1620, "ko": "돌?{FC01}{F124}무슨 얘기?{FC03}"}
{"id": 1621, "ko": "조약돌 3개.{FC03}"}
{"id": 1622, "ko": "4개잖아!{FC03}"}
{"id": 1623, "ko": "역시 뭔가 알고 있구나.{FC03}"}
{"id": 1624, "ko": "아, 아차!{FC03}"}
{"id": 1625, "ko": "저기, 알려 줘.{FC01}{F125}걔, 그 일로 울었다고.{FC03}"}
{"id": 1626, "ko": "그래, 그 조약돌을 준 건 나야.{FC01}{F124}개 인형 옷을 입고.{FC03}"}
{"id": 1627, "ko": "역시{FFE8:02D3}{FC03}"}
{"id": 1628, "ko": "사실은 순록 인형 옷이었지만.{FC01}이런저런 사정으로 뿔 만들 시간이 없어서{FFE8:02D3}{FC03}"}
{"id": 1629, "ko": "왜 그런 짓을{FFE8:02D3}{FC03}"}
{"id": 1630, "ko": "그 애의 마음의 버팀목이 되기 위해서.{FC01}{F123}그 애의 불안과 슬픔을 다 받아 주는 존재.{FC01}그게 필요했어{FFE8:02D3}{FC03}"}
{"id": 1631, "ko": "도통 무슨 소린지 모르겠는데?{F10D}{FC01}{F124}애초에 왜 조약돌이 4개야?{FC03}"}
{"id": 1632, "ko": "후후, 그런 건 넌 몰라도 돼.{FC01}{F124}그냥 그 개를 그 애 마음속에서\n쫓아내 주면 그걸로 돼.{FC03}"}
{"id": 1633, "ko": "쫓아내?{FC03}"}
{"id": 1634, "ko": "그래, 그 앤 아직 그 개한테 기대고 있어.{FC01}하지만 그 개는 이제 없어.{FC01}{F121}넌 앞으로 그 애를 위해\n마음의 버팀목이 돼 줘.{FC03}"}
{"id": 1635, "ko": "난 개 대신인 거야?{F113}{FC03}"}
{"id": 1636, "ko": "안 그러면 {FFE8:029D}는 언제까지나\n"}
{"id": 1637, "ko": "같은 꿈을 꾸게 돼.{FC01}{F123}절대 이뤄지지 않을 꿈을.{FC03}"}
{"id": 1638, "ko": "뭔 소리야.{FC03}"}
{"id": 1639, "ko": "하지만 이것만은 말해 둘게.{FC01}그 개가 나였다는 건 절대\n그 애한테 말하지 마.{FC01}{F124}만약 말하면{FFE8:02D3}{FC03}"}
{"id": 1640, "ko": "말하면 또 때리게{FFE8:02D3}{FC03}"}
{"id": 1641, "ko": "말하면 넌 평생 후회하게 될 거야.{FC03}"}
