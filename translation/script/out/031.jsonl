{"id": 5734, "ko": "프로 선수가 한심하양스.{FC03}"}
{"id": 5735, "ko": "건더 로보 놀이 하자양스.{FC03}"}
{"id": 5736, "ko": "좋아, 건더 로보 놀이 하자!{FC03}"}
{"id": 5737, "ko": "신난다양스!{FC03}"}
{"id": 5738, "ko": "야~, 진짜 재밌었양스!{FC03}"}
{"id": 5739, "ko": "나도 재밌었어.{FC03}"}
{"id": 5740, "ko": "왠지 {FFE8:02A7}군이랑\n"}
{"id": 5741, "ko": "훨씬 가까워진 기분이야.{FC03}"}
{"id": 5742, "ko": "응? 건더 로보?{FC01}"}
{"id": 5743, "ko": "그게 뭔데? 그런 거 싫어!{FC03}"}
{"id": 5744, "ko": "뭐냐니{FFE8:02D3}설마 {F010}군,\n"}
{"id": 5745, "ko": "대인기 건더 로보를 모르는 거양스?{FC03}"}
{"id": 5746, "ko": "전혀 몰라.{FC03}"}
{"id": 5747, "ko": "그건 안 되양스!{FC01}"}
{"id": 5748, "ko": "지금부터 내 집중 강의로\n"}
{"id": 5749, "ko": "위대한 건더 로보를 알라양스!{FC03}"}
{"id": 5750, "ko": "라는 거양스.{FC01}"}
{"id": 5751, "ko": "이걸로 끝이양스.{FC03}"}
{"id": 5752, "ko": "결국 종일 건더 로보 얘기만 들었다{FFE8:02D3}{FC03}"}
{"id": 5753, "ko": "숨바꼭질 하자양스.{FC03}"}
{"id": 5754, "ko": "그럼 내가 먼저 숨겠양스.{FC03}"}
{"id": 5755, "ko": "슬슬 눈 떠도 되겠지.{FC03}"}
{"id": 5756, "ko": "자, 어떻게 할까?{FC03}"}
{"id": 5757, "ko": "귀찮으니 간다."}
{"id": 5758, "ko": "끝까지 찾기"}
{"id": 5759, "ko": "아~, 왠지 귀찮네~.{FC01}"}
{"id": 5760, "ko": "먼저 갈까.{FC03}"}
{"id": 5761, "ko": "좋아, 꼭 찾아내겠어!{FC03}"}
{"id": 5762, "ko": "이만큼 찾아도 어디에도 없다는 건\n"}
{"id": 5763, "ko": "군 먼저 갔네{FFE8:02D3}.{FC03}"}
{"id": 5764, "ko": "에이, 싫어.{FC01}"}
{"id": 5765, "ko": "둘이서 숨바꼭질 해 봤자 재미없어.{FC03}"}
{"id": 5766, "ko": "나를 찾아낼 자신이 없는 거양스.{FC03}"}
{"id": 5767, "ko": "그런 문제가 아니잖아.{FC01}"}
{"id": 5768, "ko": "제대로 숨을 곳도 없잖아.{FC03}"}
{"id": 5769, "ko": "숨바꼭질 승부는\n"}
{"id": 5770, "ko": "내 승리로 해 두겠양스.{FC03}"}
{"id": 5771, "ko": "왜 그렇게 되는데.{FC03}"}
{"id": 5772, "ko": "놀이공원엔 재밌는 기구가 가득이양스.{FC03}"}
{"id": 5773, "ko": "실컷 놀면서 기분 전환하자.{FC03}"}
{"id": 5774, "ko": "싫은 건 다 잊고 실컷 놀자양스!{FC03}{FC22}"}
{"id": 5775, "ko": "오? {F010}랑 {FFE8:02A7} 아니냐아.{FC01}"}
{"id": 5776, "ko": "웬일이야아, 이런 데서?{FC03}"}
{"id": 5777, "ko": "웬일이냐니{FFE8:02D3}?{FC03}"}
{"id": 5778, "ko": "놀이공원에 야구하러 올 리 없양스!{FC01}놀러 왔양스.{FC03}"}
{"id": 5779, "ko": "놀이공원에 놀러 오다니\n얼굴에 안 맞는 짓 하네.{FC03}"}
{"id": 5780, "ko": "댁이 할 말이냐!{FC03}"}
{"id": 5781, "ko": "야말로 뭐 하양스?{FC03}"}
{"id": 5782, "ko": "롤러코스터 타러 왔지이{FFE8:02D3},\n"}
{"id": 5783, "ko": "여기 절규 머신은 최고거드은.{FC03}"}
{"id": 5784, "ko": "오, 몇 대 있나 보네요?{FC03}"}
{"id": 5785, "ko": "엄청 재밌겠양스.{FC03}"}
{"id": 5786, "ko": "지금은 엄청 붐벼서어\n금방 못 탈 것 같네에.{FC03}"}
{"id": 5787, "ko": "그걸 일일이 못 기다리지!{FC03}"}
{"id": 5788, "ko": "아, 아쉽양스.{FC03}"}
{"id": 5789, "ko": "할 수 없지,\n다음 기회로 하자.{FC03}"}
{"id": 5790, "ko": "나도 절규 머신 탈 때까진\n당분간 여기 올지도 몰라아.{FC03}"}
{"id": 5791, "ko": "또 왔구나아.{FC03}"}
{"id": 5792, "ko": "소문난 절규 머신 타고파서{FFE8:02D3}\n"}
{"id": 5793, "ko": "오늘은 한가한 것 같네요.{FC03}"}
{"id": 5794, "ko": "군,\n저기 빙빙 도는 거 타고 싶양스.{FC03}"}
{"id": 5795, "ko": "말이야{FFE8:02D3}{FC03}"}
{"id": 5796, "ko": "오오, 재밌겠다, 저거!{FC03}"}
{"id": 5797, "ko": "관둬어! 처음 타면\n저쪽 {FFE8:0418}부터\n"}
{"id": 5798, "ko": "타는 게 좋아아.{FC03}"}
{"id": 5799, "ko": "어떻게 할 거양스?{FC03}"}
{"id": 5800, "ko": "음,{FC03}"}
{"id": 5801, "ko": "평범한 걸로 한다"}
{"id": 5802, "ko": "슈퍼 로테이션에 도전한다"}
{"id": 5803, "ko": "일단 무난하게\n"}
{"id": 5804, "ko": "저 {FFE8:0418}로 하자!{FC03}"}
{"id": 5805, "ko": "당연히 스릴 만점 {FFE8:0419}지!{FC03}"}
{"id": 5806, "ko": "그럼 바로 타자양스.{FC03}"}
{"id": 5807, "ko": "평범한 거라도 나름 스릴 있어서\n"}
{"id": 5808, "ko": "재밌었어!{FC03}"}
{"id": 5809, "ko": "이 롤러코스터도 충분히 즐거웠으니\n"}
{"id": 5810, "ko": "분명 다른 건 더 재밌을 거양스!{FC03}"}
{"id": 5811, "ko": "참신함은 없지마안,\n"}
{"id": 5812, "ko": "안정적인 재미를 주는 것 같구나아.{FC03}"}
{"id": 5813, "ko": "괜찮양스? {F010}군?{FC03}"}
{"id": 5814, "ko": "회전이{FFE8:02D4}너무 심해{FFE8:02D4}.{FC03}"}
{"id": 5815, "ko": "그러니까 관두라고 했잖아아.{FC03}"}
{"id": 5816, "ko": "휘청거려서 못 걷겠어.{FC03}"}
{"id": 5817, "ko": "정말 한심하양스.{FC03}"}
{"id": 5818, "ko": "또 절규 머신 타러 왔구나아?{FC03}"}
{"id": 5819, "ko": "물론!{FC01}{F121}이번엔 뭘 탈까~?{FC03}"}
{"id": 5820, "ko": "저번엔 {F010}군 뜻대로\n"}
{"id": 5821, "ko": "를 탔양스.{FC03}"}
{"id": 5822, "ko": "그러니 이번엔 내가 정하겠양스!{FC03}"}
{"id": 5823, "ko": "응, 좋아.{FC03}"}
{"id": 5824, "ko": "저기 보이는 걸로 하겠양스.{FC03}"}
{"id": 5825, "ko": "말이냐.{FC03}"}
{"id": 5826, "ko": "을 자랑하는 괴물 머신!{FC03}"}
{"id": 5827, "ko": "오오~, 그거 대단하양스!{FC03}"}
{"id": 5828, "ko": "바로 타자양스.{FC03}"}
{"id": 5829, "ko": "진짜 저거 탈 거야?{FC03}"}
{"id": 5830, "ko": "당연하양스.{FC03}"}
{"id": 5831, "ko": "대체 어떻게 된 거야아?{FC03}"}
{"id": 5832, "ko": "가 가속할 때\n"}
{"id": 5833, "ko": "머리를 쾅 부딪쳤양스.{FC03}"}
{"id": 5834, "ko": "제대로 버티지 않아서 그래애.{FC03}"}
{"id": 5835, "ko": "생각보다 가속이 엄청나서, 속도가\n그렇게 쭉 뻗을 줄은 몰랐어요.{FC03}"}
{"id": 5836, "ko": "정말 곤란하양스.{FC03}"}
{"id": 5837, "ko": "또 질리지도 않고 왔구나.{FC03}"}
{"id": 5838, "ko": "훨씬 더 즐거운 머신이 있으니까양스.{FC03}"}
{"id": 5839, "ko": "그런데 {FFE8:02AA}의 추천 머신은\n"}
{"id": 5840, "ko": "뭐양스?{FC03}"}
{"id": 5841, "ko": "나아~? 글쎄에{FFE8:02D3}\n"}
{"id": 5842, "ko": "저기 보이는 {FFE8:041C}나\n"}
{"id": 5843, "ko": "저쪽 {FFE8:041D}겠지이.{FC03}"}
{"id": 5844, "ko": "군, 어느 게 좋양스?{FC03}"}
{"id": 5845, "ko": "흔들흔들 코스터"}
{"id": 5846, "ko": "쌩쌩 코스터"}
{"id": 5847, "ko": "를 타자!{FC03}"}
{"id": 5848, "ko": "정해졌양스.{FC01}{F133}자, {FFE8:02AA}도 같이 가양스!{FC03}"}
{"id": 5849, "ko": "엥? 나도오?{FC03}"}
{"id": 5850, "ko": "추천자니까양스.{FC03}"}
{"id": 5851, "ko": "난 사양할게에.{FC03}"}
{"id": 5852, "ko": "네? 왜요?{FC03}"}
{"id": 5853, "ko": "그러고 보니 {FFE8:02AA}가 절규 머신 타는 걸\n"}
{"id": 5854, "ko": "아직 본 적이 없양스!{FC03}"}
{"id": 5855, "ko": "그, 그랬던가아~.{FC01}{F120}뭐, 지금은 컨디션이 별로라서어\n다음 기회에 타기로 하지이{FC03}"}
{"id": 5856, "ko": "그래요~?{FC03}"}
{"id": 5857, "ko": "그럼 둘이 탈까양스.{FC03}"}
{"id": 5858, "ko": "어땠어? {FFE8:041C}는?{FC03}"}
{"id": 5859, "ko": "왠지 되게 신기한 감각에 사로잡혔어요.{FC03}"}
{"id": 5860, "ko": "엄청 기분 좋은 감각이양스.{FC03}"}
{"id": 5861, "ko": "구체적으로 어떤 감각이야아?{FC03}"}
{"id": 5862, "ko": "음, 표현하기 힘든데 굳이 말하면\n"}
{"id": 5863, "ko": "우주 공간을 둥실둥실 떠다니는 느낌?{FC03}"}
{"id": 5864, "ko": "난 우주에 가 본 적 없어 모르지만{FFE8:02D3}\n"}
{"id": 5865, "ko": "혹시 {F010},\n"}
{"id": 5866, "ko": "너 외계인이냐?{FC03}"}
{"id": 5867, "ko": "엑, 그런 거였양스?{FC01}"}
{"id": 5868, "ko": "더 빨리 말해 줬으면 했양스.{FC03}"}
{"id": 5869, "ko": "그럴 리가 없잖아요.{FC01}"}
{"id": 5870, "ko": "우주에 뜬 느낌을 상상해서 말한 거예요.{FC03}"}
{"id": 5871, "ko": "어땠어? {FFE8:041D}는?{FC03}"}
{"id": 5872, "ko": "출발은 느긋하다 싶었는데{FFE8:02D3}\n"}
{"id": 5873, "ko": "갑자기 쌩쌩 움직이더니 날카로운\n"}
{"id": 5874, "ko": "코너링에 정신을 못 차렸어요.{FC03}"}
{"id": 5875, "ko": "그럼 평소 {F010}군이랑\n"}
{"id": 5876, "ko": "똑같양스!{FC03}"}
{"id": 5877, "ko": "응? 무슨 뜻?{FC03}"}
{"id": 5878, "ko": "맨날 상대\n"}
{"id": 5879, "ko": "타자랑 주자한테"}
{"id": 5880, "ko": "투수에\n"}
{"id": 5881, "ko": "농락당하니까양스.{FC03}"}
{"id": 5882, "ko": "역시 또 왔구나아{FC03}"}
{"id": 5883, "ko": ", 이번엔\n"}
{"id": 5884, "ko": "롤러코스터 타는 거죠?{FC03}"}
{"id": 5885, "ko": "아니, 이번에도 좀{FFE8:02D4}{FC03}"}
{"id": 5886, "ko": "대체 뭐양스?{FC01}놀이공원에 뭐 하러 온 거양스?{FC03}"}
{"id": 5887, "ko": "웃지 말고 들어 줄래애?{FC03}"}
{"id": 5888, "ko": "안 웃어요.{FC03}"}
{"id": 5889, "ko": "실은{FFE8:02D3}난 말이지{FFE8:02D4}\n"}
{"id": 5890, "ko": "엄청난 겁쟁이야아.{FC03}"}
{"id": 5891, "ko": "와핫, 핫, 핫, 핫, 핫, 핫, 핫{FFE8:02D3}{FC03}"}
{"id": 5892, "ko": "안 웃는다고 약속했잖아아.{FC03}"}
{"id": 5893, "ko": "미안, 미안.{FC03}"}
{"id": 5894, "ko": "죄송하양스.{FC01}너무 안 어울리는 말이라서\n그만 웃어 버렸양스.{FC03}"}
{"id": 5895, "ko": "뭐, 확실히 자주 듣는 말이지.{FC03}"}
{"id": 5896, "ko": "그래도 시합 땐 승부처에서도\n전혀 겁 안 먹고 승부하잖아요?{FC03}"}
{"id": 5897, "ko": "야구는 완전 별개다아.{FC03}"}
{"id": 5898, "ko": "근데 그럼 왜 놀이공원에 오는 거예요?{FC03}"}
{"id": 5899, "ko": "뭐, 담력 시험 때문인데에,\n늘 여기까지 와서 발이 얼어붙어어.{FC03}"}
{"id": 5900, "ko": "그럼 지금 우리랑 같이 타자양스.{FC03}"}
{"id": 5901, "ko": "자, 잠깐, 아직 마음의 준비가\n안 돼서어{FFE8:02D3}.{FC03}"}
{"id": 5902, "ko": "여기까지 와서 마음의 준비가 안 됐다니\n무슨 소리양스?{FC03}"}
{"id": 5903, "ko": "자자 {FFE8:02A7}군, 그렇게 몰아세우는\n"}
{"id": 5904, "ko": "말투는 안 좋잖아.{FC03}"}
{"id": 5905, "ko": "그럼 마음의 준비가 되면\n우리랑 같이 절규 머신 타요!{FC03}"}
{"id": 5906, "ko": "음, 알았다아.{FC01}이번엔 꼭 극복해 보이겠어어!{FC03}"}
{"id": 5907, "ko": "바로 그 기세양스.{FC03}"}
{"id": 5908, "ko": "오? {F010}랑{FFE8:02A7}{FFE8:02D3}.{FC01}"}
{"id": 5909, "ko": "드디어 이때가 와 버렸나아{FFE8:02D3}.{FC03}"}
{"id": 5910, "ko": "무슨 세상 끝난 것 같은 말\n하지 마세요.{FC03}"}
{"id": 5911, "ko": "오늘 {FFE8:02AA}에게 새 세계가\n"}
{"id": 5912, "ko": "열릴지도 모르양스.{FC03}"}
{"id": 5913, "ko": "음{FFE8:02D3}{FC03}"}
{"id": 5914, "ko": "자, 뭘 탈까양스?{FC03}"}
{"id": 5915, "ko": "평범한 롤러코스터"}
{"id": 5916, "ko": "휴, 일단 제일 무난한 걸 골라 줬구나아.{FC03}"}
{"id": 5917, "ko": "괜찮양스? {FFE8:02AA}?{FC03}"}
{"id": 5918, "ko": "겨우 버텼지만 두 번 다신 안 탈 거야아.{FC03}"}
{"id": 5919, "ko": "무슨 소리예요?{FC01}"}
{"id": 5920, "ko": "이제부터 시작이잖아요.{FC03}"}
{"id": 5921, "ko": "뭐라고오?{FC03}"}
{"id": 5922, "ko": "음, {FFE8:041A},\n"}
{"id": 5923, "ko": "{FFE8:041D}, 끝판왕은\n"}
{"id": 5924, "ko": "가 있양스.{FC03}"}
{"id": 5925, "ko": "잠깐 기다려어.{FC01}"}
{"id": 5926, "ko": "몸이 못 버틴다아.{FC03}"}
{"id": 5927, "ko": "몸을 혹사해야 비로소 몸에 익는 거잖아요.{FC01}"}
{"id": 5928, "ko": "야구 연습도 똑같잖아요!{FC03}"}
{"id": 5929, "ko": "큭!{FC03}"}
{"id": 5930, "ko": "그렇게 정했으면 렛츠 트라이양스!{FC03}"}
{"id": 5931, "ko": "왜 갑자기 그런 무서운 걸 고르는 거야아.{FC03}"}
{"id": 5932, "ko": "충격 요법요.{FC03}"}
{"id": 5933, "ko": "저 정도는 타야\n"}
{"id": 5934, "ko": "담력이 붙는 거양스.{FC03}"}
{"id": 5935, "ko": "남 일이라고 싱글벙글{FFE8:02D4}{FC03}"}
{"id": 5936, "ko": "괜찮아! 우리도 같이 타니까양스!{FC03}"}
{"id": 5937, "ko": "자, 가요.{FC03}"}
{"id": 5938, "ko": "왜 네가 뻗는 거야아.{FC03}"}
{"id": 5939, "ko": "는 괜찮았는데\n"}
{"id": 5940, "ko": "한심하양스 {F010}군은.{FC03}"}
{"id": 5941, "ko": "정말이다.{FC03}"}
