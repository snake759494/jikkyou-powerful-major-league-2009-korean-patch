{"id": 1799, "ko": "물론, 갈게.{FC03}"}
{"id": 1800, "ko": "고마워요오!{FC03}"}
{"id": 1801, "ko": "실은 {F010}씨한테만\n좋은 걸 알려 줄게요.{FC03}"}
{"id": 1802, "ko": "좋은거?{FC03}"}
{"id": 1803, "ko": "그날 밤엔 {FFE8:027A}가 나타날지도 몰라요!{FC03}"}
{"id": 1804, "ko": "아, 그렇구나.{FC03}{F002}{F129}{FFE8:029E} 녀석, 벌써 불었네{FFE8:02D3}{FC03}"}
{"id": 1805, "ko": "올해 {FC07}작은곰자리 유성군{FC05}은 12월 24일\n극대를 맞아요{FFE8:02D3}{FFE8:0375}{FC03}"}
{"id": 1806, "ko": "그리고 유성 물질 밀도가\n높은 {FC07}더스트트레일{FC05}이{FFE8:02D3}{FFE8:0378}{FC03}"}
{"id": 1807, "ko": "뭐, 뭔 소린지 모르겠어.{FC03}"}
{"id": 1808, "ko": "죄, 죄송해요오!{FC03}"}
{"id": 1809, "ko": "뭐, 파티는 기대하고 있을게.{FC03}"}
{"id": 1810, "ko": "네, 분명 멋진 파티가 될 거예요!{FC03}"}
{"id": 1811, "ko": "그리고 몇 달 뒤 성탄절 밤{FFE8:02D3}{FC03}{FC20}"}
{"id": 1812, "ko": "메리 크리스마스!!{FC03}"}
{"id": 1813, "ko": "메리 크리스마스예요!{FC01}{F121}{FFE8:029D}는 크리스마스 축하는 처음일지도 몰라요!!{FC03}"}
{"id": 1814, "ko": "후후, {FFE8:029D}가 이렇게 좋아하면\n"}
{"id": 1815, "ko": "좀 더 일찍 할 걸 그랬네.{FC03}"}
{"id": 1816, "ko": "아, 창밖 봐!{FC01}"}
{"id": 1817, "ko": "봐, 유성이야!!{FC03}"}
{"id": 1818, "ko": "정말!{FC03}"}
{"id": 1819, "ko": "밖에 나가 보자!{FC03}{FC29}"}
{"id": 1820, "ko": "또 떨어졌다!{FC03}"}
{"id": 1821, "ko": "아, 저기도!{FC03}{FC29}"}
{"id": 1822, "ko": "이, 이건 그때의!?{F113}{FC03}"}
{"id": 1823, "ko": "작은곰자리 {FC07}유성우{FC05}예요!{FFE8:0379}{FC03}"}
{"id": 1824, "ko": "곧 혜성이 흩뿌린 특수한 먼지 속을\n지구가 통과해요{FFE8:02D3}{FC03}"}
{"id": 1825, "ko": "거긴 {FFE8:029D}의 소원이 깃든 기적의 땅{FFE8:02D3}{FC03}"}
{"id": 1826, "ko": "앗, 개다!!{FC03}"}
{"id": 1827, "ko": "헉, 그 {FFE8:027A} 알바생,\n"}
{"id": 1828, "ko": "한 시간이나 일찍 와 버렸네.{FC01}{F002}{F125}아직 부모님도 안 왔는데{FFE8:02D3}{FC03}"}
{"id": 1829, "ko": "여어!{FC03}"}
{"id": 1830, "ko": "예요!!{FC03}"}
{"id": 1831, "ko": "이게 어디가 순록 탈이라는 거야?{F113}{FC03}"}
{"id": 1832, "ko": ",{FFE8:029D}, 오랜만이다.{FC01}"}
{"id": 1833, "ko": "내 목소린 안 들리려나?{FC03}"}
{"id": 1834, "ko": "알바생, 애드리브 꽤 잘하네.{FC03}"}
{"id": 1835, "ko": "잘 들려요오!{FC01}"}
{"id": 1836, "ko": "오늘은 {FFE8:029D}들 마음이 강한 날이에요.{FC03}"}
{"id": 1837, "ko": "그, 그런가.{F113}{FC03}"}
{"id": 1838, "ko": "네, 상상보다 훨씬 멋진 목소리예요!{FC03}"}
{"id": 1839, "ko": "얘기가 빠르군!{FC03}"}
{"id": 1840, "ko": "먼저 말해 두는데\n사실 나한텐 시간 제한이 있거든.{FC03}{F123}갑작스럽지만 클라이맥스의\n궁극 마술을 보여 주마!{FC03}{F124}{F010}.{FC03}"}
{"id": 1841, "ko": "잠깐 손 내밀어.{FC03}"}
{"id": 1842, "ko": "뭔데?{FC03}"}
{"id": 1843, "ko": "우왓!!!{FC03}{FC29}"}
{"id": 1844, "ko": "이, 이건!?{FC03}"}
{"id": 1845, "ko": "그 힘은 내 작별 선물이다.{FC03}{F120}사람에겐 자신을 위한 인생과\n누군가를 위한 인생이 있지.{FC01}{F121}그리고 진짜 행복은 누군가와 함께 있어.{FC03}{F123}{FFE8:029D}를 잘 부탁한다!{FC03}"}
{"id": 1846, "ko": "아, 네{FFE8:02D3}{FC03}{FC20}"}
{"id": 1847, "ko": ",{FFE8:029E}, 너희를{FFE8:02D3}{FC01}"}
{"id": 1848, "ko": "여기서{FFE8:02D3}계속{FFE8:02D3}{FC03}{FC20}"}
{"id": 1849, "ko": "응, 뭐?{FC01}안 들려?{FC03}{FC20}"}
{"id": 1850, "ko": "엄마{FFE8:02D3}{FC21}"}
{"id": 1851, "ko": "기다려!!{FC03}{F001}{F12A}{FFE8:027A}!!!{FC03}"}
{"id": 1852, "ko": "어라?\n안 움직이네.{FC03}"}
{"id": 1853, "ko": "괘, 괜찮아?{FC01}안에 사람?{FC03}{F139}{F10E}어, 아, 아무도 없어!?{FC03}{F132}어떻게 된 거야{FC03}"}
{"id": 1854, "ko": "터틀 혜성{FC05}의 {FC07}더스트 트레일{FC05}에서 지구가\n벗어나 버린 거예요{FFE8:02D3}{FFE8:0376}{FFE8:0378}{FC03}"}
{"id": 1855, "ko": "거기엔 많은 사람의 마음이 다층 차원에\n구조화된 {FC07}사념체{FC05}로{FFE8:02D3}{FFE8:0377}{FC03}"}
{"id": 1856, "ko": "잠깐, 좀 더 알기 쉽게 말해 줘!{FC03}"}
{"id": 1857, "ko": "즉 {FFE8:029D}들이 본 건 잔류 사념,\n"}
{"id": 1858, "ko": "진짜 유령요.{FC03}"}
{"id": 1859, "ko": "유령이라고!?{FC03}"}
{"id": 1860, "ko": "정, 정말?{FC03}"}
{"id": 1861, "ko": "는 혹시 {FFE8:027A}가 죽은\n"}
{"id": 1862, "ko": "오빠란 걸 알고 있었어?{FC03}"}
{"id": 1863, "ko": "오빠가 아니에요!{FC03}{F124}{FFE8:027A}는{FFE8:02D3}{FC01}"}
{"id": 1864, "ko": "는 {FFE8:029D}의 진짜 아빠지?\n"}
{"id": 1865, "ko": "언니?{FC03}"}
{"id": 1866, "ko": ", 너 알고 있었구나{FFE8:02D3}{FC03}"}
{"id": 1867, "ko": "아까 대화, 아무리 들어도 딸을\n시집보내는 아빠 같았는걸.{FC03}"}
{"id": 1868, "ko": "뭐, 확실히 알기 쉬웠지{FFE8:02D3}{FC03}"}
{"id": 1869, "ko": ", 지금껏 말 안 해서 미안해.{FC01}"}
{"id": 1870, "ko": "우리 진짜 아빠는 크리스마스이브 밤에\n사고를 당해 돌아가셨어.{FC03}"}
{"id": 1871, "ko": "사고?{FC03}"}
{"id": 1872, "ko": "우릴 위해 숲에서 제일 큰 전나무를\n베려다가 깔리고 말았어.{FC01}{F124}분명 유성에 한눈팔았던 걸 거야.{FC03}{F12F}후후, 바보 같지?{FC01}{F125}이렇게 귀여운 딸들을 두고{FFE8:02D3}{FC01}"}
{"id": 1873, "ko": "훌쩍{FFE8:02D3}{FC03}"}
{"id": 1874, "ko": "아니, 그런 거{FFE8:02D3}{FC01}"}
{"id": 1875, "ko": "그렇지 않아요{FFE8:02D3}{FC03}"}
{"id": 1876, "ko": "는 참 좋은 분이에요{FFE8:02D3}{FC03}"}
{"id": 1877, "ko": "그런데 왜 지금까지 말해 주지 않았어요?{FC01}{FFE8:029D}는 지금 아빠도{FFE8:02D3}{FC03}"}
{"id": 1878, "ko": "후후.{FC01}{F124}{FFE8:029D}는 어느새\n"}
{"id": 1879, "ko": "꽤 강해졌구나.{FC03}{F125}이래서야 걱정만 하던 내가\n바보 같잖아.{FC03}"}
{"id": 1880, "ko": "언니{FFE8:02D3}{FC03}"}
{"id": 1881, "ko": "그럼 많이 늦었지만, 이 개 탈은{FFE8:02D3}{FC01}"}
{"id": 1882, "ko": "나랑 {FFE8:027A}의 크리스마스 선물이야.{FC03}"}
{"id": 1883, "ko": "선물?{FC03}"}
{"id": 1884, "ko": "그래.{FC01}{F121}만든 건 나지만 {FFE8:027A}도 조금\n"}
{"id": 1885, "ko": "도와줬어.{FC03}{F124}탈의 등을 한번 봐.{FC03}"}
{"id": 1886, "ko": "뭐지?{FC01}{F125}큰 얼굴 둘{FFE8:02D3}{FC01}"}
{"id": 1887, "ko": "작은 얼굴 둘{FFE8:02D3}{FC03}"}
{"id": 1888, "ko": "아, 이건!{FC03}"}
{"id": 1889, "ko": "그 사람이 그렸어.{FC01}{F145}아마 온 가족 얼굴일 거야.{FC03}"}
{"id": 1890, "ko": "그랬구나{FFE8:02D3}{FC03}"}
{"id": 1891, "ko": "전나무를 베러 가기 직전, 네가 외롭지\n않도록 바라면서 그린 거야.{FC03}"}
{"id": 1892, "ko": "아빠{FFE8:02D3}{FC03}"}
{"id": 1893, "ko": "는 당신께 하고 싶던 말을\n"}
{"id": 1894, "ko": "떠올렸어요{FFE8:02D3}{FC03}"}
{"id": 1895, "ko": "지켜 줘서 정말 고마워요!{FC01}{F002}{F13E}{FFE8:029D}의 목소리,{FC21}"}
{"id": 1896, "ko": "아직 들리죠{FFE8:02D3}{FC03}{F005}{FC20}"}
{"id": 1897, "ko": "시내에 가자!{FC03}"}
{"id": 1898, "ko": "자, 어디로 갈까?{F110}{FC03}"}
{"id": 1899, "ko": "는 여기면 돼요.{FC03}"}
{"id": 1900, "ko": "어, 여기?{FC03}"}
{"id": 1901, "ko": "기억나요?{FC01}"}
{"id": 1902, "ko": "여긴 {FFE8:029D}들이 처음 만난 곳이에요.{FC03}"}
{"id": 1903, "ko": "아, 그러네{FFE8:02D3}{FC03}{F120}{FC29}"}
{"id": 1904, "ko": "는 여기서 음악 듣는 게 참 좋아요.{FC03}"}
{"id": 1905, "ko": "는 어릴 때부터 늘 여기서\n"}
{"id": 1906, "ko": "언니가 돌아오길 기다렸어요.{FC03}"}
{"id": 1907, "ko": "북적이는 곳에 매일 혼자 있으면\n"}
{"id": 1908, "ko": "세상에서 홀로 남겨진 기분이 들어요{FFE8:02D3}{FC03}"}
{"id": 1909, "ko": "그저 마음속 개와 스피커의 음악만이\n"}
{"id": 1910, "ko": "의 마음을 달래 줬어요.{FC03}"}
{"id": 1911, "ko": "어느 날 {FFE8:029D}에게\n"}
{"id": 1912, "ko": "말을 걸어 준 사람이 생겼어요.{FC03}"}
{"id": 1913, "ko": "그게 {F010}씨,\n"}
{"id": 1914, "ko": "바로 당신이었어요.{FC03}"}
{"id": 1915, "ko": "그랬구나{FFE8:02D3}{FC03}"}
{"id": 1916, "ko": "평소엔 마음속 개와 음악을 듣는데\n"}
{"id": 1917, "ko": "개는 음악 감상은 말 못 해요.{FC01}"}
{"id": 1918, "ko": "씨라면 들려줄 수 있어요?{FC03}"}
{"id": 1919, "ko": "물론이지.{FC03}"}
{"id": 1920, "ko": "하고 거리의 음악을 들었다.{FC03}"}
{"id": 1921, "ko": "레스토랑에 가자!{FC03}"}
{"id": 1922, "ko": "네, 마침 배고팠어요!{FC03}"}
{"id": 1923, "ko": "와아, 메뉴가 엄청 많아요!{F110}{FC03}"}
{"id": 1924, "ko": "난 햄버그스테이크나 먹을까.{FC03}"}
{"id": 1925, "ko": "그럼 파스타 먹을래요!{FC03}"}
{"id": 1926, "ko": "꽤 먹었네.{FC03}"}
{"id": 1927, "ko": "네!{FC03}"}
{"id": 1928, "ko": "꼬륵~{FC03}"}
{"id": 1929, "ko": "저기, 아직 모자란 거 아냐?{FC03}"}
{"id": 1930, "ko": "꼬르륵~{FC03}"}
{"id": 1931, "ko": "하하, 배는 솔직하네.{FC01}"}
{"id": 1932, "ko": "참지 말고 더 먹지 그래?{FC03}"}
{"id": 1933, "ko": "하지만 {FFE8:029D}는 돈이 별로 없어요.{FC03}"}
{"id": 1934, "ko": "그럼 오늘은 내가 쏠게.{FC03}"}
{"id": 1935, "ko": "라고 해도 나도 돈이 없네.{FC03}"}
{"id": 1936, "ko": "그러니까 돌아가죠.{FC03}"}
{"id": 1937, "ko": "근데{FFE8:02D3}{FC03}"}
{"id": 1938, "ko": "는 괜찮아요.{FC01}"}
{"id": 1939, "ko": "늘 모자란 만큼은 물 마시고 참으니까요..{FC03}"}
{"id": 1940, "ko": "그, 그렇구나{FFE8:02D3}{FC03}"}
{"id": 1941, "ko": "먹고 싶은 거 시켜.{FC03}"}
{"id": 1942, "ko": "정말요?{FC01}"}
{"id": 1943, "ko": "그럼 사양 않고{FFE8:02D3}{FC03}"}
{"id": 1944, "ko": "이거랑 이거랑 이거랑 이거랑{FFE8:02D3}{FC03}"}
{"id": 1945, "ko": "자, 잠깐만 기다려!{FC03}"}
{"id": 1946, "ko": "왜요?{FC03}"}
{"id": 1947, "ko": "아무리 그래도 그렇게는 못 먹잖아?{FC03}"}
{"id": 1948, "ko": "우후후, 플루는 몸 쓰는 걸로 딱 하나\n"}
{"id": 1949, "ko": "언니한테 이기는 게 있어요!{FC03}"}
{"id": 1950, "ko": "혹시 식욕인가요?{FC03}"}
{"id": 1951, "ko": "딩동댕!!{FC03}"}
{"id": 1952, "ko": "아, 근데 이렇게 먹으면 계산이\n"}
{"id": 1953, "ko": "큰일이죠{FFE8:02D3}{FC01}"}
{"id": 1954, "ko": "는 역시\n"}
{"id": 1955, "ko": "참고 집에서 물 마실게요.{FC03}"}
{"id": 1956, "ko": "아, 아니, 참지 말고 실컷 먹어.{FC03}"}
{"id": 1957, "ko": "야호!!{FC03}"}
{"id": 1958, "ko": "우걱우걱{FFE8:02D3}{FC01}"}
{"id": 1959, "ko": "냠냠{FFE8:02D3}{FC01}"}
{"id": 1960, "ko": "맛있엉{FFE8:02D3}{FC03}"}
{"id": 1961, "ko": "그렇게 먹고도 살이 안 찌네?{FC03}"}
{"id": 1962, "ko": "아마 플루 몸은 에너지 효율이\n"}
{"id": 1963, "ko": "엄청 나쁜 거 가타요{FFE8:02D3}{FC03}"}
{"id": 1964, "ko": "다 먹고 나서 말해!{F113}{FC03}"}
{"id": 1965, "ko": "하고 함께 식사를 즐겼다.{FC03}"}
{"id": 1966, "ko": "어, 산이요{FFE8:02D3}{FC03}"}
{"id": 1967, "ko": "아, {FFE8:029D}에겐 좀 힘들려나?{FC03}"}
{"id": 1968, "ko": "아뇨, 도전해 볼래요!!{FC03}"}
{"id": 1969, "ko": "꽤 힘드네.{FC03}"}
{"id": 1970, "ko": "아, 네.{FC03}"}
{"id": 1971, "ko": "괜찮아?{FC03}"}
{"id": 1972, "ko": "는 이렇게 걷는 거 오랜만예요!{FC01}"}
{"id": 1973, "ko": "옛날에 아빠랑 자주 등산을\n"}
{"id": 1974, "ko": "갔었는데, 그 뒤로 처음이에요{FFE8:02D3}{FC03}"}
{"id": 1975, "ko": "하지만 그땐 아직 어려서\n"}
{"id": 1976, "ko": "계속 안겨 있었으니까\n"}
{"id": 1977, "ko": "전혀 안 힘들었어요.{FC03}"}
{"id": 1978, "ko": "어, 아이를 계속 안고 올라갔어?{FC01}"}
{"id": 1979, "ko": "의 아빠는 운동이라도 하시나?{FC03}"}
