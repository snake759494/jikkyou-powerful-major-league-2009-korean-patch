{"id": 1305, "ko": "미안, 또 때려 버렸네.{FC03}"}
{"id": 1306, "ko": "아냐, 나야말로 멋대로 들어와서.{FC03}"}
{"id": 1307, "ko": "그래서 왜 왔어?{FC03}"}
{"id": 1308, "ko": "전에 빌린 이걸 돌려주려고.{FC03}"}
{"id": 1309, "ko": "어머, 빨간약을 일부러?{FC03}"}
{"id": 1310, "ko": "응, 잘 듣더라, 정말 고마웠어.{FC03}"}
{"id": 1311, "ko": "뜯지도 않았잖아.{FC03}"}
{"id": 1312, "ko": "너 말이야, 할 말 있으면 똑바로 해.{FC01}{F12F}그게 일본인의 나쁜 점이야.{FC03}"}
{"id": 1313, "ko": "그럼 먼저 네 이름부터 들어 볼까?{FC03}"}
{"id": 1314, "ko": "앗, 미안.{FC01}{F121}말 안 했었나?{FC03}"}
{"id": 1315, "ko": "난{FFE8:029E}.{FC01}"}
{"id": 1316, "ko": "원래는 {FC08}브렛{FC05}인데, 보다시피\n말괄량이라서.{FC03}"}
{"id": 1317, "ko": "다들 탄환 {FFE8:029E}라고 불러.{FC03}"}
{"id": 1318, "ko": "직업은 {FC07}거리 예인{FC05}이야.{FFE8:036F}{FC03}"}
{"id": 1319, "ko": "예인?{FC03}"}
{"id": 1320, "ko": "응, 동생 학비 벌려고 밤낮 재주를 닦아\n길 가는 사람들에게 웃음을 뿌려.{FC03}"}
{"id": 1321, "ko": "보여 줄게.{FC03}{F120}{F001}{F126}내 몸은 말랑말랑 큐트!!{FC03}"}
{"id": 1322, "ko": "뭐라고!!{FC03}"}
{"id": 1323, "ko": "그래서, 너 왜 왔다고?{FC03}"}
{"id": 1324, "ko": "그러니까 빨간약을{FFE8:02D3}{FC03}"}
{"id": 1325, "ko": "솔직히 말해.{FC01}{F124}참고로 {FFE8:029D}라면 외출했어.{FC03}"}
{"id": 1326, "ko": "동생엔 관심 없어"}
{"id": 1327, "ko": "어, 그래?"}
{"id": 1328, "ko": "굳이 말하자면 당신을 만나러 왔어요.{FC03}"}
{"id": 1329, "ko": "풉!{FC01}"}
{"id": 1330, "ko": "네가 날 꼬시겠다니, 100만 년은 이르거든!{FC03}"}
{"id": 1331, "ko": "아, 아니, 재치 있는 농담 좀 하려고.{FC03}"}
{"id": 1332, "ko": "농담?{FC03}"}
{"id": 1333, "ko": "실례되는 녀석!{FC03}"}
{"id": 1334, "ko": "어머나, 피가 나잖아.{FC01}{F121}그리고 내 손엔 빨간약{FFE8:02D3}{FC03}"}
{"id": 1335, "ko": "어, 그래?{FC03}"}
{"id": 1336, "ko": "역시 {FFE8:029D}가 목적이었구나.{FC03}"}
{"id": 1337, "ko": "그, 그런 거 아냐.{FC03}"}
{"id": 1338, "ko": "그래도 좀 신경 쓰이지?{FC03}"}
{"id": 1339, "ko": "뭐, 내버려 두면 위태롭다고 할까\n뭐랄까{FFE8:02D3}{FC03}"}
{"id": 1340, "ko": "그렇다니까.{FC01}{F12F}그러니까 부탁해.{FC01}네가 그 애 남자친구가 돼 줘.{FC03}"}
{"id": 1341, "ko": "응?{FC01}{F129}갑자기 그런 말을 해도.{FC03}"}
{"id": 1342, "ko": "내 동생이 불만이야?{FC03}"}
{"id": 1343, "ko": "아뇨, 동생은 불만 없지만 언니 쪽이{FFE8:02D3}{FC03}"}
{"id": 1344, "ko": "실례되는 녀석!!{FC03}"}
{"id": 1345, "ko": "그, 그런 점이{FFE8:02D3}{FC03}"}
{"id": 1346, "ko": "뭐?\n아직 모자라?{FC03}"}
{"id": 1347, "ko": "그, 그런 점도 매력이랄까{FFE8:02D3}{FC03}"}
{"id": 1348, "ko": "승낙.{FC03}"}
{"id": 1349, "ko": "아, {F010}님!{FC03}{F120}{F120}오늘은 무슨 일로요?{FC03}"}
{"id": 1350, "ko": "아니, 좀 신경 쓰여서.{FC03}"}
{"id": 1351, "ko": "알겠어요.{FC01}"}
{"id": 1352, "ko": "언니를 불러올게요!{FC03}"}
{"id": 1353, "ko": "아냐, {FFE8:029E}는 안 불러도 돼!{F113}{FC03}"}
{"id": 1354, "ko": "다 들렸거든!!{FC03}"}
{"id": 1355, "ko": "미, 미안해!!{FC03}"}
{"id": 1356, "ko": "어머, 뭔가 사이가 좋아졌네요.{FC03}"}
{"id": 1357, "ko": "어디가!{FC03}"}
{"id": 1358, "ko": "남이었으면 언니가\n그렇게 화내지 않거든요.{FC03}"}
{"id": 1359, "ko": "바, 바보.{FC03}"}
{"id": 1360, "ko": "아, 언니 반응이 정말 이상해요!{FC01}{F129}수상해{FFE8:02D3}{FC03}"}
{"id": 1361, "ko": "왜, 왜?{FC03}"}
{"id": 1362, "ko": "아, 아니 그냥{FFE8:02D3}{FC03}"}
{"id": 1363, "ko": "분명 이게 언니의 애정 표현이에요!{FC03}"}
{"id": 1364, "ko": "정, 정말?{FC03}"}
{"id": 1365, "ko": "그럴 리 없잖아!!{FC01}{F124}정말, 난 몰라!!{FC03}"}
{"id": 1366, "ko": "그래도 곤란하네요.{FC03}{F120}{F124}언니 남편이 되면{FFE8:02D3}\n"}
{"id": 1367, "ko": "{FFE8:029D}의 뭐였더라?{FC03}"}
{"id": 1368, "ko": "그럴 일은 절대 없으니까\n걱정 안 해도 돼.{F113}{FC03}"}
{"id": 1369, "ko": "그럼 오늘은 가시게요?{FC03}"}
{"id": 1370, "ko": "아니, 널 만나러 왔어.{FC03}"}
{"id": 1371, "ko": "네?{FC01}{FFE8:029D}를요?{FC01}"}
{"id": 1372, "ko": "그래도 곤란해요.{FC01}{F125}언니가 불쌍해요.{FC03}"}
{"id": 1373, "ko": "그런 얘기가 아니라\n개 얘기를 들으러 왔어.{FC03}"}
{"id": 1374, "ko": "신기한 얘기라 계속 궁금했거든.{FC03}"}
{"id": 1375, "ko": "그, 그 얘긴 다음에 해요.{FC03}"}
{"id": 1376, "ko": "그건{FFE8:02D3}{FC03}"}
{"id": 1377, "ko": "언제까지 거기서 얘기할 거야!?{FC01}{F001}안으로 들어오라고 해!{FC03}{F120}{FC29}"}
{"id": 1378, "ko": "그래서, 이런 아리따운 여자 둘이 사는 집에\n쳐들어오다니 배짱 한번 좋네.{FC03}"}
{"id": 1379, "ko": "다짜고짜 시비야?{FC03}"}
{"id": 1380, "ko": "나이는?{FC03}"}
{"id": 1381, "ko": "20살!{FC03}"}
{"id": 1382, "ko": "직업?{FC03}"}
{"id": 1383, "ko": "프로야구 선수{FC03}"}
{"id": 1384, "ko": "어머, 의외로 괜찮네.{FC01}{F121}나랑 사귀어.{F10F}{FC03}"}
{"id": 1385, "ko": "뭐!?{FC03}"}
{"id": 1386, "ko": "언니!{FC03}"}
{"id": 1387, "ko": "오해 말았으면 하는데, 난 그냥 개{FFE8:02D3}{FC03}"}
{"id": 1388, "ko": "와아아!!{FC03}"}
{"id": 1389, "ko": "그냥 개{FFE8:02D3}{FC03}"}
{"id": 1390, "ko": "개 쇼군{FC05}이 요시쓰나란 걸 말해 두려고\n"}
{"id": 1391, "ko": "해서.{F113}{FFE8:0370}{FC03}"}
{"id": 1392, "ko": "그랬구나.{FC03}"}
{"id": 1393, "ko": "납득하냐!!{FC03}"}
{"id": 1394, "ko": "그래도 {F010}님, 틀렸어요!{FC03}"}
{"id": 1395, "ko": "쓰나요시예요!{FC03}"}
{"id": 1396, "ko": "그, 그랬나?{FC03}{F13B}그보다, 왜 그런 걸 {FFE8:029D}가\n"}
{"id": 1397, "ko": "알고 있는 건데!{FC03}"}
{"id": 1398, "ko": "우리 동생 얕보지 마.{FC01}"}
{"id": 1399, "ko": "대학에선 우주물리학이나 철학 같은\n복잡한 걸 공부하니까.{FC03}"}
{"id": 1400, "ko": "에헴이에요!{FC03}"}
{"id": 1401, "ko": "전혀 그렇게 안 보이는데?{FC01}{F129}게다가 일본 역사랑 무관하고.{FC03}"}
{"id": 1402, "ko": "일단 지금부터 나랑 데이트해.{FC03}"}
{"id": 1403, "ko": "싫어!{FC03}"}
{"id": 1404, "ko": "때린다.{FC03}"}
{"id": 1405, "ko": "무슨 프러포즈야?{FC03}{FC29}"}
{"id": 1406, "ko": "동생한테 개 얘기 들었어?{FC03}"}
{"id": 1407, "ko": "뭐, 대충.{FC03}{F12E}과자를 줬다든가 어쨌다든가{FFE8:02D3}{FC03}"}
{"id": 1408, "ko": "그 얘기는{FFE8:02D3}{FC01}"}
{"id": 1409, "ko": "동생은 정말 믿는 사람한테만 얘기해.{FC03}"}
{"id": 1410, "ko": "그렇구나.{FC03}"}
{"id": 1411, "ko": "모르는구나!{FC01}{F126}언니인 나한테도 제대로 얘기한 적 없어.{FC03}"}
{"id": 1412, "ko": "그, 그렇게 동생한테 신뢰 없어?{FC03}"}
{"id": 1413, "ko": "대체 그 애한테 무슨 짓을 했어?{FC03}"}
{"id": 1414, "ko": "무슨 짓이라니,\n그냥 말을 걸었을 뿐{FFE8:02D3}{FC03}"}
{"id": 1415, "ko": "아무튼.{FC03}"}
{"id": 1416, "ko": "동생은 나보다 너한테 기대려 해.{FC03}"}
{"id": 1417, "ko": "그렇게 안 보이는데{FFE8:02D3}{FC03}"}
{"id": 1418, "ko": "응, 본인도 눈치 못 챘을 테니까.{FC01}{F124}하지만 난 알아.{FC03}"}
{"id": 1419, "ko": "그러니까 너는 동생이랑 사귀어.{FC03}"}
{"id": 1420, "ko": "그건 네가 정할 일이 아니잖아?{FC03}"}
{"id": 1421, "ko": "그럼 다시는 {FFE8:029D}에게 오지 마!{FC03}"}
{"id": 1422, "ko": "그것도 아니지{FFE8:02D3}{FC03}"}
{"id": 1423, "ko": "부탁이야!{FC01}상처 주지 마{FFE8:02D3}{FC03}"}
{"id": 1424, "ko": "플루에게 안 간다"}
{"id": 1425, "ko": "상처 안 준다"}
{"id": 1426, "ko": "알았어.{FC01}{F123}이제 {FFE8:029D}에게는 안 다가갈게.{FC03}"}
{"id": 1427, "ko": "고, 고마워.{FC01}"}
{"id": 1428, "ko": "그럼 동생한텐 네가 내 남자친구라고\n해서 포기시킬게.{FC03}"}
{"id": 1429, "ko": "아니, 그냥 내가 사라지면 되잖아?{FC03}"}
{"id": 1430, "ko": "벌써 여기서 데이트하는 걸로 돼 있어.{FC03}"}
{"id": 1431, "ko": "그럼 차인 걸로 해.{FC03}"}
{"id": 1432, "ko": "반대잖아!{FC01}{F124}왜 나 같은 가련한 소녀가 너한테 차이냐고.{FC03}"}
{"id": 1433, "ko": "가, 가련은{FFE8:02D3}{FC03}"}
{"id": 1434, "ko": "그, 그럼 다음엔 눈에 하트를 띄우고\n날 꼬시러 와!!{FC01}{F13B}시원하게 차 줄 테니까!{FC03}"}
{"id": 1435, "ko": "와 사귀게 됐다.{FC03}"}
{"id": 1436, "ko": "알았어.{FC01}{F123}그 애를 울리는 일은 안 할게.{FC03}"}
{"id": 1437, "ko": "그건 사귄다는 뜻?{FC03}"}
{"id": 1438, "ko": "아니, 그건 아니지만 {FFE8:029D}가 날\n"}
{"id": 1439, "ko": "믿고 있다면 내가 사라졌을 때\n분명 슬퍼할 거니까.{FC03}"}
{"id": 1440, "ko": "남자치곤 좋은 답이야.{FC01}"}
{"id": 1441, "ko": "너라면 동생 마음을 소중히 해 줄 것 같네.{FC01}{F121}그럼 난 더는 아무 말 안 할게.{FC03}"}
{"id": 1442, "ko": "그보다 우리 지금 데이트 중인 걸로\n돼 있잖아?{FC03}어쩔 거야?\n이 상황.{FC03}"}
{"id": 1443, "ko": "동생한텐 나한테 차였다고 해.{FC03}"}
{"id": 1444, "ko": "뭐, 그거 언니한테 물려받은 것 같잖아.{FC03}{F120}{F127}나, 너무 꼴사납다{FFE8:02D3}{FC03}"}
{"id": 1445, "ko": "괜찮아.{FC01}{F121}동생은 아직 자기 마음을 모르니까{FFE8:02D3}{FC03}"}
{"id": 1446, "ko": "아, {F010}!{FC01}{FFE8:029D}는 대학 갔어.{FC03}"}
{"id": 1447, "ko": "딱히 {FFE8:029D}를 만나러 온 건{FFE8:02D3}{FC03}"}
{"id": 1448, "ko": "그럼 신나서 누굴 만나러 온 건데?{FC03}"}
{"id": 1449, "ko": "글쎄, 누구였더라?{FC03}"}
{"id": 1450, "ko": "그럼 난 이만.{FC03}"}
{"id": 1451, "ko": "자, 잠깐 기다려!{F113}{FC01}"}
{"id": 1452, "ko": "모처럼 왔으니 집에서 느긋하게\n있다 가는 게 어때?{FC03}"}
{"id": 1453, "ko": "싫어.{FC01}{F123}너랑 있으면 맞기만 하니까.{FC03}"}
{"id": 1454, "ko": "내가 모처럼 불러 주는 거니까\n{F001}잠자코 와!!{FC03}"}
{"id": 1455, "ko": "역시 맞았다{FFE8:02D3}{FC03}"}
{"id": 1456, "ko": "뭐, 잠깐이라면.{FC03}{FC29}"}
{"id": 1457, "ko": "나한테 무슨 볼일?{FC03}"}
{"id": 1458, "ko": "너 말고 동생한테 볼일이 있었어.{FC03}"}
{"id": 1459, "ko": "나보다 동생이 좋아?{FC03}"}
{"id": 1460, "ko": "그, 그런 거 아냐.{FC03}{F125}그냥 {FFE8:029D}가 말한 개 얘기가 좀\n"}
{"id": 1461, "ko": "궁금해서{FFE8:02D3}{FC03}"}
{"id": 1462, "ko": "그건{FFE8:02D3}{FC01}"}
{"id": 1463, "ko": "너무 깊이 파고들지 마.{FC03}"}
{"id": 1464, "ko": "그 얘긴 그 애한테 정말 소중한 거니까.{FC01}{F123}얘기하려면 먼저 {FFE8:029D}를 더 알아야 해.{FC03}"}
{"id": 1465, "ko": "뭔가 거창한 얘기구나.{FC03}"}
{"id": 1466, "ko": "애초에 너랑 그 애는 너무 안 어울려.{FC03}"}
{"id": 1467, "ko": "그, 그런가.{FC03}"}
{"id": 1468, "ko": "응, 그래.{FC01}{F126}학력도 하늘과 땅 차이.{FC03}{F121}너, 대학 같은 건 안 나왔지?{FC03}"}
{"id": 1469, "ko": "그건 그렇지만 겉만 보고 판단하지 마.{FC03}"}
{"id": 1470, "ko": "말해 두는데 그 애는 대학에 수석 입학해\n우주물리학과 철학을 전공하고 있어.{FC03}"}
{"id": 1471, "ko": "뭐?{FC01}{F127}전혀 그렇게 안 보이는데{FFE8:02D3}{FC03}"}
{"id": 1472, "ko": "하지만 나도 지금은 마이너리그지만\n장래엔 메이저리그 선수로 몇억 달러\n연봉을 약속받은{FFE8:02D3}{FC03}"}
{"id": 1473, "ko": "헤에, 너 야구 선수였어?{FC01}{F121}그럼 더더욱 그 애랑 안 맞아.{FC03}"}
{"id": 1474, "ko": "왜 그런데.{FC03}"}
{"id": 1475, "ko": "그 애, 스포츠엔 전혀 관심 없거든.{FC03}"}
{"id": 1476, "ko": "그, 그렇구나.{FC03}"}
{"id": 1477, "ko": "굳, 굳이 말하면 내가 더 관심 있네.{F10F}{FC03}"}
