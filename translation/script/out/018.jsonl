{"id": 3025, "ko": "어머, 그럴까?{FC01}근처 트레이닝 시설도 모르는 사람이?{FC03}"}
{"id": 3026, "ko": "팀 시설로 충분하다고!{FC03}"}
{"id": 3027, "ko": "매일 2시간이나 연습해"}
{"id": 3028, "ko": "매일 4시간 이상 연습해"}
{"id": 3029, "ko": "매일 죽도록 연습해"}
{"id": 3030, "ko": "매일 2시간은 연습한다고!{FC03}"}
{"id": 3031, "ko": "뭐, 겨우 2시간?{FC03}"}
{"id": 3032, "ko": "너, 날 무시하는 거야!{FC03}"}
{"id": 3033, "ko": "내 연습은 내용이 알차다고!{FC03}"}
{"id": 3034, "ko": "매일 4시간 이상은 연습한다고!{FC03}"}
{"id": 3035, "ko": "역시 그 정도잖아!{FC03}"}
{"id": 3036, "ko": "나도 매일 6시간씩 트레이닝을 하고 있어!{FC03}"}
{"id": 3037, "ko": "매일 6시간!{FC03}"}
{"id": 3038, "ko": "아무리 그래도 너무{FFE8:02D3}{FC03}"}
{"id": 3039, "ko": "정상에 서고 싶으면 그 정도는 당연하잖아!{FC03}"}
{"id": 3040, "ko": "너, 너무 물러!{FC03}"}
{"id": 3041, "ko": "확실히 너한텐 못 당하지만{FFE8:02D3}.{FC03}"}
{"id": 3042, "ko": "연습 내용이 다르니까잖아!{FC03}"}
{"id": 3043, "ko": "매일 죽도록 연습해!{FC03}"}
{"id": 3044, "ko": "죽도록이라니!{FC01}"}
{"id": 3045, "ko": "과장이 심하네!{FC03}"}
{"id": 3046, "ko": "그럼 내 연습에 하루 같이해 보시지!{FC03}"}
{"id": 3047, "ko": "아니, 그건 좀{FFE8:02D3}.{FC03}"}
{"id": 3048, "ko": "뭐야, 도망가?{FC03}"}
{"id": 3049, "ko": "뭐라고!{FC01}{F000}좋아, 받아 주지!{FC03}"}
{"id": 3050, "ko": "그 약속, 잊지 마!{FC03}"}
{"id": 3051, "ko": "야, 약속대로 연습 같이하러 왔어!{FC03}"}
{"id": 3052, "ko": "어머, 도망 안 치고 왔네!{FC01}칭찬해 줄게.{FC03}"}
{"id": 3053, "ko": "도망칠 리가 없잖아!{FC01}{F000}테니스 연습 따위, 우리 연습에 비하면\n훨씬 편할 게 뻔하니까!{FC03}"}
{"id": 3054, "ko": "말했겠다!{FC01}각오해 둬!{FC03}"}
{"id": 3055, "ko": "그럼 먼저 가볍게 공원 20바퀴.{FC03}"}
{"id": 3056, "ko": "뭐?{FC01}20바퀴라니, 이 공원 엄청 넓어!{FC03}"}
{"id": 3057, "ko": "자, 간다!{FC03}"}
{"id": 3058, "ko": "헉헉{FFE8:02D3}.{FC03}"}
{"id": 3059, "ko": "진짜 매일{FFE8:02D3} 이렇게 뛰는 거야{FFE8:02D3}?{FC03}"}
{"id": 3060, "ko": "죽겠다{FFE8:02D3}.{FC03}"}
{"id": 3061, "ko": "평소보다 훨씬 느린 페이스야.{FC01}{F121}자, 더 힘내서 뛰어!{FC03}"}
{"id": 3062, "ko": "거, 거짓{FFE8:02D3}.{FC03}"}
{"id": 3063, "ko": "하아하아{FFE8:02D3}.{FC03}"}
{"id": 3064, "ko": "자, 다음은 스트레칭하고 대시 연습.{FC03}"}
{"id": 3065, "ko": "잠깐, 여기서 더 뛰면 죽는다고?{FC03}"}
{"id": 3066, "ko": "뭐야, 한심하게!{FC01}이제 막 시작했잖아!{FC03}"}
{"id": 3067, "ko": "아니, 진짜 무리{FFE8:02D3}{FC03}"}
{"id": 3068, "ko": "정말, 그럼 거기서 쉬고 있든가.{FC01}난 트레이닝 계속할 테니까.{FC03}"}
{"id": 3069, "ko": "으, 응.{FC03}"}
{"id": 3070, "ko": "대단하다{FFE8:02D3}.{FC01}"}
{"id": 3071, "ko": "세계 챔피언이 될 만하네{FFE8:02D3}.{FC03}"}
{"id": 3072, "ko": "진짜 내 연습, 한참 부족하구나{FFE8:02D3}.{FC03}"}
{"id": 3073, "ko": "나도 공원을 좀 더 뛰고 와야지.{FC03}"}
{"id": 3074, "ko": "기다렸지.{FC03}{F125}회복했으면 내 연습에 같이하면 좋을 텐데.{FC03}"}
{"id": 3075, "ko": "아니, 무리야.{FC01}방해만 될 테니까.{FC03}"}
{"id": 3076, "ko": "흥, 제 무름을 알았나 보네.{FC03}"}
{"id": 3077, "ko": "테니스 트레이닝이 이렇게 힘들 줄은{FFE8:02D3}{FC03}"}
{"id": 3078, "ko": "팀 연습만이 아니라 트레이닝이 더\n필요하다는 걸 잘 알았어.{FC03}"}
{"id": 3079, "ko": "어머, 솔직하네!{FC03}"}
{"id": 3080, "ko": "아니, 그만큼 차이를 보고 나니까.{FC03}"}
{"id": 3081, "ko": "또 내 연습에 같이하라고.{FC01}제대로 굴려 줄 테니까!{FC03}"}
{"id": 3082, "ko": "방해 안 되게 체력 단단히 길러 둘게.{FC03}{F134}아, 난 {F010}. 잘 부탁해.{FC03}"}
{"id": 3083, "ko": "난 {FFE8:02B0}, 알고 있지?{FC03}"}
{"id": 3084, "ko": "역시 건방져!{FC03}"}
{"id": 3085, "ko": "잘 있어!{FC03}"}
{"id": 3086, "ko": "좋아, 기초 체력을 위해 달리자!{FC03}"}
{"id": 3087, "ko": "헉, 헉{FFE8:02D3}.{FC03}"}
{"id": 3088, "ko": "어머, {F010}이잖아!{FC03}{F121}흐응~, 나한테 칭찬받으려고 연습하는 거야?{FC03}"}
{"id": 3089, "ko": "그렇지!"}
{"id": 3090, "ko": "아냐!"}
{"id": 3091, "ko": "헛소리!"}
{"id": 3092, "ko": "응, 다음에 연습 같이할 때\n"}
{"id": 3093, "ko": "조금이라도 따라가려고 말이야.{FC03}"}
{"id": 3094, "ko": "어, 정말이야?{FC03}"}
{"id": 3095, "ko": "농담으로 한 말인데.{FC03}"}
{"id": 3096, "ko": "어, 그랬어?{FC03}"}
{"id": 3097, "ko": "아니, 그런 건 아니지만{FFE8:02D3}.{FC03}"}
{"id": 3098, "ko": "농담이야!{FC03}"}
{"id": 3099, "ko": "저번에 같이 연습하고 나서 팀 연습만으론\n"}
{"id": 3100, "ko": "부족하다는 걸 알았거든.{FC03}"}
{"id": 3101, "ko": "흐응, 적극적이네!{FC03}"}
{"id": 3102, "ko": "좀 다시 봤어!{FC03}"}
{"id": 3103, "ko": "헛소리 마, 그냥 트레이닝하는 것뿐이야!{FC03}"}
{"id": 3104, "ko": "또, 솔직히 말하면 돼.{FC03}"}
{"id": 3105, "ko": "어디서 내려다보는 거야!{FC01}"}
{"id": 3106, "ko": "난 너 따위엔 관심 없다고!{FC03}"}
{"id": 3107, "ko": "짝!{FC05}{FC03}"}
{"id": 3108, "ko": "갸아아악!{FC03}"}
{"id": 3109, "ko": "아야야!{FC03}"}
{"id": 3110, "ko": "엉망진창이야!{FC03}"}
{"id": 3111, "ko": "정말, 농담도 안 통해!{FC03}"}
{"id": 3112, "ko": "진짜 최악!{FC03}"}
{"id": 3113, "ko": "나, 프로 활동을 쉬고 대학에 다니고 있어.{FC01}그래도 체력이 떨어지면 큰일이라 대학 앞\n체육관에서 매일 트레이닝하고 있어.{FC03}말만 걸면 언제든 연습 같이해 줄게!{FC03}"}
{"id": 3114, "ko": "그렇구나, 그럼 말 걸게!{FC03}{F12F}살살 부탁해{FC03}"}
{"id": 3115, "ko": "그럼 또 봐!{FC03}"}
{"id": 3116, "ko": "아, {FFE8:02B0}다.{FC03}"}
{"id": 3117, "ko": "굉장한 페이스로 달리네.{FC03}{F12D}좋아, 좀 쫓아가 볼까.{FC03}"}
{"id": 3118, "ko": "쫓아간다"}
{"id": 3119, "ko": "그만둔다"}
{"id": 3120, "ko": "또 날 따라잡았네!{FC03}"}
{"id": 3121, "ko": "저기, 나랑 진짜로 경주하자?{FC03}"}
{"id": 3122, "ko": "용케 날 따라잡았네!{FC03}"}
{"id": 3123, "ko": "나도 프로라고?{FC01}"}
{"id": 3124, "ko": "늘 지기만 하진 않아.{FC03}"}
{"id": 3125, "ko": "흐응~, {F120}그럼 {F121}다음에 나랑 진짜 경주할래?{FC03}"}
{"id": 3126, "ko": "응, 좋아.{FC03}"}
{"id": 3127, "ko": "그래, {F120}그럼 약속이야!{FC03}"}
{"id": 3128, "ko": "자, 패스!{FC03}"}
{"id": 3129, "ko": "오옷!{FC03}"}
{"id": 3130, "ko": "이, 이건?{FC03}"}
{"id": 3131, "ko": "내가 늘 마시는 스포츠음료야!{FC03}"}
{"id": 3132, "ko": "오, 땡큐!{FC03}"}
{"id": 3133, "ko": "꿀꺽꿀꺽!{FC03}"}
{"id": 3134, "ko": "푸하~!{FC03}"}
{"id": 3135, "ko": "그럼 약속 잊지 마!{FC03}"}
{"id": 3136, "ko": "응, 고마워, 맛있었어!{FC03}"}
{"id": 3137, "ko": "아니, 그만둘래.{FC03}"}
{"id": 3138, "ko": "에~, {F123}뭐야, 재미없어!{FC03}"}
{"id": 3139, "ko": "윽, 전혀 못 따라가{FFE8:02D3}.{FC03}"}
{"id": 3140, "ko": "쓸데없이 체력 쓸 필요 없지, 그만두자.{FC03}"}
{"id": 3141, "ko": "다시 도전하러 왔어!{FC03}"}
{"id": 3142, "ko": "응, 완전 OK!{FC03}"}
{"id": 3143, "ko": "야, 기다렸지!{FC03}"}
{"id": 3144, "ko": "바로 시작하자!{FC03}"}
{"id": 3145, "ko": "여기서 저쪽 벤치까지야!{FC03}"}
{"id": 3146, "ko": "오케이!{FC01}언제든 좋아.{FC03}"}
{"id": 3147, "ko": "그럼 이 동전이 떨어지면 스타트야.{FC03}{FC29}"}
{"id": 3148, "ko": "짤랑{FC05}{FC03}"}
{"id": 3149, "ko": "이겼다!!{FC03}"}
{"id": 3150, "ko": "에~!{FC01}"}
{"id": 3151, "ko": "진짜 져 버렸어!{FC03}"}
{"id": 3152, "ko": "후후후, 진심 내면 이 정도지!{FC03}"}
{"id": 3153, "ko": "대단해, 야구 선수가 이렇게 빠르다니!{FC03}"}
{"id": 3154, "ko": "솔직히 다시 봤어!{FC03}"}
{"id": 3155, "ko": "이겨서 다행!{FC03}"}
{"id": 3156, "ko": "졌다~.{FC03}"}
{"id": 3157, "ko": "뭐야, 진짜 경주하면 아직 멀었네!{FC03}"}
{"id": 3158, "ko": "면목없다.{FC03}"}
{"id": 3159, "ko": "언제든 상대해 줄게!{FC01}"}
{"id": 3160, "ko": "달리기에 자신 생기면 또 도전해!{FC03}"}
{"id": 3161, "ko": "응, 부탁할게.{FC03}"}
{"id": 3162, "ko": "있잖아, 좀 물어봐도 돼?{FC03}"}
{"id": 3163, "ko": "응?{FC01}뭔데?{FC03}"}
{"id": 3164, "ko": "는 뭔가 콤플렉스 같은 거\n느끼고 있어?{FC03}"}
{"id": 3165, "ko": "갑자기 어려운 질문이네!{FC03}"}
{"id": 3166, "ko": "물론 있다"}
{"id": 3167, "ko": "전혀없다"}
{"id": 3168, "ko": "글쎄{FFE8:02D3}{FC03}"}
{"id": 3169, "ko": "난 그렇게 소질을 타고난 건\n"}
{"id": 3170, "ko": "아니라서 {FFE8:02B0}처럼 소질 넘치는 사람을\n"}
{"id": 3171, "ko": "볼 때 느껴.{FC03}"}
{"id": 3172, "ko": "나, 전혀 소질 타고나지 않았는데?{FC03}"}
{"id": 3173, "ko": "키도 작고, 파워도 부족하고{FFE8:02D3}{FC03}"}
{"id": 3174, "ko": "키가 작다니{FFE8:02D3}, 여자가 178cm인데?{FC03}"}
{"id": 3175, "ko": "내 키를 잘도 알고 있네!{FC03}"}
{"id": 3176, "ko": "아니, 좀{FFE8:02D3}{FC03}"}
{"id": 3177, "ko": "음, 콤플렉스가 뭐야? 하는 느낌{FC03}"}
{"id": 3178, "ko": "전혀 못 느껴!{FC03}"}
{"id": 3179, "ko": "뭐, 고민 안 하는 게 장점이랄까.{FC03}"}
{"id": 3180, "ko": "왠지 부러운 성격이네.{FC03}"}
{"id": 3181, "ko": "좀 너무 태평한가?{FC03}"}
{"id": 3182, "ko": "난 잔뜩 있거든.{FC01}"}
{"id": 3183, "ko": "키 문제라든가{FFE8:02D3}.{FC03}"}
{"id": 3184, "ko": "키가 큰 거?{FC03}"}
{"id": 3185, "ko": "반대야, 작은 거!{FC03}"}
{"id": 3186, "ko": "아니, 키 크잖아!{FC03}"}
{"id": 3187, "ko": "일류 프로 테니스 선수들 사이에선 난\n엄청 작은 편이야.{FC01}180cm 이상은 당연하고, 190 이상인\n선수도 있다니까!{FC03}"}
{"id": 3188, "ko": "그, 그렇구나!{FC03}{F12F}그게 {FFE8:02B0}의 콤플렉스구나!{FC03}"}
{"id": 3189, "ko": "격려"}
{"id": 3190, "ko": "함께 고민"}
{"id": 3191, "ko": "는 그 차이를 뒤집고 있으니까\n"}
{"id": 3192, "ko": "그게 더 대단한 것 같아!{FC03}"}
{"id": 3193, "ko": "쉽게 말하지 마!{FC01}"}
{"id": 3194, "ko": "얼마나 노력하는지 알기나 해!?{FC03}"}
{"id": 3195, "ko": "알고 있어.{FC01}"}
{"id": 3196, "ko": "노력하는 게 {FFE8:02B0}의 재능 아냐?{FC03}"}
{"id": 3197, "ko": "의 노력을 보면 나도 힘내자고\n"}
{"id": 3198, "ko": "생각하게 돼.{FC03}"}
{"id": 3199, "ko": "낯간지러운 소리 하지 마!{FC03}"}
{"id": 3200, "ko": "아얏, 세게 치지마!{FC03}"}
{"id": 3201, "ko": "소질이란 건 어쩔 수 없으니까.{FC01}"}
{"id": 3202, "ko": "나도 계속 그걸로 고민해 왔고.{FC03}"}
{"id": 3203, "ko": "콤플렉스 같은 건 없다고 했잖아!{FC03}"}
{"id": 3204, "ko": "대충 말하지 마!{FC03}"}
{"id": 3205, "ko": "미안{FFE8:02D3}{FC03}"}
{"id": 3206, "ko": "그렇네.{FC03}"}
{"id": 3207, "ko": "그걸 메우는 건 노력밖에 없을까?{FC03}"}
{"id": 3208, "ko": "그래.{FC03}"}
{"id": 3209, "ko": "나도 {FFE8:02B0}에게 지지 않게 힘낼게!{FC03}"}
{"id": 3210, "ko": "응.{FC03}"}
{"id": 3211, "ko": "하이, {F010}.{FC03}"}
{"id": 3212, "ko": "저번 질문 말인데,{FC03}"}
{"id": 3213, "ko": "키 크게 우유를 권한다"}
{"id": 3214, "ko": "키 작아 다행이라 털어놓는다"}
{"id": 3215, "ko": "팀 동료한테 들었는데, 우유를 마시면 키가\n"}
{"id": 3216, "ko": "큰대!{FC01}"}
{"id": 3217, "ko": "20살 넘어도 크는 경우가 있대.{FC03}"}
{"id": 3218, "ko": "그런 건 옛날부터 해 봤다고!{FC03}"}
{"id": 3219, "ko": "그렇구나, 그래서 키가 그렇게 컸군!{FC03}"}
{"id": 3220, "ko": "그래도 그런 노력할 바엔 연습을 할래.{FC03}"}
{"id": 3221, "ko": "그게 낫다고 {F010}도\n"}
{"id": 3222, "ko": "저번에 말해 줬잖아.{FC03}"}
{"id": 3223, "ko": "아얏, 일일이 때리지 마!{FC03}"}
{"id": 3224, "ko": "정말, 그 얘긴 됐어!{FC03}"}
{"id": 3225, "ko": "의 키가 지금보다 크면\n"}
{"id": 3226, "ko": "오히려 내가 콤플렉스 느꼈을 거야!{FC03}"}
{"id": 3227, "ko": "나란히 걸으면 내가 더 작아지잖아.{FC03}"}
{"id": 3228, "ko": "그런 걸 신경 써?{FC03}"}
{"id": 3229, "ko": "그야 뭐{FFE8:02D3}, 일단.{FC03}"}
{"id": 3230, "ko": "이상해!{FC03}"}
{"id": 3231, "ko": "하이, {F010}.{FC03}{F12F}갑작스러워서 미안한데, {F124}연습에\n같이해 줬으면 하는 날이 있어.{FC01}{F121}5월 첫째 주인데, 시간 돼?{FC03}"}
