{"id": 5957, "ko": "강타자로 홈런을 양산했양스.{FC03}"}
{"id": 5958, "ko": "에엑, 정말?{FC03}"}
{"id": 5959, "ko": "네{FFE8:02D3}, 뭐{FFE8:02D4}.{FC03}"}
{"id": 5960, "ko": "왠지 대단한 사람이 팀 동료에 있네.{FC03}"}
{"id": 5961, "ko": "대단한 건 내가 아니라 아빠잖아!{FC03}"}
{"id": 5962, "ko": "뭐, 그렇지만{FFE8:02D3}{FC03}"}
{"id": 5963, "ko": "기분이 안 나서 오늘은 갈게.{FC03}"}
{"id": 5964, "ko": "오, {FFE8:02AB}다.{FC03}"}
{"id": 5965, "ko": "안녕하양스!{FC03}"}
{"id": 5966, "ko": "오오! 꽤 그려졌네, 아버지 그림.{FC03}"}
{"id": 5967, "ko": "건더 로봇만큼 멋있양스!{FC03}"}
{"id": 5968, "ko": "사실 여긴 어릴 때 아빠랑 자주\n연습하던 곳이야.{FC03}"}
{"id": 5969, "ko": "그래서 여기서 아버지를 떠올리며\n그림을 그리고 있었양스.{FC03}"}
{"id": 5970, "ko": "팀의 아버지는 예전에 무슨 연습 했어"}
{"id": 5971, "ko": "팀은 어릴 때 어떤 연습을 했어?"}
{"id": 5972, "ko": "아버지는 예전에 무슨 연습 했어?{FC03}"}
{"id": 5973, "ko": "음~, 파워 계열 연습이 많았지.{FC01}"}
{"id": 5974, "ko": "나한텐 안 맞았던 것 같지만.{FC01}"}
{"id": 5975, "ko": "분명 집에 아빠가 남긴\n"}
{"id": 5976, "ko": "노트가 있었을 텐데{FFE8:02D3}?{FC03}"}
{"id": 5977, "ko": "위대한 메이저리거가 남긴 연습 노트라.{FC03}"}
{"id": 5978, "ko": "엄청 궁금해!{FC03}"}
{"id": 5979, "ko": "좋~아, 옛날 생각하며 여기서 연습할까!{FC03}"}
{"id": 5980, "ko": "는 어릴 때 무슨 연습 했어?{FC03}"}
{"id": 5981, "ko": "아빠는 파워 연습이 많았는데\n"}
{"id": 5982, "ko": "나한텐 안 맞았던 것 같아서\n"}
{"id": 5983, "ko": "주로 민첩성과 정확성 위주로 연습했어.{FC03}"}
{"id": 5984, "ko": "어릴 때부터 그렇게 생각하며 연습하다니\n"}
{"id": 5985, "ko": "역시 {F010}군과는 딴판이양스!{FC03}"}
{"id": 5986, "ko": "그렇게 대단한 건 안 했지만~\n"}
{"id": 5987, "ko": "그때그때 중요한 건 노트에 정리해서\n"}
{"id": 5988, "ko": "나중에 다시 봤던가.{FC03}"}
{"id": 5989, "ko": "가 기록한 연습 노트라.{FC01}"}
{"id": 5990, "ko": "왠지 궁금해!{FC03}"}
{"id": 5991, "ko": "앗, {FFE8:02AB}양스!{FC03}"}
{"id": 5992, "ko": "오오, 꽤 완성에 가까워진 거 아냐?{FC01}아버지 그림.{FC03}"}
{"id": 5993, "ko": "이제 조금만 더 하면 될까~.{FC03}"}
{"id": 5994, "ko": "는 아버지를 정말 존경하는구나.{FC03}"}
{"id": 5995, "ko": "이 그림 보면 알겠어!{FC03}"}
{"id": 5996, "ko": "일본에 부모님을 버리고 온 {F010}군과는\n딴판이양스.{FC03}"}
{"id": 5997, "ko": "버리고 왔다니{FFE8:02D3}\n"}
{"id": 5998, "ko": "제대로 납득시키고 이쪽에 왔다고.{FC03}"}
{"id": 5999, "ko": "존경{FFE8:02D3}.{FC01}"}
{"id": 6000, "ko": "아버지로서도 야구인으로서도 정말\n존경은 하지만{FFE8:02D3}{FC03}"}
{"id": 6001, "ko": "?{FC03}{F125}{FFE8:02D3}하지만?{FC03}"}
{"id": 6002, "ko": "음~, 한마디로 하면 부담감일까.{FC03}"}
{"id": 6003, "ko": "왜 {FFE8:02AB}가 부담을 느끼양스?{FC01}"}
{"id": 6004, "ko": "메이저 승격도 눈앞에 보이는데.{FC03}"}
{"id": 6005, "ko": "다들 내 성적을 보면 꼭\n홈런이 적다고{FFE8:02D3}말하거든.{FC03}"}
{"id": 6006, "ko": "아아!{FC01}{F123}그런 거구나!{FC03}"}
{"id": 6007, "ko": "그런 거라니 무슨 뜻이양스?{FC03}"}
{"id": 6008, "ko": "그, 그러니까 {FFE8:02AB}의 아버지는 위대한\n"}
{"id": 6009, "ko": "슬러거라서 {FFE8:02AB}에게\n"}
{"id": 6010, "ko": "같은 걸 바란다는 거야.{FC03}"}
{"id": 6011, "ko": "내가 홈런을 못 친다는 걸 알면\n다들 실망하거든.{FC03}"}
{"id": 6012, "ko": "그런! 다들 너무하양스!{FC03}"}
{"id": 6013, "ko": "뭐, 이젠 익숙해졌지만.{FC03}"}
{"id": 6014, "ko": "익숙하다니{FFE8:02D3}정말일까?{FC03}"}
{"id": 6015, "ko": "자, 슬슬 돌아갈까.{FC03}"}
{"id": 6016, "ko": "어~이, {FFE8:02AB}!{FC03}"}
{"id": 6017, "ko": "오, 또 왔구나~.{FC01}{F121}드디어 아빠 그림 완성!{FC03}"}
{"id": 6018, "ko": "예상대로 엄청 잘 그렸양스!{FC03}"}
{"id": 6019, "ko": "굉장한 그림인데\n뭔가 부족한 느낌이야, 이 그림.{FC03}{F120}{F121}{F000}{FFE8:02AB}는 아버지가 권해서\n"}
{"id": 6020, "ko": "야구 시작했어?{FC03}"}
{"id": 6021, "ko": "아니, 아니야~.{FC01}{F120}아빠 플레이를 보다가 야구가 좋아져서\n어느새 스스로 시작했던 거야.{FC03}{F121}그걸 안 아빠가 같이\n연습해 주게 돼서{FFE8:02D3}.{FC01}"}
{"id": 6022, "ko": "그땐 즐거웠지~.{FC03}"}
{"id": 6023, "ko": "분명 아버지도 똑같았을 거야!{FC01}{F121}{FFE8:02AB}와 야구하는 게\n"}
{"id": 6024, "ko": "즐거웠던 게 틀림없어!{FC03}{F135}그 마음이 중요한 거야!{FC03}"}
{"id": 6025, "ko": "군치곤\n드물게 좋은 말 하양스.{FC03}"}
{"id": 6026, "ko": "그러고 보니 요즘 야구할 때 중요한 걸\n잊고 있었던 것 같아!{FC03}"}
{"id": 6027, "ko": "그래도 중요한 게 하나 더 있양스!{FC03}"}
{"id": 6028, "ko": "어? 뭔데?{FC03}"}
{"id": 6029, "ko": "우리는 프로니까\n결과를 내야 한양스.{FC03}"}
{"id": 6030, "ko": "너치고는\n드물게 좋은 말 하네.{FC03}"}
{"id": 6031, "ko": "왜 그렇게 되양스!{FC03}"}
{"id": 6032, "ko": "이 그림 완성했다고 했지만\n좀 다시 그려 볼까.{FC03}"}
{"id": 6033, "ko": "완성 기대하고 있을게.{FC03}"}
{"id": 6034, "ko": "짜잔, 드디어 완성했어~.{FC03}"}
{"id": 6035, "ko": "전에 봤을 때보다 훨씬 더 좋아졌양스!{FC03}"}
{"id": 6036, "ko": "아버지, 최고의 미소네!{FC03}"}
{"id": 6037, "ko": "완전히 떨쳐 냈어~.{FC01}두 사람 덕분에.{FC01}{F124}남들이 어떻게 생각하든 상관없잖아.{FC03}"}
{"id": 6038, "ko": "다행이양스!{FC03}"}
{"id": 6039, "ko": "앗, 맞다 이거{FFE8:02D3},\n"}
{"id": 6040, "ko": "도움이 될지 모르지만 볼래?{FC01}다 같이 메이저에 오르고 싶으니까!{FC03}"}
{"id": 6041, "ko": "이, 이건 {FFE8:02AB} 아버지의 연습 노트다!{FC03}"}
{"id": 6042, "ko": "이, 이건 {FFE8:02AB}의 연습 노트잖아!{FC03}"}
{"id": 6043, "ko": "어디, {FFE8:02D4}{FFE8:02D4}{FFE8:02D4}\n"}
{"id": 6044, "ko": "왠지 야구가 엄청 늘어난 기분이야!{FC03}"}
{"id": 6045, "ko": "공기가 최고로 맛있양스!{FC03}{FC22}"}
{"id": 6046, "ko": "안녕!\n어때, 그림은 잘 그렸어?{FC03}"}
{"id": 6047, "ko": "그럭저럭이에요~.{FC01}지금 밑그림이 끝나서 완성까진\n아직 시간이 걸릴 것 같아요.{FC03}"}
{"id": 6048, "ko": "엄청 잘 그렸양스!{FC03}"}
{"id": 6049, "ko": "그림 그리는 법 알려 줄까?{FC03}"}
{"id": 6050, "ko": "그림보다 야구를 가르쳐 줬으면 좋겠어.{FC03}"}
{"id": 6051, "ko": "어떻게 하면 그렇게 수비를 잘하양스?{FC03}"}
{"id": 6052, "ko": "음~, 침착하게 주위 상황을 잘 보는 걸까~.{FC03}"}
{"id": 6053, "ko": "상황 판단이 중요?{FC03}"}
{"id": 6054, "ko": "왠지 조금 수비가 는 것 같은\n기분이 드양스.{FC03}"}
{"id": 6055, "ko": "{FFE8:02AB},\n"}
{"id": 6056, "ko": "그림은 잘 돼?"}
{"id": 6057, "ko": "또 수비 좀 가르쳐 줘!"}
{"id": 6058, "ko": "그림은 잘 돼?{FC03}"}
{"id": 6059, "ko": "하루쯤이면 완성될 것 같아요~.{FC01}"}
{"id": 6060, "ko": "그림은 이쯤 하고 잠깐\n"}
{"id": 6061, "ko": "트레이닝이나 할까 생각하던 참인데\n"}
{"id": 6062, "ko": "같이 안 할래요?{FC03}"}
{"id": 6063, "ko": "정말이양스!?{FC03}"}
{"id": 6064, "ko": "잘 부탁합니다.{FC03}"}
{"id": 6065, "ko": "아~, 지쳤양스.{FC03}"}
{"id": 6066, "ko": "벌써 완전히 어두워졌네.{FC03}"}
{"id": 6067, "ko": "슬슬 돌아갈까요.{FC03}"}
{"id": 6068, "ko": "그러자.{FC03}"}
{"id": 6069, "ko": "저기, 또 지난번처럼 수비 좀 가르쳐 줘!{FC03}"}
{"id": 6070, "ko": "음~, 오늘은 그림이 잘 안 돼서{FFE8:02D3}\n"}
{"id": 6071, "ko": "미안해요.{FC03}"}
{"id": 6072, "ko": "어쩔 수 없양스.{FC01}"}
{"id": 6073, "ko": "는 그림 그리러 온 거양스.{FC03}"}
{"id": 6074, "ko": "그렇지.{FC01}"}
{"id": 6075, "ko": "방해하면 안 되지.{FC03}"}
{"id": 6076, "ko": "안녕하세요~.{FC03}{F124}방금 그림이 완성됐어요~.{FC03}"}
{"id": 6077, "ko": "꼭 보여 줘.{FC03}"}
{"id": 6078, "ko": "좀 부끄럽지만{FFE8:02D3}{FC03}"}
{"id": 6079, "ko": "마치 프로 화가가 그린 그림 같양스.{FC03}"}
{"id": 6080, "ko": "그림은 잘 모르지만\n이 그림이 꽤 대단하다는 건 알겠어.{FC01}야구 선수 관둬도 화가로 성공하겠네.{FC03}"}
{"id": 6081, "ko": "그럴 순 없어요!{FC01}무슨 일이 있어도 메이저에 올라야죠.{FC03}"}
{"id": 6082, "ko": "어라, {FFE8:02AB}치곤 꽤 딱딱한 말투네.{FC03}"}
{"id": 6083, "ko": "{FFE8:02AB}는 왜 야구를 골랐양스?{FC03}"}
{"id": 6084, "ko": "아빠가 메이저리거였거든.{FC03}"}
{"id": 6085, "ko": "에에에엑!!{FC03}{F120}{F123}아버지가 메이저리거.{FC03}"}
{"id": 6086, "ko": "앗, {FFE8:02D4}{FC01}"}
{"id": 6087, "ko": "시시한 얘기 했네.{FC03}"}
{"id": 6088, "ko": "아버지 얘기 듣고 싶양스.{FC03}"}
{"id": 6089, "ko": "음~, 그건 다음 기회에.{FC01}{F120}{F121}다음엔 산에서 그릴 거라서.{FC03}"}
{"id": 6090, "ko": "이 호수 더 안쪽, 강을 따라가면\n멋진 경치를 볼 수 있는 산골짜기가 나와~.{FC03}"}
{"id": 6091, "ko": "헤에, 몰랐네.{FC03}"}
{"id": 6092, "ko": "놀기 커맨드{FC09}에 {FC07}산{FC09}이\n추가됐습니다!{FC03}"}
{"id": 6093, "ko": "군, 트레이닝하양스.{FC03}"}
{"id": 6094, "ko": "좋아{FC01}{F120}몸을 단련해서\n메이저의 꿈에 한 걸음 더!{FC03}"}
{"id": 6095, "ko": "오오, 둘이 같이 트레이닝이냐?{FC03}"}
{"id": 6096, "ko": "뭐, 열심히 해라. 그럼 간다!{FC03}"}
{"id": 6097, "ko": "응? {FFE8:02A9}가 쓰던 벤치프레스{FFE8:02D3}.{FC03}"}
{"id": 6098, "ko": "군, 뭐 하는 거양스?{FC03}"}
{"id": 6099, "ko": "무거워, 이걸 쉽게 들다니{FC03}"}
{"id": 6100, "ko": "무겁다, 겨우 드는 게 고작.{FC03}"}
{"id": 6101, "ko": "안 돼, 꿈쩍도 안 해{FC03}"}
{"id": 6102, "ko": "녀석, 이런 무게로\n"}
{"id": 6103, "ko": "트레이닝하고 있었다니{FFE8:02D3}.{FC03}"}
{"id": 6104, "ko": "자기한테 맞는 무게로 트레이닝 안 하면\n효과가 적양스, {F010}군.{FC03}"}
{"id": 6105, "ko": "우린 아직 노력이 부족한지도 몰라.{FC03}"}
{"id": 6106, "ko": "우린 노력이 전혀 부족한지도 몰라.{FC03}"}
{"id": 6107, "ko": "우린 생각이 너무 안이했는지도 몰라{FC03}"}
{"id": 6108, "ko": "는 허풍쟁이가 아냐!{FC01}"}
{"id": 6109, "ko": "더 많이 연습을 쌓지 않으면\n우리한테 메이저는 꿈속의 꿈이야!{FC03}"}
{"id": 6110, "ko": "알았양스!{FC01}내일부터 더 많이 연습하겠양스.{FC03}"}
{"id": 6111, "ko": "전혀 모르잖아!!{FC03}"}
{"id": 6112, "ko": "어라, {F010}와 {FFE8:02A7}군요.{FC03}"}
{"id": 6113, "ko": "왜 여기에?{FC03}"}
{"id": 6114, "ko": "네, 트레이닝하러요.{FC03}{F121}{F002}그거 말고 여기 올 이유가 없잖아.{FC03}"}
{"id": 6115, "ko": "그렇군요,"}
{"id": 6116, "ko": "힘들겠네요.{FC03}"}
{"id": 6117, "ko": "감독님이야말로 왜 여기 있양스?{FC03}"}
{"id": 6118, "ko": "가끔 몸 좀 움직이러 와요.{FC01}{F121}이래 봬도 옛날엔 메이저 경험도 있답니다.{FC03}"}
{"id": 6119, "ko": "네? 메이저?{FC03}"}
{"id": 6120, "ko": "메이저라니 혹시 메이저리그 말이에요?{FC03}"}
{"id": 6121, "ko": "네, 그래요.{FC03}{F121}대활약까진 못 했지만\n그럭저럭 열심히 한 편이었던 것 같아요.{FC03}"}
{"id": 6122, "ko": "대단한 일일 텐데\n이 감독이 말하니 전혀 안 그렇게 들려.{FC03}"}
{"id": 6123, "ko": "뭐, 또 상담할 일 있으면 들어 드릴게요.{FC03}"}
{"id": 6124, "ko": "네! 양스.{FC03}"}
{"id": 6125, "ko": "믿어도 되는 걸까, 정말?{FC03}"}
{"id": 6126, "ko": "왔군요, {F010}, {FFE8:02A7}.{FC03}"}
{"id": 6127, "ko": "왔양스!{FC03}"}
{"id": 6128, "ko": "그럼 바로{FFE8:02D3}?{FC01}"}
{"id": 6129, "ko": "뭐였더라?{FC03}"}
{"id": 6130, "ko": "균형 잡는 법을\n가르쳐 주기로 약속했잖아요?{FC03}"}
{"id": 6131, "ko": "그랬죠{FFE8:02D3},\n{F121}좀 놀려 본 것뿐이에요!{FC03}"}
{"id": 6132, "ko": "정말일까.{FC03}"}
{"id": 6133, "ko": "딱 잘라서!\n보디 밸런스의 핵심은 중심입니다.{FC03}"}
{"id": 6134, "ko": "중심이양스?{FC03}"}
{"id": 6135, "ko": "그럼 연습할까요.{FC03}"}
{"id": 6136, "ko": "어때요? 연습 성과는?{FC03}"}
{"id": 6137, "ko": "보디 밸런스가 좋아진 덕분인지\n멈춰 있을 땐 묵직하게 땅을 딛고,\n몸을 움직일 땐\n가볍게 움직이게 된 것 같아요.{FC03}"}
