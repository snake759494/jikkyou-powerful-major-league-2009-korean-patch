{"id": 9858, "ko": "흐음~…{FC20}"}
{"id": 9859, "ko": "그래도 왠지 알 것 같아…{FC03}"}
{"id": 9860, "ko": "그야 {F010}군도\n분명 일본인이라서 그렇소.{FC03}"}
{"id": 9861, "ko": "음~ 그런가…{FC20}"}
{"id": 9862, "ko": "진짜 이유는?"}
{"id": 9863, "ko": "일본은 어떤 곳?"}
{"id": 9864, "ko": "그럼 메이저리거가 되고 싶은\n"}
{"id": 9865, "ko": "진짜 이유는 뭔데?{FC03}{FC29}"}
{"id": 9866, "ko": "그건…{FC21}"}
{"id": 9867, "ko": "가 어릴 때\n"}
{"id": 9868, "ko": "야구를 시작한 계기가 된\n"}
{"id": 9869, "ko": "어느 일본 프로야구 선수가 있었소.{FC01}"}
{"id": 9870, "ko": "의 아이돌, 동경하던 선수요.{FC03}"}
{"id": 9871, "ko": "그리고 그 선수는 당시 일본에선 거의\n"}
{"id": 9872, "ko": "전례가 없었지만\n"}
{"id": 9873, "ko": "메이저를 목표로 홀로 미국에 건너갔소.{FC03}"}
{"id": 9874, "ko": "는 그 모습에 감동했소.{FC01}"}
{"id": 9875, "ko": "자신도 그렇게 되고 싶다고 한 게\n"}
{"id": 9876, "ko": "계기요.{FC01}"}
{"id": 9877, "ko": "흔한 단순 사고 야구 소년 얘기요.{FC03}"}
{"id": 9878, "ko": "야구 선수를 꿈꾸는 사람은\n"}
{"id": 9879, "ko": "처음엔 다들 그런 거 아닐까.{FC01}"}
{"id": 9880, "ko": "그래서 그 선수는 메이저리거가 되어\n"}
{"id": 9881, "ko": "활약했어?{FC03}"}
{"id": 9882, "ko": "안 됐소…{FC20}"}
{"id": 9883, "ko": "3년간 마이너에서 고생한 뒤\n"}
{"id": 9884, "ko": "겨우 메이저행이 정해졌을 때 부상,\n"}
{"id": 9885, "ko": "그리고 그대로 은퇴해 버렸소.{FC03}"}
{"id": 9886, "ko": "그래… 안타깝네…{FC20}"}
{"id": 9887, "ko": "그래서 {FFE8:0298}는\n"}
{"id": 9888, "ko": "그 사람의 꿈을 멋대로 이어받아\n"}
{"id": 9889, "ko": "메이저를 노리고 있는 것이오!{FC03}"}
{"id": 9890, "ko": "그럼 내일부터 같이 힘내자!{FC03}"}
{"id": 9891, "ko": "내일부터라니 그러면 안 되오!{FC01}"}
{"id": 9892, "ko": "오늘부터 힘내는 것이오!{FC01}"}
{"id": 9893, "ko": "자, 연습하러 가오!{FC03}"}
{"id": 9894, "ko": "아까는 자기가 말했으면서…{FC20}"}
{"id": 9895, "ko": "뭐, 됐나.{FC03}"}
{"id": 9896, "ko": "좋아, 땀 흘리자!{FC03}"}
{"id": 9897, "ko": "그러고 보니 일본은 어떤 곳이야?{FC03}"}
{"id": 9898, "ko": "일본 말이오…?{FC20}"}
{"id": 9899, "ko": "좋은 곳이오.{FC03}"}
{"id": 9900, "ko": "어떤 점이?{FC03}"}
{"id": 9901, "ko": "얼마 전까지 GDP 세계 1위,\n"}
{"id": 9902, "ko": "물가 비싸고, 좁고 월세 비싼 집에서\n"}
{"id": 9903, "ko": "서쪽만 바라보며 살고,\n"}
{"id": 9904, "ko": "휴대폰과 애니와 만화와 게임이 성하고,{FC03}"}
{"id": 9905, "ko": "깔끔 떨고, 식량 자급률 무척 낮고,\n"}
{"id": 9906, "ko": "정치 욕하면서 선거엔 안 가는 사람이 많고,{FC01}"}
{"id": 9907, "ko": "다들 식구엔 다정하고,{FC03}"}
{"id": 9908, "ko": "제 역사도 모르는 이가 많은"}
{"id": 9909, "ko": "후지산이 무척 예쁜 좋은 나라요.{FC03}"}
{"id": 9910, "ko": "…정말 좋은 곳이네.{FC20}"}
{"id": 9911, "ko": "군, 기다렸소.{FC01}이거 주겠소.{FC03}"}
{"id": 9912, "ko": "오, 두부 아냐?{FC01}{F120}이거 웬 거야?{FC03}"}
{"id": 9913, "ko": "본가에서 보내온 정통 교토 두부요.{FC01}다 못 먹으니 나눠 주는 것이오.{FC01}{F120}최신 진공 포장이라 신선도도 맛도 그대로고\n꽤 오래 가오.{FC03}"}
{"id": 9914, "ko": "흐음~ 설명이 좀 길지만 고마워.{FC01}{F120}그래도 좋겠다, {FFE8:0298}군은 가족이 있어서.{FC03}"}
{"id": 9915, "ko": "군에게도\n분명 있을 것이오.{FC01}{F124}그래도 우리 집은 이래저래 힘들다오.{FC03}"}
{"id": 9916, "ko": "뭐가 힘든데?{FC03}"}
{"id": 9917, "ko": "듣고 싶소?{FC01}"}
{"id": 9918, "ko": "역시 됐어"}
{"id": 9919, "ko": "응, 괜찮으면 들려줘.{FC03}"}
{"id": 9920, "ko": "안 괜찮으니 안 알려 주겠소.{FC03}"}
{"id": 9921, "ko": "뭐야 그게…{FC20}"}
{"id": 9922, "ko": "자, 오늘은 기분 전환하러 놀러 가오.{FC03}"}
{"id": 9923, "ko": "기분 전환…?{FC03}"}
{"id": 9924, "ko": "정말 여러 일이 있나…{FC20}"}
{"id": 9925, "ko": "역시 됐어, 물어보면 실례일 것 같고.{FC03}"}
{"id": 9926, "ko": "그렇지도 않소.{FC01}"}
{"id": 9927, "ko": "아버지가 죽을 것 같을 뿐이오.{FC03}"}
{"id": 9928, "ko": "그거 엄청 큰일이잖아!?{FC03}"}
{"id": 9929, "ko": "아니, 그렇지도 않소.{FC01}"}
{"id": 9930, "ko": "늘 금방 기운을 차리니까 말이오.{FC01}"}
{"id": 9931, "ko": "그런 부모요.{FC03}"}
{"id": 9932, "ko": "음~… 알 것 같기도 하고 모르겠기도…{FC20}"}
{"id": 9933, "ko": "사람은 언젠가 죽는 법이오,{FC01}"}
{"id": 9934, "ko": "그리 신경 쓸 것 없소.{FC01}"}
{"id": 9935, "ko": "역시 이래저래 걱정이 있구나…{FC20}"}
{"id": 9936, "ko": "…{F133}좋아, 가자!{FC03}"}
{"id": 9937, "ko": "군, 기다렸소.{FC03}"}
{"id": 9938, "ko": "오, {FFE8:0298}군, 글러브 좋네?{FC01}"}
{"id": 9939, "ko": "새로 산 거야?{FC03}"}
{"id": 9940, "ko": "일본에서 보내온 것이오.{FC01}아는 사람 중에 스포츠용품 회사 사람이\n있소.{FC03}{F120}그래서 신제품이 나오면 {FFE8:0298}에게\n"}
{"id": 9941, "ko": "모니터를 부탁하려고 보내 주는 것이오.{FC03}"}
{"id": 9942, "ko": "오, 좋다.{FC01}나도 모니터 시켜 줘.{FC03}"}
{"id": 9943, "ko": "그럼 {F010}군에게\n"}
{"id": 9944, "ko": "이 글러브를 주겠소.{FC01}"}
{"id": 9945, "ko": "아직 몇 개 있으니 신경 쓰지 마시오.{FC03}"}
{"id": 9946, "ko": "그럼 {F010}군에겐\n"}
{"id": 9947, "ko": "다음에 배트를 가져다주겠소.{FC03}"}
{"id": 9948, "ko": "오, 고마워, {FFE8:0298}군!{FC03}"}
{"id": 9949, "ko": "그래도 제대로 모니터로서\n사용 보고를 해야 하오.{FC03}"}
{"id": 9950, "ko": "그래, 맡겨 줘!{FC03}"}
{"id": 9951, "ko": "군, 기다렸소.{FC01}{F120}그러고 보니 전에 준 모니터용"}
{"id": 9952, "ko": "글러브"}
{"id": 9953, "ko": "배트"}
{"id": 9954, "ko": "상태는\n어떻소?{FC01}"}
{"id": 9955, "ko": "최고야"}
{"id": 9956, "ko": "그럭저럭"}
{"id": 9957, "ko": "왠지 손에 안 익어"}
{"id": 9958, "ko": "응, 최고야.{FC01}"}
{"id": 9959, "ko": "엄청 마음에 들어.{FC03}"}
{"id": 9960, "ko": "그렇소, 그거 다행이오.{FC01}"}
{"id": 9961, "ko": "그럼 계속 모니터 부탁하오.{FC03}"}
{"id": 9962, "ko": "그래, 맡겨 줘.{FC01}"}
{"id": 9963, "ko": "자, 그럼 가 볼까.{FC03}"}
{"id": 9964, "ko": "그럭저럭…{FC21}"}
{"id": 9965, "ko": "나쁘진 않은데\n"}
{"id": 9966, "ko": "뭔가 부족한 느낌이야.{FC03}"}
{"id": 9967, "ko": "그럼 이 왁스를 써 보시오.{FC01}"}
{"id": 9968, "ko": "더 잘 맞고 좋아질 것이오.{FC03}"}
{"id": 9969, "ko": "나쁘진 않은데 왠지 손에 안 익어.{FC03}"}
{"id": 9970, "ko": "그럼 이 왁스를 써 보면 좋을 것이오.{FC01}"}
{"id": 9971, "ko": "지금보다 잘 맞아서 훨씬 좋아질지도\n"}
{"id": 9972, "ko": "모르오.{FC03}"}
{"id": 9973, "ko": "좋아, 그럼 써 볼게.{FC01}고마워, {FFE8:0298}군!{FC03}"}
{"id": 9974, "ko": "이것도 모니터니 보고 잊으면 안 되오.{FC03}"}
{"id": 9975, "ko": "라저!{FC03}"}
{"id": 9976, "ko": "무슨 일이야, {F010}?\n갑자기 불러내고?{FC03}"}
{"id": 9977, "ko": "{FFE8:029B}랑 친해지고 싶어서.{FC01}"}
{"id": 9978, "ko": "지금까지 별로 얘기한 적도 없잖아.{FC03}"}
{"id": 9979, "ko": "너 거짓말하고 있지?{FC01}진짜를 말해 봐.{FC01}"}
{"id": 9980, "ko": "아니, 진짜야"}
{"id": 9981, "ko": "저주 얘기로 협력 부탁"}
{"id": 9982, "ko": "아니, 진짜야.{FC01}"}
{"id": 9983, "ko": "너 야구 선수로서 대단하잖아.{FC01}"}
{"id": 9984, "ko": "나 꽤 존경하고 있다고.{FC03}"}
{"id": 9985, "ko": "또 그런 번지르르한 소리를…{FC03}"}
{"id": 9986, "ko": "진짜라니까!\n"}
{"id": 9987, "ko": "어떻게 말해야 믿어 줄 건데.{FC03}"}
{"id": 9988, "ko": "믿어?{FC21}"}
{"id": 9989, "ko": "난 믿지 않아,{FC21}"}
{"id": 9990, "ko": "누구도.{FC01}"}
{"id": 9991, "ko": "난 간다, 그럼 이만!{FC03}"}
{"id": 9992, "ko": "기다려, {FFE8:029B}!{FC03}"}
{"id": 9993, "ko": "저 녀석, 대체 무슨 일이 있었던 거지…?{FC20}"}
{"id": 9994, "ko": "저주라니…{FC21}"}
{"id": 9995, "ko": "아하하하하…{FC20}"}
{"id": 9996, "ko": "너 정말 그걸 믿으라는 거야?{FC03}"}
{"id": 9997, "ko": "그래, 맞아.{FC01}"}
{"id": 9998, "ko": "하지만 설령 거짓말이라 해도\n"}
{"id": 9999, "ko": "서로 도우며 힘을 길러서\n"}
{"id": 10000, "ko": "메이저를 노리면 되잖아!{FC03}"}
{"id": 10001, "ko": "넌 GM한테 잘 이용당하는 것뿐이야.{FC01}"}
{"id": 10002, "ko": "설령 사실이라 해도 나랑은 상관없어.{FC01}"}
{"id": 10003, "ko": "난 내 힘으로 메이저에 갈 뿐이야.{FC03}"}
{"id": 10004, "ko": "너한테 협력할 생각도 없고\n"}
{"id": 10005, "ko": "도움받을 생각도 전혀 없어.{FC01}"}
{"id": 10006, "ko": "난 간다,{FC21}"}
{"id": 10007, "ko": "는 아직 안 왔나.{FC03}"}
{"id": 10008, "ko": "혹시 그 녀석 대충 약속하고\n"}
{"id": 10009, "ko": "처음부터 여기 올 생각이\n"}
{"id": 10010, "ko": "없었던 거 아냐…?{FC03}"}
{"id": 10011, "ko": "전화도 안 받고…{FC20}"}
{"id": 10012, "ko": "이만 가자.{FC03}"}
{"id": 10013, "ko": "역시 {FFE8:029B}는 안 왔나…{FC20}"}
{"id": 10014, "ko": "기대한 내가 바보인가…?{FC03}"}
{"id": 10015, "ko": "아~ 피곤하다…{FC20}"}
{"id": 10016, "ko": "오늘 달리기는 이쯤 해 두자.{FC01}자, 마침 배도 고프니 뭐 먹으러 가자.{FC03}{F12E}{F10D}{FC20}"}
{"id": 10017, "ko": "저건…?{FC20}"}
{"id": 10018, "ko": "저건 {FFE8:029B} 아냐!?{FC01}"}
{"id": 10019, "ko": "그 애랑 아는 사이였구나…{FC01}{F125}…뭔가 즐거워 보이네.{FC20}"}
{"id": 10020, "ko": "뭐, 됐다, 가자.{FC03}"}
{"id": 10021, "ko": "역시 {FFE8:029B}는 안 왔구나…{FC20}"}
{"id": 10022, "ko": "{FFE8:029B}에게 {FFE8:029C}의 진실을\n"}
{"id": 10023, "ko": "알려 줘야지.{FC01}{F133}좋아, 직접 그 녀석 방에 가 보자!{FC03}{F035}{FC29}"}
{"id": 10024, "ko": "들어간다 {FFE8:029B}, 있지!{FC03}"}
{"id": 10025, "ko": "뭐야 {F010}, 갑자기 들어와서?{FC03}"}
{"id": 10026, "ko": "너야말로 왜 맨날 약속 어기고\n약속 장소에 안 오는 건데!{FC03}"}
{"id": 10027, "ko": "아니, 약속만 하면 꼭\n지병인 복통이…{FC20}"}
{"id": 10028, "ko": "또 그런 뻔한 거짓말을…{FC01}{F123}그보다 오늘은 너한테 할 얘기가 있어.{FC03}"}
{"id": 10029, "ko": "이제 그 애를 만나지 말라고?{FC01}너랑은 상관없잖아, 그런 거!{FC01}그 애는 기억을 잃은 불쌍한 애라고!{FC01}내버려 둘 수 있겠냐!{FC03}"}
{"id": 10030, "ko": "그러니까 다 알려 줬잖아,\n그것도 남자를 꾀는 거짓말이라고.{FC03}"}
{"id": 10031, "ko": "그 애가, {FFE8:029C}가 그런 애일 리가!{FC01}"}
{"id": 10032, "ko": "너야말로 왜 그런 거짓말을 하는데!{FC03}"}
{"id": 10033, "ko": "나도 너도 대충 놀아난 것뿐이야.{FC03}{F120}너답지 않아, {FFE8:029B},\n"}
{"id": 10034, "ko": "좀 냉정해져.{FC03}"}
{"id": 10035, "ko": "미안했다, {F010}.{FC01}일부러 알려 주러 왔는데 머리에 피가 솟아서.{FC03}"}
{"id": 10036, "ko": "아니, 알아주면 됐어.{FC03}"}
{"id": 10037, "ko": "그래, 잘 알았어…{FC20}"}
{"id": 10038, "ko": "그래도 진짜 그 애는\n그런 녀석이 아닐지도 몰라.{FC01}입으로는 그렇게 말했다 해도.{FC03}"}
{"id": 10039, "ko": "그럴까…{FC20}"}
{"id": 10040, "ko": "난 좀 안쓰러운 애로밖에 안 보여.{FC01}{F121}같이 있으면 좀 즐겁긴 해도.{FC03}"}
{"id": 10041, "ko": "나도 그래.{FC01}여자애한테 이런 기분이 든 건\n지금까지 없었으니까…{FC03}"}
{"id": 10042, "ko": "난 그 애랑은 지금 이대로 지낼 거야.{FC01}역시 친구니까.{FC03}"}
{"id": 10043, "ko": "그래…{FC20}"}
{"id": 10044, "ko": "알았어.{FC01}{F125}그래도 난 역시 그렇게는 생각 안 되네…{FC03}"}
{"id": 10045, "ko": "그리고 지금까지 약속 어겨서 미안했다.{FC01}{F121}앞으로는 약속 제대로 지킬 테니\n마음 내키면 불러 줘.{FC03}"}
{"id": 10046, "ko": "그래, 알았어!{FC01}같이 메이저를 목표로 힘내자!{FC03}"}
{"id": 10047, "ko": "뭐, 조금은 어울려 주지.{FC01}"}
{"id": 10048, "ko": "하지만 난 트레이닝 말곤 안 어울려.{FC01}놀 여유 따윈 없으니까.{FC03}"}
{"id": 10049, "ko": "알았어.{FC01}그런데 {FFE8:029C}와도 연습하는 거야?{FC03}"}
{"id": 10050, "ko": "아니…{FC21}"}
{"id": 10051, "ko": "그래, 맞아!{FC20}"}
{"id": 10052, "ko": "불만?!{FC03}"}
