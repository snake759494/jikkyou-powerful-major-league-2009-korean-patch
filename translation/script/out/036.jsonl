{"id": 6684, "ko": "하바네로면 엄청 매운 고추 맞죠?{FC03}"}
{"id": 6685, "ko": "잘 아네.{FC01}무려 42번이나 개량한 자신작이야!{FC03}"}
{"id": 6686, "ko": "42번이나 개량했으면 꽤 맛있을지도?{FC03}"}
{"id": 6687, "ko": "그럼 이걸로 할까?{FC03}"}
{"id": 6688, "ko": "사장님 추천 스테이크 두 개 주세요.{FC03}"}
{"id": 6689, "ko": "고마워!{FC01}그럼 바로 이 룰렛을 돌려 줘.{FC03}"}
{"id": 6690, "ko": "룰렛!?{FC03}"}
{"id": 6691, "ko": "룰렛에 1~42까지 번호가 있네요.{FC03}"}
{"id": 6692, "ko": "자, 운명의 갈림길!{FC01}누구부터 할래?"}
{"id": 6693, "ko": "그럼 나부터"}
{"id": 6694, "ko": "레이디 퍼스트로 마코부터"}
{"id": 6695, "ko": "부터 해.{FC03}"}
{"id": 6696, "ko": "그럼 내가 먼저 할게.{FC03}"}
{"id": 6697, "ko": "드르르륵{FFE8:02D4}\n{F003}탁!{FC03}{FC0E}"}
{"id": 6698, "ko": "오오, 7번! 럭키 7이네.{FC03}"}
{"id": 6699, "ko": "그럼 다음은 나다.{FC03}"}
{"id": 6700, "ko": "자, {FFE8:02AC} 차례야.{FC03}"}
{"id": 6701, "ko": "오, 42번! 죽을 사!{FC03}"}
{"id": 6702, "ko": "재수 없는 소리 하지 마세요!{FC03}"}
{"id": 6703, "ko": "후훗, 농담이야.{FC03}{F121}그럼 잠시 기다려 줘.{FC03}"}
{"id": 6704, "ko": "자, 맛있어 보이지~.{FC01}뜨거울 때 먹어.{FC03}"}
{"id": 6705, "ko": "잘 먹겠습니다.{FC03}{FFE8:032C}{FC03}"}
{"id": 6706, "ko": "마, 맛있다!{FC01}좀 맵지만 맛이 좋은데요.{FC03}"}
{"id": 6707, "ko": "? 왜 그래?{FC03}"}
{"id": 6708, "ko": "머, 먹다가 기절했어!{FC03}{F138}{F112}대체 뭘 한 거예요!?{FC03}"}
{"id": 6709, "ko": "이상하네~,\n하바네로가 너무 셌나~?{FC03}"}
{"id": 6710, "ko": "무슨 말이에요?{FC03}"}
{"id": 6711, "ko": "그야 하바네로 매운맛 42배니까!{FC03}"}
{"id": 6712, "ko": "뭐어어!{FC03}"}
{"id": 6713, "ko": "잠깐만요.{FC01}"}
{"id": 6714, "ko": "42는 제 거였는데?{FC03}"}
{"id": 6715, "ko": "어머, 그랬나?{FC01}"}
{"id": 6716, "ko": "착각했나 보네.{FC03}"}
{"id": 6717, "ko": "휴우~.{FC03}"}
{"id": 6718, "ko": ", 정신 들어?{FC03}"}
{"id": 6719, "ko": "너, 괜찮니?{FC03}"}
{"id": 6720, "ko": "네, 겨우{FFE8:02D3}.{FC01}"}
{"id": 6721, "ko": "갑자기 정신을 잃은 것 같아요{FFE8:02D3}.{FC03}"}
{"id": 6722, "ko": "미안해, 기절할 정도일 줄은 몰랐어!{FC03}"}
{"id": 6723, "ko": "아뇨, 괜찮아요.{FC01}이게 제 운명이니까요.{FC03}"}
{"id": 6724, "ko": "오늘 밥값은 공짜로 해 줄 테니까~\n좀 봐줘!{FC03}"}
{"id": 6725, "ko": "앞으로는 꼭 맛을 보고 나서\n메뉴에 올리세요.{FC03}"}
{"id": 6726, "ko": "알았어.{FC03}{F002}{F121}튼튼해 보이는 시식 담당을\n알바로 고용할까~.{FC03}"}
{"id": 6727, "ko": "여기서 가볍게 먹고 갈까?{FC03}"}
{"id": 6728, "ko": "그래요.{FC03}{F003}{F120}이 가게 명물\n{F003}{FFE8:04A6}을(를) 먹었다.{FC03}"}
{"id": 6729, "ko": "그래요.{FC03}"}
{"id": 6730, "ko": "{FFE8:04A7}은(는)\n"}
{"id": 6731, "ko": "평판이 꽤 좋은가 봐.{FC03}"}
{"id": 6732, "ko": "특이한 이름이네요.{FC03}"}
{"id": 6733, "ko": "소문으로는 깜짝 놀랄 만큼 큰 버거가\n나온대.{FC03}"}
{"id": 6734, "ko": "그래서 {FFE8:04A7}군요.{FC03}"}
{"id": 6735, "ko": "어서 오세요!{FC01}주문하시겠어요?{FC03}"}
{"id": 6736, "ko": "두 개 주세요.{FC03}"}
{"id": 6737, "ko": "네, 감사합니다.{FC03}"}
{"id": 6738, "ko": "기다리셨습니다!{FC03}"}
{"id": 6739, "ko": "오오~.{FC03}"}
{"id": 6740, "ko": "이건 정말 깜짝이네요.{FC03}"}
{"id": 6741, "ko": "생각보다 큰 버거네.{FC01}소문날 만하다.{FC03}"}
{"id": 6742, "ko": "5세트 주세요.{FC03}"}
{"id": 6743, "ko": "5세트!{FC03}"}
{"id": 6744, "ko": "어머, 식욕이 대단하시네요.{FC03}"}
{"id": 6745, "ko": "{FFE8:04A7}이 정말 좋은가 봐.{FC03}"}
{"id": 6746, "ko": "뭐, 뭐~.{FC01}"}
{"id": 6747, "ko": "누가 좋아서 5인분이나 먹겠냐! 이딴 걸!{FC03}"}
{"id": 6748, "ko": "아아, 안 돼! 이래서는{FFE8:02D3}.{FC01}"}
{"id": 6749, "ko": "마음은 거부하는데 몸이 원한다.{FC01}"}
{"id": 6750, "ko": "내 몸이 어떻게 된 거지!{FC03}"}
{"id": 6751, "ko": "무슨 소리예요?{FC03}"}
{"id": 6752, "ko": "아무래도 버거 중독이 된 모양이다.{FC03}"}
{"id": 6753, "ko": "버거 중독?{FC03}"}
{"id": 6754, "ko": "사정이 있어서 예전에 버거를 매일\n"}
{"id": 6755, "ko": "배 터지게 먹었지.{FC01}"}
{"id": 6756, "ko": "그 악습이 망령이 되어\n"}
{"id": 6757, "ko": "아직도 날 괴롭히다니.{FC03}"}
{"id": 6758, "ko": ", 액막이로 어떻게 안 될까?{FC03}"}
{"id": 6759, "ko": "그건 무리예요.{FC01}"}
{"id": 6760, "ko": "병이니까요{FFE8:02D3}이 증상은.{FC03}"}
{"id": 6761, "ko": "큭, 끝까지 내 야구 인생을 방해할 셈이냐!{FC03}"}
{"id": 6762, "ko": "야구인생?{FC01}"}
{"id": 6763, "ko": "그러고 보니 모자에 GS 마크{FFE8:02D3}{FC01}"}
{"id": 6764, "ko": "저 사람도 야구 선수인가?{FC03}"}
{"id": 6765, "ko": "무슨 일이에요 {F010} 씨?{FC03}"}
{"id": 6766, "ko": "아니, 아무것도.{FC01}"}
{"id": 6767, "ko": "자, 먹자!{FC03}"}
{"id": 6768, "ko": "오늘 정말 즐거웠어요!{FC03}"}
{"id": 6769, "ko": "정말?{FC01}{F122}좋아해 줘서 나도 기뻐!{FC03}"}
{"id": 6770, "ko": "바래다줘서 고마웠어요.{FC03}"}
{"id": 6771, "ko": ", 조심해서 들어가!{FC03}"}
{"id": 6772, "ko": "난 행복한 놈이야~.{FC03}"}
{"id": 6773, "ko": "조심해서 들어가!{FC03}"}
{"id": 6774, "ko": "저, 저기, {FFE8:02AC}!{FC03}"}
{"id": 6775, "ko": "네, 뭔가요?{FC03}"}
{"id": 6776, "ko": "조심해서 들어가!"}
{"id": 6777, "ko": "나랑 사귀어 줘!"}
{"id": 6778, "ko": "나, 나랑 사귀어 줘!{FC03}"}
{"id": 6779, "ko": "네. 저라도 좋다면요.{FC01}"}
{"id": 6780, "ko": "앞으로도 잘 부탁해요.{FC03}"}
{"id": 6781, "ko": "난 행복한 놈이야~.{FC03}{F003}{FFE8:02AC}와 사귀게 됐다.{FC03}"}
{"id": 6782, "ko": "마음은 기쁘지만\n"}
{"id": 6783, "ko": "아직 마음 정리가 안 됐어요.{FC03}"}
{"id": 6784, "ko": "아직 포기 안 해!{FC03}"}
{"id": 6785, "ko": "씨,\n메이저 승격 축하해요.{FC03}"}
{"id": 6786, "ko": "이것도 {FFE8:02AC}의 액막이 덕분이야!{FC03}"}
{"id": 6787, "ko": "그래도 좀 쓸쓸하기도 해요{FFE8:02D3}.{FC03}"}
{"id": 6788, "ko": "응? 왜?{FC03}"}
{"id": 6789, "ko": "메이저라는 큰 무대로 날아가는\n{F124}{F010} 씨가 멀어질 것 같아서{FFE8:02D3}{FC03}"}
{"id": 6790, "ko": "{FFE8:02D3}{FC03}"}
{"id": 6791, "ko": "메이저 선수가 돼도 나는 나야.\n{F120}{F134}지금이랑 아무것도 안 변해!{FC03}{F120}{F132}무, 물론 {FFE8:02AC}를 향한 사랑도{FFE8:02D3}{FC03}"}
{"id": 6792, "ko": "씨{FFE8:02D3}\n"}
{"id": 6793, "ko": "정말 기뻐요!{FC03}"}
{"id": 6794, "ko": "인생 최고의 날~!{FC03}"}
{"id": 6795, "ko": "혹시 인생의 운을 전부\n다 써 버린 걸까~?{FC03}"}
{"id": 6796, "ko": "의외로 그럴지도{FC20}"}
{"id": 6797, "ko": "몰라요.{FC03}"}
{"id": 6798, "ko": "메이저리거와 액막이사{FFE8:02D3}.{FC01}{F003}좀 특이한 조합의 커플이지만\n{F003}분명 운명적인 만남이었다고 믿는다!{FC03}{F003}굿럭!{FC03}"}
{"id": 6799, "ko": "　　{FC0D}{FC08}스파이시 치킨 세트{FC0E}"}
{"id": 6800, "ko": "　{FC0D}{FC08}피시 프라이 세트{FC0E}"}
{"id": 6801, "ko": "　{FC0D}{FC08}미트파이 세트{FC0E}"}
{"id": 6802, "ko": "포크소테 세트{FC0E}"}
{"id": 6803, "ko": "　　　{FC0D}{FC08}깜짝 버거 세트{FC0E}"}
{"id": 6804, "ko": "　{FC0D}{FC08}깜짝 버거{FC0E}"}
{"id": 6805, "ko": "하바네로스테이크42{FC0E}"}
{"id": 6806, "ko": "{FC0D}{FC08}특제 메가 스테이크 세트{FC0E}"}
{"id": 6807, "ko": "{FC0D}{FC08}더블 메가 스테이크{FC0E}"}
{"id": 6808, "ko": "　　　{FC0D}{FC08}특제 아메리칸 빅 스테이크{FC0E}"}
{"id": 6809, "ko": "　　{FC0D}{FC08}트로피컬 스테이크{FC0E}"}
{"id": 6810, "ko": "　　　{FC0D}{FC08}과일 스테이크{FC0E}"}
{"id": 6811, "ko": "일식 스테이크{FC0E}"}
{"id": 6812, "ko": "{FC0D}{FC08}반시뱀 소금구이{FC0E}"}
{"id": 6813, "ko": "{FC0D}{FC08}개구리 조림{FC0E}"}
{"id": 6814, "ko": "참마벌레 튀김{FC0E}"}
{"id": 6815, "ko": "　　{FC0D}{FC08}하트 모양 브로치{FC0E}"}
{"id": 6816, "ko": "　　　{FC0D}{FC08}별 모양 귀걸이{FC0E}"}
{"id": 6817, "ko": "일본 머리핀{FC0E}"}
{"id": 6818, "ko": "호, 호, 호, 호, 호, 호, {FFE8:02D4}{FC03}"}
{"id": 6819, "ko": "아, 그러고 보니{FFE8:02D4},\n"}
{"id": 6820, "ko": "며칠 전 집에서 액막이 관련 골동품을\n정리하다가 이런 걸 찾았는데요{FFE8:02D4}.{FC03}"}
{"id": 6821, "ko": "네? 뭔데요?{FC03}"}
{"id": 6822, "ko": "자연계에 있는 특수한 영양제 같은 건데,{FC01}{F125}설명하기 어렵지만 한약\n정도로 생각하시면{FFE8:02D3}.{FC03}"}
{"id": 6823, "ko": "으윽, 딱 봐도 맛없겠다.{FC03}"}
{"id": 6824, "ko": "뜻밖의 능력이 꽃필지도 몰라요{FC03}"}
{"id": 6825, "ko": "어쩌지?{FC03}"}
{"id": 6826, "ko": "받는다"}
{"id": 6827, "ko": "거절"}
{"id": 6828, "ko": ", 고마워!\n"}
{"id": 6829, "ko": "잘 받을게.{FC03}"}
{"id": 6830, "ko": "단숨에 삼킬 수밖에 없군~{FC03}{FC0D}{F003}{FC09}꿀꺽{FC03}{FC0E}"}
{"id": 6831, "ko": "씨!? 괜찮아요{FFE8:02D3}?{FC03}"}
{"id": 6832, "ko": "뭔가 내 안에서 터진 것 같아!{FC03}"}
{"id": 6833, "ko": "기분 탓인가~?{FC03}"}
{"id": 6834, "ko": "모처럼이지만 사양할게.{FC01}"}
{"id": 6835, "ko": "내 능력은 내 힘으로 꽃피우고 싶거든!{FC03}"}
{"id": 6836, "ko": "알겠어요.{FC03}"}
{"id": 6837, "ko": "첫 이벤트를 건너뛸까요?{FC01}"}
{"id": 6838, "ko": "첫 이벤트를 건너뜁니다{FC03}"}
{"id": 6839, "ko": "설마 바로 AAA 팀에 합격할 줄이야!{FC03}{F12D}내 숨은 재능이 꽃피기 시작한 건가?{FC03}{F126}앗, 저 사람도 아시아인 같네.{FC03}"}
{"id": 6840, "ko": "헬로!{FC03}"}
{"id": 6841, "ko": "헤, 헬로양스.{FC03}"}
{"id": 6842, "ko": "양스라니!{FC03}{F12B}혹시 당신도 일본인?{FC03}"}
{"id": 6843, "ko": "네, 그렇양스.{FC03}{F143}일본에서 곧바로 AAA에 뽑힌{FC01}{F143}기대의 초신성 {FFE8:02A8}이양스.{FC03}"}
{"id": 6844, "ko": "어, 너도 바로 AAA에 뽑혔어?{FC03}"}
{"id": 6845, "ko": "그렇양스. 유도양스?{FC03}"}
{"id": 6846, "ko": "유도라니{FFE8:02D3}.{FC03}{F003}웅성웅성"}
{"id": 6847, "ko": "사람들이 잔뜩 모여들었어!{FC03}"}
{"id": 6848, "ko": "정말이양스.{FC01}근데 왠지 국적 불명인 사람뿐이양스!?{FC03}"}
{"id": 6849, "ko": "우끼이잇!{FC03}"}
{"id": 6850, "ko": "읏, 원숭이?{FC03}"}
{"id": 6851, "ko": "코후우{FC03}"}
{"id": 6852, "ko": "뭐야, 이 팀은!?{FC03}"}
{"id": 6853, "ko": "우끼잇끼잇.{FC03}"}
{"id": 6854, "ko": "어서 와라, {FFE8:0285}에.{FC03}"}
{"id": 6855, "ko": "아, 난 통역 존이랑께.{FC03}"}
{"id": 6856, "ko": "우끼끼잇!{FC03}"}
{"id": 6857, "ko": "보다시피 이 팀은 여러 나라에서 선수를\n긁어모은 혼성 팀이랑께.{FC03}"}
{"id": 6858, "ko": "우웃우웃!{FC03}"}
{"id": 6859, "ko": "왜 이렇게 극단적인 구성이냐면\n이 팀은 이번 시즌 해체가 정해져서랑께.{FC03}"}
{"id": 6860, "ko": "그런 팀에 일부러 올 선수는\n이 나라엔 당연히 없당께.{FC01}그래서 전 세계에서 선수를 긁어모았당께.{FC03}"}
{"id": 6861, "ko": "그런 얘기 못 들었어요?{FC03}"}
{"id": 6862, "ko": "그걸 먼저 말하면 아무도 안 오잖당께.{FC03}"}
{"id": 6863, "ko": "그럼 사기잖아요!{FC03}"}
{"id": 6864, "ko": "싫으면 돌아가도 상관없당께!{FC03}"}
{"id": 6865, "ko": "참고로 전 세계에서 모였으니께,{FC03}"}
{"id": 6866, "ko": "말 안 통하는 선수가 많당께{FC01}"}
{"id": 6867, "ko": "아, 감독도 그런데{FFE8:02D3}{FC01}"}
{"id": 6868, "ko": "말이 안 통할 땐 나한테 말하랑께.{FC03}"}
{"id": 6869, "ko": "만약 결과를 내면 새 스폰서가 생겨서\n팀이 존속할 수도 있을지 모른당께.{FC03}"}
{"id": 6870, "ko": "반대로 성적이 나쁘면 내년은커녕 시즌 도중에도\n팀이 없어져 버린당께.{FC03}"}
{"id": 6871, "ko": "모두 자기 장래를 위해, 또 이 팀을 위해\n전력으로 임해 주랑께.{FC03}"}
{"id": 6872, "ko": "그리고 깜빡했는데, 이 팀엔\n연습 시설 같은 건 없당께.{FC03}"}
{"id": 6873, "ko": "우낏!!!{FC03}"}
{"id": 6874, "ko": "실전에서 실력 닦으랑께.\n무조건 이겨. 끝!{FC03}"}
