{"id": 3237, "ko": "그래, 내가 먼저 청하는 거니까\n"}
{"id": 3238, "ko": "고마워하라고!{FC03}"}
{"id": 3239, "ko": "그렇게까지 말하지 마.{FC01}"}
{"id": 3240, "ko": "같이 할 맘이 싹 식었어.{FC03}"}
{"id": 3241, "ko": "그럼 약속한 거다.{FC03}"}
{"id": 3242, "ko": "안 돼, 난 바빠.{FC03}"}
{"id": 3243, "ko": "정말 안 돼?{FC03}"}
{"id": 3244, "ko": "그래, 안 된다니까!{FC03}"}
{"id": 3245, "ko": "알았어!{FC01}"}
{"id": 3246, "ko": "다시는 같이 연습 안 할 거야!{FC01}"}
{"id": 3247, "ko": "바이바이!{FC03}"}
{"id": 3248, "ko": "약속한 날인데 폭우가 쏟아지네.{FC03}{F12F}뭐, 일단 가 볼까.{FC03}"}
{"id": 3249, "ko": "하이!{F010}.{FC03}"}
{"id": 3250, "ko": "이 날씨라 이제 안 올 줄 알았어.{FC03}"}
{"id": 3251, "ko": "흠뻑 젖었잖아!{FC03}"}
{"id": 3252, "ko": "제대로 와 줬구나.{FC03}{F121}고마워!{FC03}"}
{"id": 3253, "ko": "약속했으니 당연히 오지!{FC03}빗속에서 혼자 연습했어?{FC03}"}
{"id": 3254, "ko": "응, 꽤 기분 좋거든!{FC03}"}
{"id": 3255, "ko": "수건 있으니까 이걸로 닦아!{FC03}"}
{"id": 3256, "ko": "왜 빗속에서까지 연습하는 거야!{FC01}감기 걸리잖아!{FC03}"}
{"id": 3257, "ko": "오늘은 할머니 기일이야.{FC03}{F12F}매년 할머니 기일엔 함께 연습하고 있어.{FC03}"}
{"id": 3258, "ko": "그, 그렇구나{FFE8:02D3}.{FC03}"}
{"id": 3259, "ko": "그래서 할머니한테 {F010}를\n소개하고 싶어서 오늘 불렀어.{FC03}"}
{"id": 3260, "ko": "의 할머니, 나 보고 이상한 친구라고\n"}
{"id": 3261, "ko": "한탄하시는 거 아냐?{FC03}"}
{"id": 3262, "ko": "걱정 마, 친구라곤 안 해.{FC01}편리한 연습 도구?{FC03}"}
{"id": 3263, "ko": "뭐, 뭐라고!{FC03}"}
{"id": 3264, "ko": "아하핫!{FC03}{FC29}"}
{"id": 3265, "ko": "뭐, 됐다.{FC03}"}
{"id": 3266, "ko": "오늘 와 줘서 정말 고마워.{FC03}"}
{"id": 3267, "ko": "나도 즐거웠어.{FC01}그럼 또 보자.{FC03}"}
{"id": 3268, "ko": "응{FFE8:02D3}, 또{FFE8:02D3}봐.{FC03}"}
{"id": 3269, "ko": ", 안색 나빠.{FC03}"}
{"id": 3270, "ko": "이봐, 열이 엄청나잖아!{FC03}{F127}빗속에서 무리하니까 그렇지.{FC03}"}
{"id": 3271, "ko": "괜찮아, 끄떡없{FFE8:02D3}어.{FC03}"}
{"id": 3272, "ko": "아무튼 병원 가자.{FC03}"}
{"id": 3273, "ko": "링거 놓을 테니 잠시 누워 있어요.{FC03}"}
{"id": 3274, "ko": "미안, 번거롭게 해서{FFE8:02D3}.{FC03}"}
{"id": 3275, "ko": "무슨 소리야.{FC01}이 정도는 당연하지!{FC03}"}
{"id": 3276, "ko": "고마워.{FC03}{F035}{FC29}"}
{"id": 3277, "ko": "우리 할머니, 엄청 강한 프로\n테니스 선수였어.{FC03}하지만 결혼하면서 은퇴하셨대.{FC03}행복하셨지만 계속할 걸 그랬다는\n후회도 조금은 있으셨나 봐.{FC03}그 꿈은 반드시 내가 이룰 거야!{FC03}{F121}난 절대 후회할 짓은 안 해!{FC03}"}
{"id": 3278, "ko": "어라?{FFE8:02B0}? 왠지 분위기가 다른데?{FC03}"}
{"id": 3279, "ko": "앗, 앞머리가 짧아졌나?{FC03}{F134}안녕, {FFE8:02B0}!{FC03}"}
{"id": 3280, "ko": "하이!{F010}{FC03}{F125}직접 앞머리를 자르다가 그만 너무 잘랐어.{FC03}{F12F}역시 이상하지?{FC03}"}
{"id": 3281, "ko": "웃겨"}
{"id": 3282, "ko": "괜찮아"}
{"id": 3283, "ko": "귀여워"}
{"id": 3284, "ko": "이상해"}
{"id": 3285, "ko": "아하하, 너무 잘랐네.{FC01}"}
{"id": 3286, "ko": "완전 웃겨!{FC03}"}
{"id": 3287, "ko": "뭐, 뭐라고!{FC01}"}
{"id": 3288, "ko": "바보!!{FC03}"}
{"id": 3289, "ko": "아니, 전혀 괜찮은데.{FC01}"}
{"id": 3290, "ko": "별로 안 변했는데.{FC03}"}
{"id": 3291, "ko": "그래?{FC01}"}
{"id": 3292, "ko": "꽤 싹둑 잘랐는데.{FC03}"}
{"id": 3293, "ko": "내 머리 모양엔 별 관심 없나 보네!{FC03}"}
{"id": 3294, "ko": "엄청 귀여운데?{FC03}"}
{"id": 3295, "ko": "누가 봐도 너무 잘랐잖아?{FC03}"}
{"id": 3296, "ko": "아니, 진짜 엄청 귀여워.{FC03}"}
{"id": 3297, "ko": "그, 그런가?{FC03}"}
{"id": 3298, "ko": "띄워 줘도 소용없어?{FC03}"}
{"id": 3299, "ko": "음, 전이 더 나았어.{FC01}"}
{"id": 3300, "ko": "좀 이상하네.{FC03}"}
{"id": 3301, "ko": "그렇구나, 역시 이상하나{FFE8:02D3}.{FC01}"}
{"id": 3302, "ko": "실패해 버렸네.{FC03}"}
{"id": 3303, "ko": "앗, {FFE8:02B0}{FC03}"}
{"id": 3304, "ko": "어? 나?{FC03}{F125}응, 그런데.{FC03}{F12F}글쎄, 딱히 정해 둔 사람은 없는데.{FC03}{F125}갑자기 그런 말을 해도{FFE8:02D3}.{FC03}"}
{"id": 3305, "ko": "야, {FFE8:02B0}{FC03}"}
{"id": 3306, "ko": "그럼 또 봐.{FC03}"}
{"id": 3307, "ko": "있잖아, 지금 훈련하러 가?{FC01}나도 같이 갈게!{FC03}"}
{"id": 3308, "ko": "어?{FC01}응, 근데 괜찮아?{FC01}뭔가 중요한 얘기 중이던데.{FC03}"}
{"id": 3309, "ko": "응, 괜찮아 괜찮아.{FC03}{F125}별로 중요한 얘기 아냐.{FC03}"}
{"id": 3310, "ko": "그래?{FC03}{F134}그럼 가자.{FC03}{F003}{FFE8:02B0}와 함께 훈련했다."}
{"id": 3311, "ko": "잠깐 얘기 좀 들어 줄래?{FC03}"}
{"id": 3312, "ko": "응, 좋아. 무슨 일이야?{FC03}"}
{"id": 3313, "ko": "어제 반 친구한테 고백받았어.{FC03}"}
{"id": 3314, "ko": "엇!?{FC03}"}
{"id": 3315, "ko": "그 사람, 나처럼 프로 테니스 선수야.{FC01}나 이런 거에 익숙하지 않아서.{FC03}"}
{"id": 3316, "ko": "생각은?{FC03}"}
{"id": 3317, "ko": "좋다고 봐"}
{"id": 3318, "ko": "절대안돼"}
{"id": 3319, "ko": "괜찮지 않아?{FC01}"}
{"id": 3320, "ko": "좋은 경험이 될 테니 사귀어 봐!{FC03}"}
{"id": 3321, "ko": "그, 그런{FFE8:02D3}가?{FC03}"}
{"id": 3322, "ko": "응, 생각해 볼게.{FFE8:02D3}고마워.{FC03}"}
{"id": 3323, "ko": "그, 그런 녀석이랑 사귀면 안돼!{FC03}"}
{"id": 3324, "ko": "어, 그걸로 왜 화를 내?{FC03}"}
{"id": 3325, "ko": "이유고 뭐고 없어.{FC01}"}
{"id": 3326, "ko": "절대 안돼!{FC03}"}
{"id": 3327, "ko": "멋대로 화내고 무슨 억지야!{FC03}"}
{"id": 3328, "ko": "그런 녀석 말고 나랑 사귀어 줘!{FC03}"}
{"id": 3329, "ko": "무, 무슨 소리야!?{FC03}"}
{"id": 3330, "ko": "노, 농담 아니야.{FC01}"}
{"id": 3331, "ko": ", 나랑 사귀자!{FC03}"}
{"id": 3332, "ko": "그렇게 갑자기 말해도{FFE8:02D3}.{FC03}"}
{"id": 3333, "ko": "대답은 좀 기다려.{FC03}"}
{"id": 3334, "ko": "고백해 버렸다{FFE8:02D3}.{FC03}"}
{"id": 3335, "ko": "저번 얘기 말인데, 결국 거절했어.{FC03}"}
{"id": 3336, "ko": "앗, 그렇구나!{FC03}"}
{"id": 3337, "ko": "응.{FC01}"}
{"id": 3338, "ko": "난 그 사람한테 전혀 관심이 없거든.{FC01}"}
{"id": 3339, "ko": "그런데 사귀는 건 이상하다고 깨달았어.{FC03}"}
{"id": 3340, "ko": "과연, 맞는 말이야.{FC03}"}
{"id": 3341, "ko": "그래서 내 마음을 정리하다 보니 깨달았어.{FC03}"}
{"id": 3342, "ko": "나, 좋아하는 사람 있어{FC03}"}
{"id": 3343, "ko": "근데 그 사람은 나한테 전혀 관심 없나 봐.{FC03}"}
{"id": 3344, "ko": "설마, 나?{FC03}"}
{"id": 3345, "ko": "그래서 포기하고 테니스에 전념할래.{FC03}"}
{"id": 3346, "ko": "자, 잠깐만.{FC03}"}
{"id": 3347, "ko": "이제 앞으론 못 만나.{FC03}"}
{"id": 3348, "ko": "저, 저기{FFE8:02D3}.{FC03}"}
{"id": 3349, "ko": "그동안 고마웠어.{FC01}"}
{"id": 3350, "ko": "안녕, {F010}.{FC03}"}
{"id": 3351, "ko": "그 후 {FFE8:02B0}와는 만나지 못했다.{FC03}"}
{"id": 3352, "ko": "저기{FFE8:02D3}, 저번 일 말야.{FC03}"}
{"id": 3353, "ko": "정말 나라도 괜찮아?{FC03}"}
{"id": 3354, "ko": "무, 무슨 소리야!{FC01}"}
{"id": 3355, "ko": "태어나서 줄곧 난 너를 찾고 있었어!{FC03}"}
{"id": 3356, "ko": "자, 그건 너무 오버잖아!{FC03}"}
{"id": 3357, "ko": "나 그런 건 계속 피해 왔어.{FC03}"}
{"id": 3358, "ko": "테니스 하는 데 필요 없다고.{FC03}"}
{"id": 3359, "ko": "그래도{FFE8:02D3}.{FC03}"}
{"id": 3360, "ko": "모두 버려도 {F010}와 있고 싶어!{FC03}"}
{"id": 3361, "ko": "가 연인이 됐다{FC05}{FC03}"}
{"id": 3362, "ko": ", 이 시간에 웬일이야?{FC03}"}
{"id": 3363, "ko": "왠지 멍해 보이는데.{FC03}"}
{"id": 3364, "ko": "아, {F010}.{FC03}{F12F}아니, 별거 아냐.{FC03}"}
{"id": 3365, "ko": "상담해줌"}
{"id": 3366, "ko": "바이바이"}
{"id": 3367, "ko": "그래?{FC03}"}
{"id": 3368, "ko": "뭔가 신경 쓰이는 거 있지 않아?{FC03}"}
{"id": 3369, "ko": "뭐든 상담해 줄게!{FC03}"}
{"id": 3370, "ko": "근데 괜찮아. 정말 별거 아냐.{FC03}"}
{"id": 3371, "ko": "는 아무것도 말해 주지 않았다.\n{F003}대체 뭘 고민하는 걸까?{FC03}"}
{"id": 3372, "ko": "그래, 그럼 또 봐!{FC03}"}
{"id": 3373, "ko": "응, 바이바이.{FC03}{F003}{FFE8:02B0}는 말없이 떠났다.\n{F003}역시 기운이 없는 것 같다.{FC03}"}
{"id": 3374, "ko": "저기, 잠깐 상담해도 돼?{FC03}"}
{"id": 3375, "ko": "응, 물론이지.{FC03}"}
{"id": 3376, "ko": "나 투어에 복귀할까 하는데.{FC01}{F125}{F010}는 어떻게 생각해?{FC03}"}
{"id": 3377, "ko": "대학 그만두는 거야?{FC03}"}
{"id": 3378, "ko": "응, 그렇겠지.{FC03}"}
{"id": 3379, "ko": "복귀 권유"}
{"id": 3380, "ko": "대학 계속"}
{"id": 3381, "ko": "의 꿈은 테니스로 {FC07}그랜드슬램{FC05}\n"}
{"id": 3382, "ko": "달성하는 거잖아?{FFE8:037B}{FC03}"}
{"id": 3383, "ko": "응{FFE8:02D3}.{FC03}"}
{"id": 3384, "ko": "그럼 망설일 거 없잖아.{FC03}"}
{"id": 3385, "ko": "근데 복귀하면 {F010}와 함께\n"}
{"id": 3386, "ko": "있을 수 없게 되잖아.{FC03}"}
{"id": 3387, "ko": "그런 걸로 꿈을 포기하면 안 돼.{FC01}"}
{"id": 3388, "ko": "나중에 후회할 거야.{FC03}"}
{"id": 3389, "ko": "그치만 나 {F010}와{FFE8:02D3},\n"}
{"id": 3390, "ko": "같이 있고 싶어.{FC03}"}
{"id": 3391, "ko": "그래도 복귀해"}
{"id": 3392, "ko": "역시 붙잡는다"}
{"id": 3393, "ko": "다시 못 만나는 것도 아니잖아.\n"}
{"id": 3394, "ko": "서로 꿈을 좇자!{FC03}"}
{"id": 3395, "ko": "응, 알았어.{FC03}"}
{"id": 3396, "ko": "대신 {F010}도 다음 시즌엔\n"}
{"id": 3397, "ko": "꼭 메이저로 올라가!{FC03}"}
{"id": 3398, "ko": "그래, 약속할게!{FC03}"}
{"id": 3399, "ko": "는 대학을 휴학하고\n{F003}투어에 복귀하기로 했다.{FC03}"}
{"id": 3400, "ko": "나도 {FFE8:02B0}와 헤어지긴 싫어.{FC03}"}
{"id": 3401, "ko": "계속 함께 있자.{FC03}"}
{"id": 3402, "ko": "는 대학에 남기로 했다.{FC03}"}
{"id": 3403, "ko": "대학을 졸업하고도 테니스는 계속할 수 있잖아.\n"}
{"id": 3404, "ko": "지금은 여러 공부를 하는 게 좋을 거야.{FC03}"}
{"id": 3405, "ko": "{F010}도 그렇게 생각해?{FC03}"}
{"id": 3406, "ko": "코치도 그렇게 말했어.{FC03}"}
{"id": 3407, "ko": "하지만 지금만 가능한"}
{"id": 3408, "ko": "일이 있지 않을까 싶어서.{FC03}"}
{"id": 3409, "ko": "역시 복귀해야 해"}
{"id": 3410, "ko": "그래도 붙잡는다"}
{"id": 3411, "ko": "그래, 확실히 {FC06}지금{FC05}밖에 못 하는 게 있지!{FC03}"}
{"id": 3412, "ko": "그럼 역시 꿈을 좇아야 해.{FC03}"}
{"id": 3413, "ko": "공부는 하려고 하면 언제든 할 수 있으니까.{FC03}"}
{"id": 3414, "ko": "한테 묻길 잘했다.{FC03}"}
{"id": 3415, "ko": "하지만 {FFE8:02B0}와 한동안 못 보겠네.{FC03}"}
{"id": 3416, "ko": "그래도 보고 싶으면 날아올게!{FC03}"}
{"id": 3417, "ko": "그래, 기다릴게.{FC03}"}
{"id": 3418, "ko": "를 못 보는 것도 괴롭고"}
{"id": 3419, "ko": "난 남았으면 해.{FC03}"}
{"id": 3420, "ko": "그렇지{FFE8:02D3}{FC01}나도 {F010}와 같이 있고 싶고.{FC03}"}
{"id": 3421, "ko": "응, 남을게!{FC03}"}
{"id": 3422, "ko": "내 고집을 들어줘서 {FFE8:02B0}는\n{F003}대학에 남기로 했다.{FC03}"}
{"id": 3423, "ko": "방금 대학에 휴학계 내고 왔어.{FC03}"}
{"id": 3424, "ko": "그래, 쓸쓸해지겠네.{FC03}"}
{"id": 3425, "ko": "그런 얼굴 하지 마{FC01}"}
{"id": 3426, "ko": "또 마음이 흔들리잖아.{FC03}"}
{"id": 3427, "ko": "아, 미안 미안.{FC03}"}
{"id": 3428, "ko": "투어엔 언제 떠나?{FC03}"}
{"id": 3429, "ko": "미국에서 다음 주부터 큰 대회가 열려.{FC01}"}
{"id": 3430, "ko": "그래서 당장 출발해야 해.{FC03}"}
{"id": 3431, "ko": "복귀하자마자 우승이면 멋지잖아?{FC01}"}
{"id": 3432, "ko": "힘낼게!{FC03}"}
{"id": 3433, "ko": "그래, 응원할게.{FC01}"}
{"id": 3434, "ko": "힘내!{FC03}"}
{"id": 3435, "ko": "나 정말 가도 되는 거지?{FC03}"}
{"id": 3436, "ko": "무슨 소리야!{FC01}"}
{"id": 3437, "ko": "할머니랑 한 약속이 있잖아!{FC03}"}
{"id": 3438, "ko": "와 한동안 못 보는구나{FFE8:02D3}.{FC01}{F003}안 말리길 잘한 걸까?{FC03}"}
{"id": 3439, "ko": "역시 말렸어야 했나?{FC03}{F124}아니, 그럴 리 없어.{FC01}{FFE8:02B0}도 꿈을 좇고 있는 거야.{FC03}"}
