{"id": 7350, "ko": "음{FFE8:02D3}{FC03}"}
{"id": 7351, "ko": "골드{FFE8:02D3}{FC03}"}
{"id": 7352, "ko": "자선단체{FFE8:02D3}{FC03}"}
{"id": 7353, "ko": "휴{FFE8:02D3}{FC03}{FC29}"}
{"id": 7354, "ko": "자선단체 피해구제기금!{FC03}"}
{"id": 7355, "ko": "피해구제기금!?{FC03}{F124}으음{FFE8:02D3}{FC03}"}
{"id": 7356, "ko": "두~둥?{FC03}"}
{"id": 7357, "ko": "구단주는 돈을 잃은 충격으로\n입원해 버렸다더군.{FC03}"}
{"id": 7358, "ko": "괜찮양스?{FC03}"}
{"id": 7359, "ko": "의식은 있지만 돈~ 돈~ 헛소리만 해서\n제대로 얘기할 상태가 아니야.{FC01}{F124}구단주가 없으니 전력 보강도 못 해.{FC03}{F125}주력 투수도 없이 앞으로 어떻게\n싸워 나가야 하나.{FC03}"}
{"id": 7360, "ko": "맞다!{FC01}{F123}그만둔 {FFE8:026B}랑 {FFE8:02A6}씨에게\n"}
{"id": 7361, "ko": "다시 돌아와 달라고 해요.{FC03}"}
{"id": 7362, "ko": "구단이 일방적으로 잘랐네.{FC01}돌아와 줄 것 같진 않은데{FFE8:02D3}{FC03}"}
{"id": 7363, "ko": "{FFE8:026B}는 당신 아들이잖아요?{FC03}"}
{"id": 7364, "ko": "자식은 부모 말에 반발하는 법이지.{FC01}{F125}특히 그런 일로 잘린 뒤라면.{FC03}"}
{"id": 7365, "ko": "그럼 제가 설득해 보겠습니다.{FC03}"}
{"id": 7366, "ko": "자네가?{FC03}"}
{"id": 7367, "ko": "이래 봬도 그 녀석과는 라이벌 같은 사이예요.{FC01}{F123}제가 부탁하면 분명 와 줄 것 같은\n기분이 들어요{FC03}"}
{"id": 7368, "ko": "으음.{FC01}{F123}확실히 자네 말이라면 귀를 기울일지도\n모르겠군.{FC03}"}
{"id": 7369, "ko": "그럼?{FC03}"}
{"id": 7370, "ko": "부탁하네. 꼭 아들을 설득해 주게.{FC03}"}
{"id": 7371, "ko": "맡겨 주세요!!{FC03}"}
{"id": 7372, "ko": "팀에 돌아오라고 {FFE8:026B}를 설득하러 갔다가\n{F003}{FFE8:02A1}를 소개받았다.{FC03}"}
{"id": 7373, "ko": "어디, 분명 이 근처인데{FFE8:02D3}{FC03}"}
{"id": 7374, "ko": "우리 집 앞에서 뭐 해?{FC03}"}
{"id": 7375, "ko": "뭐야, 여기가 너희 집이야?{FC03}"}
{"id": 7376, "ko": "어때, 들렀다 갈래?{FC03}"}
{"id": 7377, "ko": "원래 그럴 생각이었어.{FC03}"}
{"id": 7378, "ko": "그렇게 된 거야.{FC03}"}
{"id": 7379, "ko": "그렇군, 어쩐지 요즘 아버지가 기운 없더라{FC03}"}
{"id": 7380, "ko": "부탁이야, 모두를 위해 돌아와 줄래?{FC03}"}
{"id": 7381, "ko": "미안하다.{FC01}"}
{"id": 7382, "ko": "지금의 난 못 해.{FC03}"}
{"id": 7383, "ko": "왜 그러는데!{FC03}"}
{"id": 7384, "ko": "쓸데없는 고집은 버려!{FC01}네 아버지를 돕는 일이기도 하다고!{FC03}"}
{"id": 7385, "ko": "고집 부리는 게 아니야!{FC01}{F125}못 하는 거야.{FC03}"}
{"id": 7386, "ko": "그러니까 왜?{FC03}"}
{"id": 7387, "ko": "동료를 위해{FFE8:02D3}{FC03}"}
{"id": 7388, "ko": "그 동료를 돕자는 거잖아?{FC03}"}
{"id": 7389, "ko": "너희 말고.{FC01}{F124}내 새 동료를 위해서다.{FC03}"}
{"id": 7390, "ko": "새 동료?{FC03}"}
{"id": 7391, "ko": "실은 난 이미 {FFE8:027E}에\n"}
{"id": 7392, "ko": "입단해 버렸어.{FC03}{FC29}"}
{"id": 7393, "ko": "뭐라고!?{FC03}"}
{"id": 7394, "ko": "미안해 아버지{FFE8:02D3}{FC03}"}
{"id": 7395, "ko": "의 GM이 {FFE8:02A6}씨와\n"}
{"id": 7396, "ko": "아는 사이라서 둘이 테스트를 받으러 갔더니\n둘 다 합격해 버려서{FFE8:02D3}{FC03}"}
{"id": 7397, "ko": "도 {FFE8:027E}에 갔나?{FC03}"}
{"id": 7398, "ko": "그게, {FFE8:0286}가\n이렇게 될 줄은{FFE8:02D3}{FC03}"}
{"id": 7399, "ko": "아, 아니, 그렇다면 어쩔 수 없지.{FC01}{F124}{FC08}스타{FC05} 가문으로서 당연한 선택이야!{FC03}{F123}{FFE8:026B}!{FC01}"}
{"id": 7400, "ko": "짧게 있었어도 절대 동료를 배신하지 마라.{FC01}{F123}그러면 아버지가 용서 안 한다!{FC03}"}
{"id": 7401, "ko": "알고 있어.{FC01}"}
{"id": 7402, "ko": "그 말, 100번은 들었다고.{FC03}"}
{"id": 7403, "ko": "저어, 바쁘신 중에 죄송하지만{FFE8:02D3}{F113}{FC03}"}
{"id": 7404, "ko": "아, 미안하네.{FC01}{F123}하지만 들은 대로야.{FC01}{F124}아들 스카우트는 포기해 주게.{FC03}"}
{"id": 7405, "ko": "아버지.{FC03}"}
{"id": 7406, "ko": "투수라면 짚이는 녀석이 있어.{FC03}"}
{"id": 7407, "ko": "정말?{FC03}"}
{"id": 7408, "ko": "그래, 우리 팀에 이상한 일본인이 있는데\n그 친구가 여기 와 있대.{FC03}"}
{"id": 7409, "ko": "듣자 하니 지난달까지 일본 프로야구\n현역이었다더라.{FC03}"}
{"id": 7410, "ko": "지난달 현역?{FC03}"}
{"id": 7411, "ko": "게다가 에이스에 슬러거래.{FC03}"}
{"id": 7412, "ko": "에이스에 슬러거?!{FC03}"}
{"id": 7413, "ko": "그런 녀석이 바로 우리 팀에 와 줄까?{FC03}"}
{"id": 7414, "ko": "그게, {FFE8:0286}의\n열성 팬이래.{FC03}"}
{"id": 7415, "ko": "이름은?{FC03}"}
{"id": 7416, "ko": "다이치 우미조라{FC05}.{FC01}아직 귀국 안 했을 거야{FC03}"}
{"id": 7417, "ko": "고마워, {FFE8:026B}!{FC03}"}
{"id": 7418, "ko": "결국 난 도움이 안 됐네.{FC03}"}
{"id": 7419, "ko": "그렇지 않네, {F010}.{FC03}"}
{"id": 7420, "ko": "는 일본인.{FC01}"}
{"id": 7421, "ko": "내가 일본어를 할 것 같나?{FC03}"}
{"id": 7422, "ko": "아!?{FC01}{F135}꼭 같이 가게 해 줘요!{FC03}"}
{"id": 7423, "ko": "하하하, 부탁하는 건 날세.{FC03}"}
{"id": 7424, "ko": "레스토랑에서 {FFE8:02A1}를 권유{FFE8:02D3}{FC03}"}
{"id": 7425, "ko": "드디어 {FFE8:02A1}를 만나는군.{FC03}{FC29}"}
{"id": 7426, "ko": "어떤 선수일지 기대되네요.{FC03}{FC29}"}
{"id": 7427, "ko": "안녕하세요!{FC03}"}
{"id": 7428, "ko": "오우!{FC01}아 유 {FC08}다위치{FC05}?{FC03}"}
{"id": 7429, "ko": "죄송해요.{F10D}{FC01}영어 몰라요.{FC03}"}
{"id": 7430, "ko": "나이스 투 미 추!{FC01}아임 제너럴 매니저 아브갸라{FFE8:02D3}{FC03}"}
{"id": 7431, "ko": "전혀 모르겠어요!{FC03}"}
{"id": 7432, "ko": "아~이{FC21}"}
{"id": 7433, "ko": "아~임,{FC21}"}
{"id": 7434, "ko": "지~{FC21}"}
{"id": 7435, "ko": "에~엠!{FC03}"}
{"id": 7436, "ko": "그러니까 모른다고 했잖아!{FC03}"}
{"id": 7437, "ko": "헬프{FFE8:02D3}{FC03}"}
{"id": 7438, "ko": "저기, {FFE8:02A1}.{FC03}"}
{"id": 7439, "ko": "뭐야, 일본어 하잖아!{FC03}"}
{"id": 7440, "ko": "아니, 일본어 하는 건 나뿐이고\nGM은 못 하거든.{FC03}"}
{"id": 7441, "ko": "어, 이 사람 GM이야?{FC01}"}
{"id": 7442, "ko": "웨이터인 줄 알았어.{FC03}"}
{"id": 7443, "ko": "그래서 그 녀석한테만은 절대 질 수 없잖아!{FC01}그래서 프로야구 관두고 온 거지.{FC03}"}
{"id": 7444, "ko": "헤에, 대단한 결단이네.{FC03}"}
{"id": 7445, "ko": "그랬더니 동경하던 {FFE8:0286}에서\n"}
{"id": 7446, "ko": "오퍼가 왔어.{FC01}{F121}나 완전 운 좋다고~.{FC03}"}
{"id": 7447, "ko": "응, 나도 너 같은 인재를 바로\n찾아서 정말 운이 좋아.{FC03}"}
{"id": 7448, "ko": "그러고 보니 그 녀석, 너랑 꼭 닮았어.{FC01}형제 아냐?{FC03}"}
{"id": 7449, "ko": "아니, 형제는 없어.{FC03}"}
{"id": 7450, "ko": "이봐, 아까부터 무슨 얘길 하나?{FC01}{F123}전혀 협상하는 걸로 안 보이는데?{FC03}"}
{"id": 7451, "ko": "이미 계약한 셈이에요.{FC03}"}
{"id": 7452, "ko": "방금 GM이 뭐라고 했어?{FC03}"}
{"id": 7453, "ko": "아니, 계약할지 말지 걱정하고 있어.{FC03}"}
{"id": 7454, "ko": "계약?{FC01}{F121}물론 OK지!{FC03}"}
{"id": 7455, "ko": "앗싸!{FC03}"}
{"id": 7456, "ko": "조건이 두 개 있어.{FC03}"}
{"id": 7457, "ko": "조건?{F10D}{FC03}"}
{"id": 7458, "ko": "내 유니폼을 바로 준비해 줘.{FC01}{F124}상어 좋아하는 사람한테 그 유니폼은\n못 참을 매력이 있거든.{FC03}{F121}오늘부터라도 입고 자고 싶어.{FC03}"}
{"id": 7459, "ko": "하아, 그 정도야 쉬운데{FFE8:02D3}{FC03}"}
{"id": 7460, "ko": "그럼 다른 조건은?{FC03}"}
{"id": 7461, "ko": "난 상어가 최강의 생물이라고 믿어.{FC01}{F124}이 팀이 상어 이름에 부끄럽지 않은지\n확인하기 전엔 입단 못 해.{FC03}"}
{"id": 7462, "ko": "그 말은?{FC03}"}
{"id": 7463, "ko": "딱 잘라 나랑 승부해!{FC01}{F124}네가 이기면 들어가지.{FC03}"}
{"id": 7464, "ko": "좋아, 해 보자!{FC01}"}
{"id": 7465, "ko": "그 조건, 받아들이지!{FC03}"}
{"id": 7466, "ko": "이봐, 갑자기 험악한 분위기인데 괜찮나?{FC03}"}
{"id": 7467, "ko": "아뇨, 결투 신청을 받아 버렸어요.{FC03}"}
{"id": 7468, "ko": "으헉~!?{FC03}"}
{"id": 7469, "ko": "어떠냐!{FC01}{F124}이게 본고장 미국에서 단련한 실력이다!{FC03}"}
{"id": 7470, "ko": "과연, 상어를 논할 만하군.{FC03}{F121}너희 동료가 되지!{FC03}"}
{"id": 7471, "ko": "앞으로 잘 부탁해,{FC21}"}
{"id": 7472, "ko": "가짜 라이벌!{FC03}"}
{"id": 7473, "ko": "미안하지만 완전 기대 이하야.{FC01}{F120}이 얘긴 없던 걸로 하지.{FC01}"}
{"id": 7474, "ko": "그래서 {FFE8:02A1}는 언제 와 준다고?{FC03}"}
{"id": 7475, "ko": "아뇨, 내일 귀국할 것 같아요.{FC03}"}
{"id": 7476, "ko": "뭐야, 짐은 일본에서 부쳐 달라면 될 텐데.{FC03}"}
{"id": 7477, "ko": "아뇨, 그게 아니라{FFE8:02D3}{FC01}{F147}죄송합니다.{FC03}"}
{"id": 7478, "ko": "오늘은 일본에서 온 신입 소개다{FC03}"}
{"id": 7479, "ko": "다이치{FC05}예요.{FC01}{F121}잘 부탁해요!{FC03}"}
{"id": 7480, "ko": "다시 잘 부탁해{FC03}"}
{"id": 7481, "ko": "나는 {FFE8:02A0}양스!{FC01}"}
{"id": 7482, "ko": "잘 부탁하양스!{FC03}"}
{"id": 7483, "ko": "{FFE8:02A0}도 일본인이구나!{FC01}"}
{"id": 7484, "ko": "나 영어 전혀 못 하니까 왠지 안심된다.{FC03}"}
{"id": 7485, "ko": "나야말로 요즘 일본 애니에 대해\n이것저것 가르쳐 주양스!{FC03}"}
{"id": 7486, "ko": "애, 애니?{FC03}"}
{"id": 7487, "ko": "이, 이봐, 일본어로 멋대로 떠들지{FFE8:02D3}{FC01}"}
{"id": 7488, "ko": "다른 팀원한테 소개가 안 되잖나{FC03}"}
{"id": 7489, "ko": "요즘 일본인은 상투 같은 거 안 해요.{FC03}"}
{"id": 7490, "ko": ", 옆에서 통역해{FC03}"}
{"id": 7491, "ko": "아, 네.{FC03}"}
{"id": 7492, "ko": "그럼 {FFE8:02A1}는 내일이라도 로스터에 등록\n"}
{"id": 7493, "ko": "건데 괜찮겠나?{FC03}"}
{"id": 7494, "ko": "너 언제든 경기에 나갈 수 있게 해 두래.{FC03}"}
{"id": 7495, "ko": "네, 맡겨 주세요!!{FC03}"}
{"id": 7496, "ko": "음, 좋은 대답이다{FC03}"}
{"id": 7497, "ko": "와 메이저에 가자고 맹세했다.{FC03}"}
{"id": 7498, "ko": "어, {FFE8:026B} 아냐?{FC01}"}
{"id": 7499, "ko": "우연이네?{FC03}"}
{"id": 7500, "ko": "이런 데서 뭐 하고 있어?{FC03}"}
{"id": 7501, "ko": "씨를 기다리고 있어.{FC03}"}
{"id": 7502, "ko": "어?{FC01}{FFE8:0279}씨라니 그 스카우트?{FC03}"}
{"id": 7503, "ko": "뭐야, {F010}도 아는 사이였어?{FC03}"}
{"id": 7504, "ko": "그래서 무슨 용건?{FC03}"}
{"id": 7505, "ko": "그게, 소개하고 싶은 내 팬이 있다든가\n어쩌고{FFE8:02D3}{FC03}"}
{"id": 7506, "ko": "나도 잘 모르지만 메이저행을 약속받은\n처지라 매정하게 거절도 못 하겠고.{FC03}"}
{"id": 7507, "ko": "하하하, 성가신 얘기네.{FC03}{F139}{F139}아니 잠깐!{FC03}{F132}너, 메이저행이 결정된 거야?{FC03}"}
{"id": 7508, "ko": "뭐야, 아버지가 말 안 했어?{FC03}"}
{"id": 7509, "ko": "아무것도 못 들었어~.{FC03}"}
{"id": 7510, "ko": "뭐, 너랑은 상관없는 얘기니까.{FC03}"}
{"id": 7511, "ko": "뭐라고!!{FC01}{F13B}난 너보다 먼저 메이저{FFE8:02D3}{FC01}"}
{"id": 7512, "ko": "에 갈 생각이었는데{FFE8:02D3}{FC03}"}
{"id": 7513, "ko": "적어도 같이 메이저에 가고 싶었어.{FC03}"}
{"id": 7514, "ko": "너도 아직 메이저에 못 간다고 정해진\n건 아니잖아?{FC03}"}
{"id": 7515, "ko": "그건 그렇지만, 아마 가망은 희박할 거야{FC03}"}
{"id": 7516, "ko": "방법이 하나 있어{FC03}"}
{"id": 7517, "ko": "확실히 메이저 가는 방법이야{FC03}"}
{"id": 7518, "ko": "실은 다음 너희와 경기는 {FFE8:0279}씨와\n"}
{"id": 7519, "ko": "내 희망 구단 GM이 관전하기로 돼 있어.{FC03}{F123}그 경기에서 날 이겨!{FC01}그러면 분명 {FFE8:0279}씨가 널 주목할 거야.{FC03}"}
{"id": 7520, "ko": "어쨌든 메이저행이 정해진 나를\n이긴 거니까.{FC03}"}
{"id": 7521, "ko": "그러니 약속해!{FC03}{F123}다음 대결에서 최고의 경기를 하자고!{FC01}{F121}그리고 같이 메이저에 가자!{FC03}"}
