{"id": 1124, "ko": "방금 내 공연 봤지?{FC03}"}
{"id": 1125, "ko": "뭐, 뭐.{FC03}"}
{"id": 1126, "ko": "그럼 관람료 내.{FC03}"}
{"id": 1127, "ko": "낸다"}
{"id": 1128, "ko": "안 낸다"}
{"id": 1129, "ko": "아니, 그런 건 억지로\n내는 게 아니잖아.{FC03}"}
{"id": 1130, "ko": "부탁해.{FC01}동생 학비를 벌어야 해.{FC03}"}
{"id": 1131, "ko": "요즘 그런 뻔한 거짓말에 누가 속냐.{FC03}"}
{"id": 1132, "ko": "진짜야.{FC03}"}
{"id": 1133, "ko": "진짜라 해도 네 동생 따위\n내 알 바 아니야.{FC03}"}
{"id": 1134, "ko": "아, 언니랑 {F010}씨다!{FC03}"}
{"id": 1135, "ko": "어머, 이 사람이 {FFE8:029D}의 언니야?{F113}{FC03}"}
{"id": 1136, "ko": "뭐야, {FFE8:029D}와 아는 사이야?{FC01}"}
{"id": 1137, "ko": "그럼 손님은 아니네.{FC03}"}
{"id": 1138, "ko": "썩 꺼져, 이 쫀쫀한 놈아!!!{FC03}"}
{"id": 1139, "ko": "언니, 그만해!!{FC01}이 사람 되게 친절해.{FC03}"}
{"id": 1140, "ko": "넌 속고 있는 거야.{FC03}"}
{"id": 1141, "ko": "이 남자가, 너 따위 어떻게 되든\n알 바 아니라고 했단 말이야!!{FC03}"}
{"id": 1142, "ko": "네? 정말이에요?{FC01}{F12A}너, 너무해!!{FC03}"}
{"id": 1143, "ko": "아, 아냐\n오해야!!{FC03}"}
{"id": 1144, "ko": "남자가 두말하지 마!!!{FC03}"}
{"id": 1145, "ko": "네, 네{FFE8:02D3}{FC03}"}
{"id": 1146, "ko": "에이~.{FC01}{F12F}그래도 좀 재밌었으니 됐나{FFE8:02D3}{FC03}"}
{"id": 1147, "ko": "어머, 이런 공연에 진짜 돈을 내다니\n통이 크네.{FC01}{F121}마음에 들었어.{FC03}"}
{"id": 1148, "ko": "그럼 이번엔 브리지 하면서 목을\n180도 돌려 줄게.{FC01}{F121}잘 봐!{FC03}"}
{"id": 1149, "ko": "아니, 그런 징그러운 건 사양이야.{F113}{FC03}"}
{"id": 1150, "ko": "간다.{FC03}"}
{"id": 1151, "ko": "네!!{FC03}"}
{"id": 1152, "ko": "끄으윽읍!{FC03}"}
{"id": 1153, "ko": "왜 그래?{FC03}"}
{"id": 1154, "ko": "허리~\n{FC21}"}
{"id": 1155, "ko": "목이~{FC03}"}
{"id": 1156, "ko": "구, 구급차 부를까?{F113}{FC03}"}
{"id": 1157, "ko": "자, 잠깐만!!{FC03}{F120}{F123}그러면 내가 창피하잖아.{FC01}"}
{"id": 1158, "ko": "치료비도 들고.{FC03}"}
{"id": 1159, "ko": "그, 그래.{FC01}{F129}그럼 난 이만{FFE8:02D3}{FC03}"}
{"id": 1160, "ko": "기다리라니까!{FC03}"}
{"id": 1161, "ko": "나랑 상관없잖아.{FC03}"}
{"id": 1162, "ko": "네가 봐서 이렇게 된 거야.{FC01}{F13B}책임져!!{FC03}"}
{"id": 1163, "ko": "어, 억지다{FFE8:02D3}{FC03}"}
{"id": 1164, "ko": "일단 나를 집까지 옮겨.{FC03}"}
{"id": 1165, "ko": "오, 의외로 멀쩡한 집에 사네.{FC03}"}
{"id": 1166, "ko": "어떤 집을 상상했는데?{FC03}"}
{"id": 1167, "ko": "어?{FC01}{F126}저 벽 사진, {FFE8:029D} 아냐?{FC03}"}
{"id": 1168, "ko": "너, {FFE8:029D}의 친구야?{FC03}"}
{"id": 1169, "ko": "아니, 친구라기보다 그냥 아는 사이야.{FC03}"}
{"id": 1170, "ko": "그랬구나.{FC03}{F120}{FC29}"}
{"id": 1171, "ko": "근데 왜 {FFE8:029D} 사진이 여기에?{FC03}"}
{"id": 1172, "ko": "후후, 사실 그거 나야.{FC03}{FC29}"}
{"id": 1173, "ko": "난 인격이 바뀌어.{FC03}{F121}월수금은 소녀같이 가련한 {FFE8:029D}.{FC01}"}
{"id": 1174, "ko": "화목토는 어른의 매력인 {FFE8:029D}.{FC03}"}
{"id": 1175, "ko": "그, 그럼 일요일은?{FC03}"}
{"id": 1176, "ko": "일요일엔 우리도 모르는\n제3의 {FFE8:029D}가 몸을 지배해.{FC03}"}
{"id": 1177, "ko": "그 애가 뭘 하는지는 모르지만,\n정신 차리면 늘 손에 피가{FFE8:02D3}{FC03}"}
{"id": 1178, "ko": "근데 얼굴이 전혀 다르잖아?{FC01}"}
{"id": 1179, "ko": "사진이 젊어{FFE8:02D3}{FC03}{F120}{FC29}"}
{"id": 1180, "ko": "실례야!{FC03}"}
{"id": 1181, "ko": "다녀왔어~{FC03}"}
{"id": 1182, "ko": "아, {F010}씨!!{FC03}"}
{"id": 1183, "ko": "언니라고?{FC01}{F128}{F112}속였구나!{FC03}"}
{"id": 1184, "ko": "우후후, 미안미안.{FC01}널 보고 있으면 왠지 놀리고 싶어져서.{FC03}"}
{"id": 1185, "ko": "난 {FFE8:029D}의 언니 {FC08}브렛 존스{FC05}야.{FC01}"}
{"id": 1186, "ko": "다들 {FFE8:029E}라고 부르지만.{FC03}"}
{"id": 1187, "ko": "응, 나 총알처럼 금방 폭발하거든.{FC03}"}
{"id": 1188, "ko": "그렇네{FFE8:02D3}{FC03}"}
{"id": 1189, "ko": "뭐라고 했어?{FC03}"}
{"id": 1190, "ko": "아뇨{FFE8:02D3}{FC03}"}
{"id": 1191, "ko": "근데 언니가 이렇게 일찍 오다니,\n무슨 일 있어?{FC03}"}
{"id": 1192, "ko": "몸이랑 목을 좀 삐었어.{FC01}{F124}{F010}가 앙코르만 안 했으면\n이런 일은{FFE8:02D3}{FC03}"}
{"id": 1193, "ko": "누가 앙코르를 했다고!{FC01}{F124}그런 징그러운 걸{FFE8:02D3}{FC03}"}
{"id": 1194, "ko": "툭하면 치지 마!{FC03}"}
{"id": 1195, "ko": "미안, 버릇이야.{FC03}"}
{"id": 1196, "ko": "무슨 버릇이야!{FC03}"}
{"id": 1197, "ko": "아, {F010}씨예요!{FC03}"}
{"id": 1198, "ko": "너 또 혼자 음악 듣고 있었어?{FC03}"}
{"id": 1199, "ko": "네, 곧 언니도 여기 올 건데요{FFE8:02D3}{FC03}"}
{"id": 1200, "ko": "흐응.{FC03}"}
{"id": 1201, "ko": "아, 기다려 주세요!{FC03}"}
{"id": 1202, "ko": "오늘은 {FFE8:029D} 얘기 안 들어요?{FC03}"}
{"id": 1203, "ko": "곧 네 언니 온다며?{FC03}"}
{"id": 1204, "ko": "맞아요.{FC01}{F121}{FFE8:029D}는 언니한테 {F010}씨를\n"}
{"id": 1205, "ko": "소개할 거예요.{FC03}"}
{"id": 1206, "ko": "아니, 됐어.{FC01}남친도 아니고.{FC03}"}
{"id": 1207, "ko": "그치만 {F010}씨는\n{FFE8:029D}의 소중한 친구예요!{FC03}"}
{"id": 1208, "ko": "딱히 너랑 친구 된 적 없거든.{FC03}"}
{"id": 1209, "ko": "너, 너무해요.{FC03}"}
{"id": 1210, "ko": "엇?{FC03}"}
{"id": 1211, "ko": "이놈!!{FC03}"}
{"id": 1212, "ko": "미안해.{FC01}난 또 변태가 내 동생을\n괴롭히는 줄 알고{FFE8:02D3}{FC03}"}
{"id": 1213, "ko": "하아{FFE8:02D3}{FC03}"}
{"id": 1214, "ko": "뭐, 오해도 풀렸으니 전 이만 갈게요.{FC03}"}
{"id": 1215, "ko": "잠깐만!{FC03}{F123}큰일이야, 너 피 나잖아.{FC03}"}
{"id": 1216, "ko": "당신이 그랬잖아?{FC03}"}
{"id": 1217, "ko": "이대로 보낼 순 없어.{FC03}"}
{"id": 1218, "ko": "없어요!{FC03}"}
{"id": 1219, "ko": "우리 집에서 치료할 테니 와.{FC03}"}
{"id": 1220, "ko": "와요!{FC03}"}
{"id": 1221, "ko": "간다"}
{"id": 1222, "ko": "안 간다"}
{"id": 1223, "ko": "뭐, 괜찮긴 한데{FFE8:02D3}{F113}{FC03}"}
{"id": 1224, "ko": "아니, 사양할게.{FC03}"}
{"id": 1225, "ko": "됐으니까 와!{FC03}"}
{"id": 1226, "ko": "그럼 갈게요{FFE8:02D3}{F113}{FC03}"}
{"id": 1227, "ko": "어머, 착한 애잖아.{FC03}"}
{"id": 1228, "ko": "여기가 집이야.{FC03}"}
{"id": 1229, "ko": "역시 전 여기서 돌아갈게요.{FC03}"}
{"id": 1230, "ko": "역시 나같이 멋진 남자를 갑자기\n집에 데려오면 부모님도 놀라시잖아?{FC03}"}
{"id": 1231, "ko": "멋진 건 둘째치고, 우리 부모님은 둘 다\n돈 벌러 가서 한동안 안 오셔.{FC03}"}
{"id": 1232, "ko": "씨는 쓸데없는\n걱정 안 해도 돼요!{FC03}"}
{"id": 1233, "ko": "왠지 거미줄에 끌려 들어가는\n나방 같은 기분{FFE8:02D3}{F113}{FC03}{FC29}"}
{"id": 1234, "ko": "오, 꽤 괜찮은 방이네.{FC03}"}
{"id": 1235, "ko": "응, 대출만 없으면.{FC01}{F120}그래서 너 뭐 하러 왔어?{FC03}"}
{"id": 1236, "ko": "뭐 하러라니, 네가 날 다치게 해서\n억지로 끌고 왔잖아?{FC03}"}
{"id": 1237, "ko": "어머, 그랬지.{FC01}{F12F}미안미안.{FC01}{F124}당장 {FC07}빨간약{FC05} 발라 줄게.{FFE8:036E}{FC03}"}
{"id": 1238, "ko": "빠, 빨간약?{F113}{FC03}"}
{"id": 1239, "ko": "금방 올 테니 동생 건드리지 마.{FC03}"}
{"id": 1240, "ko": "쓸데없는 걱정 마.{FC03}"}
{"id": 1241, "ko": "저기, 빨간약이라던데,\n너희 언니 몇 살이야?{FC03}"}
{"id": 1242, "ko": "숙녀 나이를 묻는 건 영국 신사 실격이에요.{FC03}"}
{"id": 1243, "ko": "난 영국 신사 아닌데.{FC03}"}
{"id": 1244, "ko": "는 영국 신사가 좋아요!{FC03}"}
{"id": 1245, "ko": "아, 네{FFE8:02D3}{FC03}"}
{"id": 1246, "ko": "찾았다, 빨간약.{FC01}이거 바르면 상처가 나아.{FC01}잔뜩 있으니 한 병 가져가.{FC03}"}
{"id": 1247, "ko": "아뇨, 이제 나았으니 됐어요.{FC03}"}
{"id": 1248, "ko": "이놈!\n남자가 사양하긴.{FC03}{F145}차린 밥상 안 먹음 남자 수치랬어.{FC03}"}
{"id": 1249, "ko": "뜻이 전혀 다르거든.{FC03}"}
{"id": 1250, "ko": "어머, 진짜 벌써 나았네.{FC03}"}
{"id": 1251, "ko": "그러니까 말했잖아?{FC03}"}
{"id": 1252, "ko": "감히 나한테 헛수고를 시켜!!{FC03}"}
{"id": 1253, "ko": "아, 또 때렸네.{FC03}"}
{"id": 1254, "ko": "이제 가도 될까요{FFE8:02D3}{FC03}"}
{"id": 1255, "ko": "어, {F010}잖아!{FC03}"}
{"id": 1256, "ko": "헉, {FFE8:029E}!!{FC03}"}
{"id": 1257, "ko": "헉이 뭐야, 실례잖아!!{FC03}"}
{"id": 1258, "ko": "힉.{FC03}"}
{"id": 1259, "ko": "뭐 해?{FC03}"}
{"id": 1260, "ko": "또 맞는 줄 알고.{FC03}"}
{"id": 1261, "ko": "그렇게 자주 안 때리거든.{FC01}{F145}근데 네 머리는 확실히 때리기 좋네.{FC03}"}
{"id": 1262, "ko": "무슨 머리야!{FC03}"}
{"id": 1263, "ko": "너 여자한테 손 올린 적 없지?{FC03}"}
{"id": 1264, "ko": "우후, 그런 착한 남자가 내 타입야.{F10F}{FC03}"}
{"id": 1265, "ko": "어?{FC01}{F129}그, 그거 고맙네.{FC03}"}
{"id": 1266, "ko": "얘, 뭘 빨개지고 그래.{FC03}"}
{"id": 1267, "ko": "그, 그야 네가 이상한 말 해서{FFE8:02D3}{FC03}"}
{"id": 1268, "ko": "그런데 동생이랑은 무슨 사이야?{FC03}"}
{"id": 1269, "ko": "뭐, 거리에서 말 걸었더니 어느새\n아는 사이가 됐달까.{FC03}"}
{"id": 1270, "ko": "누가 먼저 말 걸었어?{FC03}"}
{"id": 1271, "ko": "그야 내가 먼저지?{FC03}"}
{"id": 1272, "ko": "흐응, 네게 그런 용기가 있구나.{FC03}"}
{"id": 1273, "ko": "그, 그런 거 아니야.{FC03}{F125}그냥 그때 {FFE8:029D}가 울고 있어서.{FC03}"}
{"id": 1274, "ko": "무슨 소리?{FC03}"}
{"id": 1275, "ko": "마음속 개한테 밥을 준다나 뭐라나{FFE8:02D3}\n"}
{"id": 1276, "ko": "잘 모르겠지만.{FC03}"}
{"id": 1277, "ko": "그래{FFE8:02D3}\n"}
{"id": 1278, "ko": "그 애, 아직도{FFE8:02D3}{FC03}"}
{"id": 1279, "ko": "응?{FC01}뭐라고 했어?{FC03}"}
{"id": 1280, "ko": "아무것도 아냐{FFE8:02D3}{FC03}"}
{"id": 1281, "ko": "그보다, 괜찮으면 또 동생 만나 줄래?{FC03}"}
{"id": 1282, "ko": "좋아"}
{"id": 1283, "ko": "싫어"}
{"id": 1284, "ko": "벼, 별로 상관없어{FC03}"}
{"id": 1285, "ko": "앗싸, 살았다.{FC01}{F125}그 애, 남자랑은 인연이 없거든.{FC01}{F12F}너 같은 애라도 분명 공부가 될 거야.{FC03}"}
{"id": 1286, "ko": "난 연습 상대냐{FFE8:02D3}{F113}{FC03}"}
{"id": 1287, "ko": "미안하지만 내 타입 아니라서.{FC03}"}
{"id": 1288, "ko": "누가 네 타입 물어봤어?{FC01}{F125}하아, 남자들은 왜 이렇게 단순할까.{FC01}{F123}게다가 자신감 과잉이야.{FC03}"}
{"id": 1289, "ko": "아까 내가 네 타입이라고 하지 않았어?{FC03}"}
{"id": 1290, "ko": "어?{FC01}내, 내가 그런 말 했나?{FC03}"}
{"id": 1291, "ko": "그러니까 왜 때리냐고!{FC03}"}
{"id": 1292, "ko": "그치만 창피한걸{FFE8:02D3}{F10F}{FC03}"}
{"id": 1293, "ko": "안녕하세요!!{FC03}{F12B}문이 활짝 열렸어요~{FC01}"}
{"id": 1294, "ko": "위험하다고요~{FC03}{F129}아무도 없나?{FC03}"}
{"id": 1295, "ko": "생각한다"}
{"id": 1296, "ko": "간다"}
{"id": 1297, "ko": "멋대로 들어갈 순 없고, 돌아갈까?{FC03}"}
{"id": 1298, "ko": "이건 사건 냄새가 나는데{FFE8:02D3}{FC03}{FC29}"}
{"id": 1299, "ko": "큰일이다!{FC01}{F123}{FFE8:029D}네 위험해!!{FC03}"}
{"id": 1300, "ko": "야, {FFE8:029D}!{FC01}"}
{"id": 1301, "ko": "어디 있어!!{FC03}"}
{"id": 1302, "ko": "앗!{FC03}{F000}{F121}뭐야, {F010}구나{FFE8:02D3}{FC03}"}
{"id": 1303, "ko": "안녕, {FFE8:029D}의{FFE8:02D3}{FC03}"}
{"id": 1304, "ko": "근데 왜 네가 집 안에 있어!!{FC03}"}
