{"id": 7186, "ko": "응.{FC01}"}
{"id": 7187, "ko": "아마 낮겠지.{FC03}"}
{"id": 7188, "ko": "그럼 누가 위인지 승부하자!!{FC03}"}
{"id": 7189, "ko": "어떠냐 후배!{FC03}"}
{"id": 7190, "ko": "흥, 생각보다 제법이군.{FC03}"}
{"id": 7191, "ko": "뭐야, 그 건방진 말투.{FC03}"}
{"id": 7192, "ko": "내가 위니까.{FC03}"}
{"id": 7193, "ko": "방금 이긴 건 나지?{FC03}"}
{"id": 7194, "ko": "약하네 선배.{FC03}"}
{"id": 7195, "ko": "한 번 더다!!{FC03}"}
{"id": 7196, "ko": "아니, 더 해 봤자 의미 없어.{FC01}{F120}미안하지만 다음에 하자, 선배.{FC03}"}
{"id": 7197, "ko": "꽤 열심히 하는군, {FFE8:026B}.{FC03}"}
{"id": 7198, "ko": "아, 당신인가.{FC03}"}
{"id": 7199, "ko": "다, 당신?{FC03}"}
{"id": 7200, "ko": "당신이 위아래를 따지니까\n이름만 부르는 건 관둘게.{FC03}"}
{"id": 7201, "ko": "뭐, 막 부르는 것보단 낫나.{FC03}"}
{"id": 7202, "ko": "하지만 내가 메이저 간 뒤엔\n다시 막 부를 거야.{FC03}"}
{"id": 7203, "ko": "잠깐.{FC01}{F123}왜 네가 나보다 먼저 메이저에\n가는 걸로 돼 있는 거야?{FC03}"}
{"id": 7204, "ko": "실력으로 보면 그렇게밖에 생각 안 되잖아.{FC03}"}
{"id": 7205, "ko": "크으!{FC03}{F001}{F13B}그렇게 나온다면 승부다!!{FC03}"}
{"id": 7206, "ko": "어떠냐!!{FC03}"}
{"id": 7207, "ko": "흥, 생각대로 제법이군.{FC01}{F124}하지만 먼저 메이저 가는 게 나라는 건\n변함없어.{FC03}"}
{"id": 7208, "ko": "뭐야, 아직도!?{FC03}"}
{"id": 7209, "ko": "흥, 역시 생각만큼은 아니었군.{FC03}"}
{"id": 7210, "ko": "뭐라고!{FC01}{F13B}이렇게 된 이상 철저히 연습해서\n반드시 너보다 먼저 메이저 가 주마!{FC03}"}
{"id": 7211, "ko": "하하하, 기대할게.{FC03}"}
{"id": 7212, "ko": "훗, 역시군, {FFE8:026B}.{FC03}"}
{"id": 7213, "ko": "그 피칭에 더해 그 타격까지!{FC01}나와 {FC07}로테이션{FC05}을 짤 만한 인재다.{FFE8:038B}{FC03}"}
{"id": 7214, "ko": "그거 고맙네{FFE8:02D3}{FC03}"}
{"id": 7215, "ko": "너라면 나를 라이벌이라 불러도 좋다.{FC03}"}
{"id": 7216, "ko": "라이벌?{FC01}"}
{"id": 7217, "ko": "당신은 내 라이벌 같은 게 아냐.{FC03}"}
{"id": 7218, "ko": "뭐, 무슨 뜻이지?{FC01}{F123}내 실력이 모자라다는 건가?{FC03}"}
{"id": 7219, "ko": "확실히 선수 능력은 지금 나보다 위겠지.{FC01}{F124}하지만 당신은 이 팀의 부품일 뿐이잖아.{FC03}"}
{"id": 7220, "ko": "그렇다.{FC03}"}
{"id": 7221, "ko": "그럼 난 부품 따윈 상대 안 해.{FC01}{F124}난 의지도 근성도 있는 산 인간이니까.{FC03}{F123}가자, {F010}!{FC03}"}
{"id": 7222, "ko": "네~에.{FC03}{F001}{F13B}그러니까 이름 막 부르지 마!!{FC03}"}
{"id": 7223, "ko": "뭐지 이 쓸쓸함은{FFE8:02D3}{FC03}"}
{"id": 7224, "ko": "내가 틀렸다는 건가{FFE8:02D3}{FC03}"}
{"id": 7225, "ko": "아니야.{FC01}{F123}{FFE8:0273}님은 절대적이다.{FC01}"}
{"id": 7226, "ko": "그러니 난 부품이어야만 해!{FC03}"}
{"id": 7227, "ko": "와 {FFE8:026B}가 {FFE8:02A2} 일로\n{F003}싸웠다.{FC03}"}
{"id": 7228, "ko": "왜 그래 {FFE8:026B}.{FC03}"}
{"id": 7229, "ko": "아저씨군{FFE8:02D3}{FC01}"}
{"id": 7230, "ko": "요즘 {FFE8:02A6}씨가 좀 신경 쓰여서.{FC03}"}
{"id": 7231, "ko": "그 사람 갑자기 잘려서, 돈 같은 거\n괜찮을까 싶어서{FFE8:02D3}{FC03}{F120}{FC29}"}
{"id": 7232, "ko": "방금 돈이라 했나?{FC03}"}
{"id": 7233, "ko": "이, 이거 {FFE8:0273}씨.{FC03}"}
{"id": 7234, "ko": "오오, 신입 {FFE8:026B} 아닌가?{FC01}"}
{"id": 7235, "ko": "열심히 하나.{FC03}"}
{"id": 7236, "ko": "네, 근데{FFE8:02D3}{FC03}"}
{"id": 7237, "ko": "음~?{FC01}{F121}뭔가 할 말이 있나?{FC03}"}
{"id": 7238, "ko": "씨를 왜 자르신 겁니까?{FC03}"}
{"id": 7239, "ko": "이놈, {FFE8:026B}!!{FC03}"}
{"id": 7240, "ko": "됐네 됐어.{FC01}{F124}{FFE8:02A6}는 좋은 포수였지.{FC03}"}
{"id": 7241, "ko": "하지만 그놈이 날 구두쇠 영감이라고\n했다지 않나?{FC03}{F12F}그래서 싯싯싯, 잘라 버린 거야.{FC03}"}
{"id": 7242, "ko": "그것뿐?{FC03}"}
{"id": 7243, "ko": "으응?{FC03}"}
{"id": 7244, "ko": "겨우 그런 일로 그 사람을 자른 거야!?{FC01}"}
{"id": 7245, "ko": "당신이 구제불능 구두쇠 영감인 건\n사실이잖아?{FC03}"}
{"id": 7246, "ko": "그, 그만해, {FFE8:026B}!!{F113}{FC03}"}
{"id": 7247, "ko": "호오, 여기도 분수 모르는\n쓰레기가 있었군{FFE8:02D3}{FC03}"}
{"id": 7248, "ko": "날 자르겠다면 바라던 바야.{FC01}{F121}구두쇠 영감!{FC03}"}
{"id": 7249, "ko": "그럼 너, 해고다.{FC03}"}
{"id": 7250, "ko": "기다려 주세요! 구단주님!{FC03}"}
{"id": 7251, "ko": "시끄럽다!{FC01}나한테 대드는 놈은 해고다!{FC03}"}
{"id": 7252, "ko": ", 너 무슨 짓을!!{FC03}"}
{"id": 7253, "ko": "의 명령으로 {FFE8:026B} 해고.{FC03}"}
{"id": 7254, "ko": "안타까운 소식이 있다.{FC01}{F124}{FFE8:02A2}에 이어 {FFE8:026B}가 잘렸다.{FC03}"}
{"id": 7255, "ko": "왜죠!?{FC03}"}
{"id": 7256, "ko": ", 너 또 일러바쳤냐!?{FC03}"}
{"id": 7257, "ko": "아냐 난 아무것도{FFE8:02D3}{FC03}"}
{"id": 7258, "ko": "이번엔 {FFE8:026C} 무관해.{FC01}"}
{"id": 7259, "ko": "이건 그 녀석의 실수,\n{F125}아니, 녀석이 고른 길이야.{FC03}"}
{"id": 7260, "ko": "하, 하지만 그 녀석이 없으면\n또 로테이션을 못 짜게 돼.{FC03}"}
{"id": 7261, "ko": "헹, 말은 잘하네!{FC01}{F121}선수는 부품이라며?{FC01}{F124}부품은 또 보충하면 그만 아냐?{FC03}"}
{"id": 7262, "ko": "아니야.{FC01}{F125}그, 그 녀석은{FFE8:02D3}{FC21}"}
{"id": 7263, "ko": "나와 달리{FFE8:02D3}{FC03}"}
{"id": 7264, "ko": "이제 와서!?{FC03}"}
{"id": 7265, "ko": "만이 아니야.{FC01}"}
{"id": 7266, "ko": "사람은 모두 부품이 아니야.{FC01}"}
{"id": 7267, "ko": "너도 포함해서.{FC03}"}
{"id": 7268, "ko": "큭.{FC03}"}
{"id": 7269, "ko": "녀석, 나한테 말도 없냐{FFE8:02D3}{FC03}"}
{"id": 7270, "ko": "메이저에서 기다린다{FFE8:02D3}{FC03}"}
{"id": 7271, "ko": "그렇게 전해 달라고 하더군.{FC03}"}
{"id": 7272, "ko": "훗, 그 녀석답네{FFE8:02D3}{FC03}"}
{"id": 7273, "ko": "어디까지 기가 센 거냐, 바보{FFE8:02D3}{FC03}"}
{"id": 7274, "ko": "유능한 사람만 빠져나가는군.{FC01}"}
{"id": 7275, "ko": "이 구단 경영은 뭔가 이상해.{FC03}"}
{"id": 7276, "ko": "어쩔 수 없양스.{FC01}{F125}우린 그냥 부품이니까양스.{FC03}"}
{"id": 7277, "ko": "때문에 {FFE8:026C}가\n{F003}이상해졌다.{FC03}"}
{"id": 7278, "ko": "음~ 무슨 일인가{FC03}"}
{"id": 7279, "ko": "오늘로 이곳 단장을 그만두겠습니다.{FC03}"}
{"id": 7280, "ko": "효효, {FFE8:026B} 일 때문인가?{FC01}"}
{"id": 7281, "ko": "지금 그만두면 곤란하지.{FC03}"}
{"id": 7282, "ko": "좋아, 연봉을 2배로 주지.{FC01}{F121}어떤가.{FC01}마음이 바뀌었나?{FC03}"}
{"id": 7283, "ko": "흥, 당신은 아무것도 몰라.{FC01}{F124}다신 볼 일 없을 겁니다.{FC03}"}
{"id": 7284, "ko": "도망가나?{FC03}"}
{"id": 7285, "ko": "자넬 믿고 따라온 선수들을 두고\n도망가느냐고 묻는 게야.{FC03}"}
{"id": 7286, "ko": "그 녀석들도 언젠가 고장 난 부품처럼\n버릴 생각이잖아!!{FC03}"}
{"id": 7287, "ko": "그렇지 않아.{FC01}{F121}예를 들어 {FFE8:026C}처럼 쓸모 있는 놈은 안 잘라.{FC03}"}
{"id": 7288, "ko": "그럼 {FFE8:026C}가 못 던지게 되면?{FC03}"}
{"id": 7289, "ko": "물론 해고지.{FC01}{F125}불량품은 바로 교환해야 하니까.{FC03}"}
{"id": 7290, "ko": "뭐야, {FFE8:026C}, 있었나{FFE8:02D3}{FC03}"}
{"id": 7291, "ko": "방금 말{FFE8:02D3}{FC21}"}
{"id": 7292, "ko": "거짓말이죠{FFE8:02D3}{FC03}"}
{"id": 7293, "ko": "후횻횻횻.{FC01}{F120}아무리 스파이라지만 쓸데없는 것까지\n엿듣다니.{FC03}"}
{"id": 7294, "ko": "당신은 의지할 곳 없는 날 여기까지{FFE8:02D3}{FC03}"}
{"id": 7295, "ko": "효횻횻.{FC01}"}
{"id": 7296, "ko": "걱정 마라.{FC01}{F124}널 해고하진 않아.{FC03}"}
{"id": 7297, "ko": "그, 그렇죠.{FC03}"}
{"id": 7298, "ko": "그래, 너한텐 시간과 공을 꽤 들였거든.{FC03}"}
{"id": 7299, "ko": "그러니 소중히 써야지{FFE8:02D3}{FC01}{FC29}"}
{"id": 7300, "ko": "내가 손해니까.{FC03}"}
{"id": 7301, "ko": "그래.{FC01}{F123}손해야.{FC03}{F120}{FC29}"}
{"id": 7302, "ko": "저는{FFE8:02D3}{FC01}당신에게 손익뿐인 존재입니까?{FC01}"}
{"id": 7303, "ko": "난 당신을 아버지라 생각하고{FFE8:02D3}{FC03}"}
{"id": 7304, "ko": "응?{FC01}{F124}부모 자식이든 뭐든 결국 인간관계란\n손익으로 이뤄진 것 아닌가?{FC03}"}
{"id": 7305, "ko": "윽 머리가{FC03}"}
{"id": 7306, "ko": "윽,{F127}아아,{F126}머리가{F127}!{F127}{FC03}"}
{"id": 7307, "ko": "왜 그래!? 괜찮아!?{FC03}"}
{"id": 7308, "ko": "으{F124}아아{F125}아{F124}아{F125}아{F124}아{F125}아{F124}아!!!{FC03}"}
{"id": 7309, "ko": "여긴 어디예여?{F10D}{FC03}"}
{"id": 7310, "ko": "쳇.{FC01}고장 났나.{FC01}{F123}세뇌한 부품은 금방 고장 나!{FC03}{F124}{FFE8:029F}!{FC03}"}
{"id": 7311, "ko": "이놈을 폐기해라.{FC03}"}
{"id": 7312, "ko": "이쪽이다 쿵~.{FC03}"}
{"id": 7313, "ko": "당신이란 인간은!!{FC03}"}
{"id": 7314, "ko": "자네 후임이 정해질 때까지는 선수들을\n자르는 건 그만두지.{FC03}"}
{"id": 7315, "ko": "저는 이제{FFE8:02D3}{FC03}"}
{"id": 7316, "ko": "당장 그만둬도 된다네.{FC01}{F121}자넬 믿고 따라온 선수들을 배신하는\n셈이 되겠지만.{FC01}효횻횻.{FC03}"}
{"id": 7317, "ko": "큭.{FC03}"}
{"id": 7318, "ko": "의 실수로 {FFE8:0273}가 충격을 받고\n{F003}쓰러졌다.{FC03}"}
{"id": 7319, "ko": "단장, 요즘 {FFE8:026C}가 안 보이는데\n"}
{"id": 7320, "ko": "뭐 들은 거 있나{FC03}"}
{"id": 7321, "ko": "씨, 어떻게 된 걸까양스.{FC03}"}
{"id": 7322, "ko": "글쎄.{FC03}"}
{"id": 7323, "ko": "야, {FFE8:026A}.{FC03}"}
{"id": 7324, "ko": "뭡니까?{FC03}"}
{"id": 7325, "ko": "랑 {FFE8:026C}를 대신할 투수를\n"}
{"id": 7326, "ko": "내일까지 스카우트해 와.{FC03}"}
{"id": 7327, "ko": "그래도 갑자기는 무리예요.{FC03}"}
{"id": 7328, "ko": "준비금인가?{FC01}{F121}돈은 얼마든지 주지.{FC01}{F124}{FFE8:029F}, 트렁크 가져와.{FC03}"}
{"id": 7329, "ko": "알았다 쿵~.{FC03}"}
{"id": 7330, "ko": "어떤가, 대단하지.{FC01}{F121}이 안은 전부 돈다발이야.{FC03}{F120}{F121}우히, 우히히.{FC03}"}
{"id": 7331, "ko": "이런 걸로 어쩌라고요?{FC03}"}
{"id": 7332, "ko": "뭐?{FC01}아직 모자라다는 건가?{FC01}{F12F}자네도 욕심쟁이군.{FC03}"}
{"id": 7333, "ko": "모자란 건 당신 생각이죠.{FC03}{F120}{F124}실례하겠소!{FC03}"}
{"id": 7334, "ko": "뭐야, 저 녀석?{FC01}{F120}뭐 됐어.{FC01}{F121}그럼 감독!!{FC03}"}
{"id": 7335, "ko": "미안하지만 나도 사양.{FC03}"}
{"id": 7336, "ko": "크으!!{FC03}장기말 주제에 하나같이 대들기는!!{FC01}{F124}하아, 하아{FFE8:02D3}{FC01}"}
{"id": 7337, "ko": "후우 후우{FFE8:02D3}{FC03}"}
{"id": 7338, "ko": "피, 피곤해{FFE8:02D3}{FC03}"}
{"id": 7339, "ko": "야, {FFE8:029F}.{FC03}"}
{"id": 7340, "ko": "그 돈을 {FFE8:0273} 자선단체에 기부해!{FC03}"}
{"id": 7341, "ko": "님~!{FC03}"}
{"id": 7342, "ko": "오오, 꽤 빨랐군, {FFE8:029F}.{FC03}"}
{"id": 7343, "ko": "그 돈은 제대로 기부했나?{FC03}"}
{"id": 7344, "ko": "물론 기부했다 쿵~.{FC03}"}
{"id": 7345, "ko": "그런가{FFE8:02D3}{FC03}"}
{"id": 7346, "ko": "무슨 자선 단체에{FFE8:02D3}{FC03}"}
{"id": 7347, "ko": "무슨무슨이 뭐냐?{FC03}"}
{"id": 7348, "ko": "까먹었다 쿵~{FC03}"}
{"id": 7349, "ko": "그게 중요하단 말이야.{FC01}생각해 내!{FC03}"}
