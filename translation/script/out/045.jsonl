{"id": 8173, "ko": "네, 전 그에게 무척 기대하고 있죠.\n{FC20}"}
{"id": 8174, "ko": "가 팀에 입단했다.{FC03}"}
{"id": 8175, "ko": "전원 집합{FC03}"}
{"id": 8176, "ko": "응, 무슨 일이오?{FC03}"}
{"id": 8177, "ko": "뭐 간식이라도 있나?{FC01}{F121}난 뭔가 단 게 먹고 싶은데~.{FC01}{F122}말차 홀짝이며 양갱이라니, 운치 있잖아~.{FC03}"}
{"id": 8178, "ko": "오, 좋구려.{FC01}"}
{"id": 8179, "ko": "그런 걸 알다니\n{F010}군은 역시\n일본인이오.{FC03}"}
{"id": 8180, "ko": "응, 그럴지도…{FC20}"}
{"id": 8181, "ko": "좋아하는 건 꽤 기억나는데\n그 밖의 일은\n거의 아무것도 생각이 안 나…{FC03}"}
{"id": 8182, "ko": "허어, 그렇소…{FC20}"}
{"id": 8183, "ko": "그래도 조급해할 건 없소,\n천천히 떠올리면 되오.{FC03}"}
{"id": 8184, "ko": "응, 고마워, {FFE8:0298}군.{FC03}"}
{"id": 8185, "ko": "이봐, 거기 둘 못 들었나!{FC01}집합이다!{FC03}"}
{"id": 8186, "ko": "아, 네, 죄송해요!{FC03}"}
{"id": 8187, "ko": "다 모였네요, 그럼 소개할게요.{FC01}오늘부터 이 팀에서 함께 뛸 동료예요.{FC01}{F121}자, 자기소개해 주세요.{FC03}"}
{"id": 8188, "ko": "입니다, 잘 부탁합니다.{FC01}"}
{"id": 8189, "ko": "포지션은 투수입니다.{FC03}"}
{"id": 8190, "ko": "…그게 다{FC21}"}
{"id": 8191, "ko": "예요?{FC20}"}
{"id": 8192, "ko": "네, 뭐 문제라도?{FC03}"}
{"id": 8193, "ko": "아뇨, 그래도 개그라도 하나 해 주시면\n모두와 빨리 친해질 수 있을 텐데요.{FC03}"}
{"id": 8194, "ko": "공교롭게도 저는 친하게 지내려고\n이 팀에 온 게 아니라서요.{FC03}"}
{"id": 8195, "ko": "어머, 멋있네요…{FC20}"}
{"id": 8196, "ko": "그럼 그 태도에 맞는 결과를\n제대로 보여 주세요,\n기대하고 있을게요.{FC03}"}
{"id": 8197, "ko": "이상, 해산{FC03}{F120}{FC23}〇"}
{"id": 8198, "ko": "아, 맞다, 깜빡했네요.{FC01}{F010}와 {FFE8:0298} 둘은\n"}
{"id": 8199, "ko": "집합에 늦었으니 급료 깎을게요.{FC03}"}
{"id": 8200, "ko": "그런~…{FC20}"}
{"id": 8201, "ko": "이오~!{FC03}"}
{"id": 8202, "ko": "너무해~…{FC20}"}
{"id": 8203, "ko": "어머, 무슨 불만 있나요?{FC01}"}
{"id": 8204, "ko": "아뇨…"}
{"id": 8205, "ko": "왜 그깟 일로…"}
{"id": 8206, "ko": "인권 침해!"}
{"id": 8207, "ko": "아, 아뇨…{FC21}"}
{"id": 8208, "ko": "별로…{FC20}"}
{"id": 8209, "ko": "왜 그깟 일로\n"}
{"id": 8210, "ko": "급료를 깎여야 하는 거야!{FC03}"}
{"id": 8211, "ko": "그건 인권 침해야!{FC01}"}
{"id": 8212, "ko": "너무 횡포라 납득할 수 없잖아!{FC03}"}
{"id": 8213, "ko": "당신, 바보인가요?{FC01}"}
{"id": 8214, "ko": "내 맘에 안 드는 짓 한 사람은"}
{"id": 8215, "ko": "계속 급료를 깎겠다고\n"}
{"id": 8216, "ko": "처음에 분명히 말했죠?{FC03}"}
{"id": 8217, "ko": "아…{FC21}"}
{"id": 8218, "ko": "뭐, 그렇긴…{FC20}"}
{"id": 8219, "ko": "저는 이 팀의 GM이자 감독이에요.{FC01}"}
{"id": 8220, "ko": "제가 정한 건 이 팀에선 절대적이고\n"}
{"id": 8221, "ko": "완전히 틀림없는 거예요.{FC03}"}
{"id": 8222, "ko": "만약 저를 따를 수 없다면\n"}
{"id": 8223, "ko": "이 팀에서 뛰실 필요는 없어요.{FC01}"}
{"id": 8224, "ko": "이해하시겠죠, {F010}?{FC03}"}
{"id": 8225, "ko": "네.{FC20}"}
{"id": 8226, "ko": "알아주셨다면 됐어요.{FC01}"}
{"id": 8227, "ko": "하지만 방금 발언도 당연히 감봉이에요.{FC01}"}
{"id": 8228, "ko": "아시겠죠?{FC03}"}
{"id": 8229, "ko": "으으{FFE8:02D4}{FC03}"}
{"id": 8230, "ko": "그럼 연습 열심히 하세요.{FC01}"}
{"id": 8231, "ko": "젠장~…{FC20}"}
{"id": 8232, "ko": "그나저나 급료가 줄면 아프겠소~…{FC01}"}
{"id": 8233, "ko": "이렇게 되면 돈이 궁할 땐\n알바하는 수밖에 없겠소.{FC03}"}
{"id": 8234, "ko": "그렇네…{FC21}"}
{"id": 8235, "ko": "돈이 모자라면\n알바를 하자.{FC03}"}
{"id": 8236, "ko": "자, 샤워도 했으니 슬슬 돌아가자.{FC03}"}
{"id": 8237, "ko": "아, {F010}군도 가는 거요?{FC01}지금 어슬렁 놀러 가지 않겠소?{FC01}"}
{"id": 8238, "ko": "응, 좋아, 가자.{FC03}"}
{"id": 8239, "ko": "그런데 {FFE8:0298}군은 이 동네를 잘 알아?{FC03}"}
{"id": 8240, "ko": "도 여기 막 와서\n"}
{"id": 8241, "ko": "잘은 모르오.{FC03}"}
{"id": 8242, "ko": "그래, 그럼 앞으로도\n"}
{"id": 8243, "ko": "같이 여기저기 가 보자.{FC03}"}
{"id": 8244, "ko": "그럼 전화번호를 교환하겠소.{FC01}"}
{"id": 8245, "ko": "내킬 때 불러 주면 좋겠소.{FC03}"}
{"id": 8246, "ko": "미안, 오늘은 피곤해서 갈게.{FC01}"}
{"id": 8247, "ko": "다음에 가자.{FC03}"}
{"id": 8248, "ko": "그렇소…{FC20}"}
{"id": 8249, "ko": "어쩔 수 없구려.{FC01}"}
{"id": 8250, "ko": "그럼 전화번호를 알려 주겠소.{FC01}"}
{"id": 8251, "ko": "아, 김에 {FFE8:0298}가 아는 팀원 번호도\n"}
{"id": 8252, "ko": "알려 주겠소.{FC03}"}
{"id": 8253, "ko": "멋대로 알려 줘도 돼?{FC03}"}
{"id": 8254, "ko": "괜찮소.{FC01}팀 내 사람에게 알려 주는 건\n다들 허락했소.{FC03}"}
{"id": 8255, "ko": "그래, 그럼 알려 줘.{FC03}"}
{"id": 8256, "ko": "모두를 불러 같이 놀면서\n친해지면 좋겠소.{FC03}"}
{"id": 8257, "ko": "GM과 {FFE8:0297} 비서의 비밀 얘기를\n{F003}로커 뒤에서 듣고 말았다.{FC03}"}
{"id": 8258, "ko": "어때요, GM?\n올해는 클리어할 것 같나요?{FC03}"}
{"id": 8259, "ko": "글쎄요…{FC21}"}
{"id": 8260, "ko": "아직 잘은 모르겠지만\n클리어해 주지 않으면 곤란하죠, 역시.{FC01}{F125}정말 해마다 힘드네요…{FC01}그런데 왜 이렇게 된 걸까요?{FC03}"}
{"id": 8261, "ko": "어쩔 수 없습니다,\n당신은 저주받은 일족의 후손이니까요.{FC03}"}
{"id": 8262, "ko": "업보로군요…{FC20}"}
{"id": 8263, "ko": "덜컥!{FC05}{FC03}"}
{"id": 8264, "ko": "어머, {F010},\n계속 거기 있었나요?{FC03}"}
{"id": 8265, "ko": "아, 안녕하세요…{FC20}"}
{"id": 8266, "ko": "역시 방금 얘기 들었죠?{FC01}"}
{"id": 8267, "ko": "네…{FC21}"}
{"id": 8268, "ko": "들으려던 건 아니었는데.{FC20}"}
{"id": 8269, "ko": "어머, 솔직하네요{FC01}"}
{"id": 8270, "ko": "급료 좀 올려 줄게요.{FC03}"}
{"id": 8271, "ko": "그래서요, 들은 건 상관없어요.{FC01}"}
{"id": 8272, "ko": "언젠가 말하려던 거니까.{FC01}"}
{"id": 8273, "ko": "아뇨, 전 아무것도 못 들었어요.{FC01}"}
{"id": 8274, "ko": "특히 저주 얘기 같은…{FC21}"}
{"id": 8275, "ko": "괜찮아요, 들어도.{FC01}"}
{"id": 8276, "ko": "하지만 거짓말했으니 급료는 깎을게요.{FC01}"}
{"id": 8277, "ko": "묵비권인가요…{FC20}"}
{"id": 8278, "ko": "그것도 좋겠죠.{FC03}{FC22}"}
{"id": 8279, "ko": "뭐, 오늘은 기분이 아주 좋으니\n"}
{"id": 8280, "ko": "좋은 쪽으로 받아들이죠.{FC01}"}
{"id": 8281, "ko": "그러니 급료를 올리기로 할게요.{FC03}"}
{"id": 8282, "ko": "그런데 오늘은 기분이 별로예요.{FC01}"}
{"id": 8283, "ko": "그러니 급료는 깎을게요.{FC03}"}
{"id": 8284, "ko": "그래서, 들은 건 상관없어요.{FC01}"}
{"id": 8285, "ko": "그럼 뭔가 더 묻고 싶어졌나요?{FC03}"}
{"id": 8286, "ko": "…네,{FC21}"}
{"id": 8287, "ko": "그 저주라는 게 뭐죠?{FC03}"}
{"id": 8288, "ko": "그건요, 사실…{FC21}"}
{"id": 8289, "ko": "저, 해마다 저주 때문에\n한 살씩 나이 먹어서 언젠가 죽어요.{FC20}"}
{"id": 8290, "ko": "에에~~~!{FC21}"}
{"id": 8291, "ko": "그거 당연하잖아요?{FC03}"}
{"id": 8292, "ko": "태클 고마워요.{FC01}"}
{"id": 8293, "ko": "뭐, 농담은 그만두고 모처럼이니\n진짜 저주 얘기를 해 드리죠.{FC03}"}
{"id": 8294, "ko": "아뇨, 이제 됐어요, 왠지 바보 같아졌고\n저랑은 상관없을 것 같고.{FC03}"}
{"id": 8295, "ko": "어머, 정말 괜찮아요?{FC01}당신 과거와 관계있을지도 몰라요.{FC01}{F121}기억을 잃은 것도요.{FC03}"}
{"id": 8296, "ko": "거짓말 마세요!\n그런 일이 있을 리 없잖아요!{FC03}"}
{"id": 8297, "ko": "그럼 왜 그렇게 실력 없는 당신이\n우리 팀에 입단할 수 있었을까요?{FC01}연고도 신용도 전혀 없는데.{FC03}"}
{"id": 8298, "ko": "그, 그건…{FC21}"}
{"id": 8299, "ko": "아, 내가 잘생겨서다!{FC03}"}
{"id": 8300, "ko": "이제 됐어요.{FC01}"}
{"id": 8301, "ko": "가죠, {FFE8:0297}.{FC03}"}
{"id": 8302, "ko": "네, GM.{FC03}"}
{"id": 8303, "ko": "대체 뭐지…?{FC20}"}
{"id": 8304, "ko": "태그 연습{FC05}을 하게 되었다.{FC03}"}
{"id": 8305, "ko": "다 모인 것 같네요.{FC01}슬슬 신인도 익숙해졌을 테니\n오늘 연습부터 서로 마음 맞는 선수끼리\n{FC06}태그 연습{FC05}을 해 주셨으면 해요.{FC03}{FC29}"}
{"id": 8306, "ko": "연습 커맨드에서 동료가 있는 연습을 고르면\n{F003}그 선수와 {FC06}태그 연습{FC05}을 하게 됩니다.{FC01}{F003}태그 연습을 하면 {FC08}동료의 능력도\n{F003}자동으로 오르며, 동료가 적을수록\n{F003}동료의 능력이 잘 오릅니다{FC05}.{FC01}{F003}강화 연습, 코치 연습의 효과는\n{F003}동료에게도 똑같이 반영됩니다.{FC03}"}
{"id": 8307, "ko": "자, 질문 있나요?{FC01}"}
{"id": 8308, "ko": "없습니다!"}
{"id": 8309, "ko": "좋아하는 남자 타입?"}
{"id": 8310, "ko": "딱히 없나 보네요.{FC01}"}
{"id": 8311, "ko": "없습니다!{FC03}"}
{"id": 8312, "ko": "어머, {F010}, 기운차서 좋네요.{FC01}"}
{"id": 8313, "ko": "꽤 좋은 대답이었으니 급료를 올려 줄게요.{FC03}"}
{"id": 8314, "ko": "아, {F010}군, 좋겠소.{FC03}"}
{"id": 8315, "ko": "그 밖엔 딱히 없나 봐요.{FC01}"}
{"id": 8316, "ko": "좋아하는 남자 타입?{FC03}{FC22}"}
{"id": 8317, "ko": "급료 삭감이에요!{FC03}"}
{"id": 8318, "ko": "아아~ 역시 안 됐나…{FC20}"}
{"id": 8319, "ko": "오늘은 기분이 별로군.{FC03}"}
{"id": 8320, "ko": "꽤 재밌는 질문이네요.{FC01}"}
{"id": 8321, "ko": "하지만 대답은 연습 끝나고 해도 될까요?{FC03}"}
{"id": 8322, "ko": "오, 오늘은 기분 좋아 보여{FC01}"}
{"id": 8323, "ko": "나중에 감독님께 코치받아야지!{FC03}"}
{"id": 8324, "ko": "그럼 연습 시작하세요.{FC03}"}
{"id": 8325, "ko": "연습 시작!{FC03}"}
{"id": 8326, "ko": "역시 AAA 클래스가 되니\n연습이 혹독하오.{FC03}"}
{"id": 8327, "ko": "그래, 그러니 배도 더 고파~.{FC01}{F121}{FFE8:0298}군, 빨리 뭐 먹으러 가자.{FC03}"}
{"id": 8328, "ko": "어디로 먹으러 가겠소?{FC01}"}
{"id": 8329, "ko": "패스트푸드점"}
{"id": 8330, "ko": "구로의 방"}
{"id": 8331, "ko": "나 엄청 배고파서 빨리 먹고 싶으니까\n"}
{"id": 8332, "ko": "패스트푸드로 하자.{FC03}"}
{"id": 8333, "ko": "그러오.{FC01}"}
{"id": 8334, "ko": "무엇보다 싸게 먹히니 말이오{FC03}"}
{"id": 8335, "ko": "어차피 난 가난뱅이야.{FC20}"}
{"id": 8336, "ko": "아무래도 삐딱한 성격인 것 같소,\n"}
{"id": 8337, "ko": "자넨.{FC03}"}
{"id": 8338, "ko": "아니, 진짜로 가난하다니까.{FC03}"}
{"id": 8339, "ko": "어머, 왠지 딱한 얘기를 하네요.{FC03}"}
{"id": 8340, "ko": "그렇게 곤란하다면\n"}
{"id": 8341, "ko": "특별히 급료를 올려 줄게요.{FC01}"}
{"id": 8342, "ko": "그러니 그만큼 앞으로도 힘내세요.{FC03}"}
{"id": 8343, "ko": "네, 정말요!?{FC01}"}
{"id": 8344, "ko": "감사합니다, GM!{FC01}"}
{"id": 8345, "ko": "오늘은 왠지 엄청 예쁘시네요.{FC03}"}
{"id": 8346, "ko": "어머, 늘 그래요.{FC01}"}
{"id": 8347, "ko": "아부도 좀 더 공부하세요.{FC01}"}
{"id": 8348, "ko": "그럼 안녕히,"}
{"id": 8349, "ko": "…{FFE8:0296} GM은\n"}
{"id": 8350, "ko": "꽤 좋은 사람이구려.{FC03}"}
{"id": 8351, "ko": "근데 뭔가 속셈이 있어 보여.{FC03}"}
{"id": 8352, "ko": "좋아, {FFE8:0298}군 방에 가자.{FC03}"}
{"id": 8353, "ko": "에, 그건 {FFE8:0298}에게 밥을 해 달라는\n"}
{"id": 8354, "ko": "말이오?{FC03}"}
{"id": 8355, "ko": "응, 그런 거지.{FC03}"}
{"id": 8356, "ko": "그건 안 되오.{FC03}"}
{"id": 8357, "ko": "왜 안 되는데?{FC03}"}
{"id": 8358, "ko": "그, 그건…{FC20}"}
{"id": 8359, "ko": "비밀이오.{FC01}"}
{"id": 8360, "ko": "그러니 {FFE8:0298}가 좋아하는 레스토랑에\n"}
{"id": 8361, "ko": "가겠소.{FC03}"}
{"id": 8362, "ko": "그래…?"}
{"id": 8363, "ko": "그럼 그러자.{FC03}"}
{"id": 8364, "ko": "좋아, 오늘은 급료도 나왔으니\n레스토랑에 가자!{FC03}"}
{"id": 8365, "ko": "그럼 {FFE8:0293}는\n"}
{"id": 8366, "ko": "어떻소?{FC01}{FFE8:0298}가 좋아하는 가게요.{FC03}"}
{"id": 8367, "ko": "OK, 거기 가자!{FC03}"}
{"id": 8368, "ko": "도착했소, 이 가게요.{FC03}"}
