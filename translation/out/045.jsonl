{"id": 10968, "ko": "{D019} 선수의 장점이{D000}잘 드러났던 것 같아요."}
{"id": 10969, "ko": "오늘 기사 잘 써지겠어요.{D000}다음 경기도 힘내세요!"}
{"id": 10970, "ko": "{D019} 선수.{D000}오늘 타격 정말 멋졌어요."}
{"id": 10971, "ko": "{D019} 선수.{D000}오늘은 아쉬웠어요.{D000}이런 날도 있는 거죠."}
{"id": 10972, "ko": "다음 경기에서 만회하면 돼요!{D000}힘내세요!"}
{"id": 10973, "ko": "{D019} 씨.{D000}이거, 반지…?"}
{"id": 10974, "ko": "{D019} 씨는{D000}제 인생을 바꿔 줬어요."}
{"id": 10975, "ko": "남의 나쁜 점만 보고,{D000}좋은 점은 보려 하지 않던{D000}예전의 나."}
{"id": 10976, "ko": "그런 저를 받아 주고,{D000}다정하게 대해 줬죠."}
{"id": 10977, "ko": "그래서 저, 변했어요."}
{"id": 10978, "ko": "야구 좋아하는 팬에서{D000}어엿한 야구 기자로."}
{"id": 10979, "ko": "제가 기자로서{D000}잘해 나가는 건,"}
{"id": 10980, "ko": "{D019} 선수{D000}덕분이에요."}
{"id": 10981, "ko": "그나저나."}
{"id": 10982, "ko": "{D019} 선수가{D000}제 인생을 바꿔 주는 건{D000}이번이 두 번째네요."}
{"id": 10983, "ko": "잘 바뀌면 좋겠다.{D000}야구 기자에서{D000}메이저리거의 아내로."}
{"id": 10984, "ko": "{D019} 씨.{D000}앞으로 잘 부탁드려요."}
{"id": 10985, "ko": "{D02D}리사{D02A}와 약혼했다."}
{"id": 10986, "ko": "{D02D}리사{D02A} 앞에 무릎 꿇고{D000}살며시 왼손을 잡았다."}
{"id": 10987, "ko": "애나 앞에 무릎 꿇고{D000}살며시 왼손을 잡았다."}
{"id": 10988, "ko": "이건, 혹시…"}
{"id": 10989, "ko": "정말 저라도 괜찮으신{D000}건가요?"}
{"id": 10990, "ko": "왠지 믿기지가 않아요…"}
{"id": 10991, "ko": "반지를 받다니 너무 과분한{D000}일일지도 모르지만, 이 반지"}
{"id": 10992, "ko": "만큼은 진심으로 소중히 할게요"}
{"id": 10993, "ko": "저는{D000}{D019} 님을{D000}만나고서,"}
{"id": 10994, "ko": "딱 하나, 누구에게도 지지{D000}않는다 자부할 게 생겼어요."}
{"id": 10995, "ko": "그건 {D019} 님을{D000}사랑한다는 거예요."}
{"id": 10996, "ko": "앞으로는 쭉 함께네요."}
{"id": 10997, "ko": "우리 힘을 합쳐서{D000}세상을 아이들 웃음으로{D000}가득 채워요!"}
{"id": 10998, "ko": "애나와 약혼했다!"}
{"id": 10999, "ko": "니콜 앞에 무릎 꿇고{D000}살며시 왼손을 잡았다."}
{"id": 11000, "ko": "{D019}!{D000}이건, 혹시…"}
{"id": 11001, "ko": "내가 드디어 메이저리거한테{D000}청혼을 받은 건가."}
{"id": 11002, "ko": "너를 만나서,"}
{"id": 11003, "ko": "네 팬이 되어서,"}
{"id": 11004, "ko": "야구를 보게 되고."}
{"id": 11005, "ko": "네 활약에 기뻐하고,"}
{"id": 11006, "ko": "네 실수에 분해하고 있어."}
{"id": 11007, "ko": "어느새 내 생활은{D000}너를 중심으로 돌고 있었네."}
{"id": 11008, "ko": "그래도 널 보고 있으면 불안해."}
{"id": 11009, "ko": "슬라이딩할 때,{D000}넘어질 때,"}
{"id": 11010, "ko": "혹시 다친 건 아닐까{D000}너무 걱정됐어."}
{"id": 11011, "ko": "하지만 그것도 오늘까지야."}
{"id": 11012, "ko": "내일부턴 내가 곁에 있어."}
{"id": 11013, "ko": "웬만한 부상은{D000}금방 고쳐 줄게."}
{"id": 11014, "ko": "그러니까 앞으로도 계속,"}
{"id": 11015, "ko": "앞으로는 더,{D000}전력 플레이를 보여 줘!"}
{"id": 11016, "ko": "니콜과 약혼했다!"}
