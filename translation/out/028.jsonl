{"id": 7183, "ko": "드디어 올해도 연봉 협상{D000}시기가 왔네요."}
{"id": 7184, "ko": "올해는 대활약하셨으니{D000}협상할 맛이 나겠어요."}
{"id": 7185, "ko": "저한테 맡기시고 편하게{D000}기다려 주세요."}
{"id": 7186, "ko": "올해 성적은….{D000}어떻게든 잘 협상해 볼게요."}
{"id": 7187, "ko": "수고하셨습니다."}
{"id": 7188, "ko": "제 입으로 말하긴 뭐하지만{D000}이번 협상은 대성공이었어요!"}
{"id": 7189, "ko": "다음 기회에도 잘{D000}부탁드려요!"}
{"id": 7190, "ko": "이번 계약은 무난한{D000}수준이었네요."}
{"id": 7191, "ko": "다음엔 더 열심히 할 테니{D000}잘 부탁드려요!"}
{"id": 7192, "ko": "이번에는 아쉬운 결과로{D000}끝나 버려서{D000}죄송합니다."}
{"id": 7193, "ko": "다음엔 꼭 좋은 결과를{D000}낼 테니,"}
{"id": 7194, "ko": "실망 마시고{D000}또 부탁드려요."}
{"id": 7195, "ko": "그러세요, 만족스럽지{D000}않으셨군요…."}
{"id": 7196, "ko": "협상도 슬슬{D000}한계에 왔어요."}
{"id": 7197, "ko": "다음이 마지막 협상입니다."}
{"id": 7198, "ko": "그럼 다녀오겠습니다!"}
{"id": 7199, "ko": "협상 결과, 이런 조건으로{D000}합의가 될 것 같아요."}
{"id": 7200, "ko": "어떠세요?"}
{"id": 7201, "ko": "사인한다"}
{"id": 7202, "ko": "조금 더 협상해 줘"}
{"id": 7203, "ko": "알겠습니다.{D000}그럼 이 조건으로 사인하죠."}
{"id": 7204, "ko": "알겠습니다!{D000}다시 협상하고 올게요!"}
{"id": 7205, "ko": "협상 결과, 최종적으로 이런{D000}조건에 합의될 듯해요."}
{"id": 7206, "ko": "그럼 사인해 주세요."}
{"id": 7207, "ko": "사인했다."}
{"id": 7208, "ko": "계약해 주셔서 감사합니다."}
{"id": 7209, "ko": "의뢰를 받은 이상{D000}1년간 확실하게 도와{D000}드리겠습니다."}
{"id": 7210, "ko": "잘 부탁드려요."}
{"id": 7211, "ko": "올해는 FA 자격이 있으니{D000}FA 선수가 될 수 있어요."}
{"id": 7212, "ko": "괜찮으시면 FA에 대해{D000}설명해 드릴까요?"}
{"id": 7213, "ko": "괜찮아요"}
{"id": 7214, "ko": "그래요."}
{"id": 7215, "ko": "알겠습니다, 설명할게요."}
{"id": 7216, "ko": "FA 자격이 있으면,"}
{"id": 7217, "ko": "「사인한다」"}
{"id": 7218, "ko": "「조금 더 협상해 줘」"}
{"id": 7219, "ko": "「협상을 끊고 FA 선언」{D000}선택지가 셋입니다."}
{"id": 7220, "ko": "FA가 되면,"}
{"id": 7221, "ko": "FA 협상 기간에 다른 구단의{D000}오퍼를 받을 수 있습니다."}
{"id": 7222, "ko": "다만, 좋은 오퍼가 올지는{D000}당신의 활약과{D000}제 실력에 달렸어요!"}
{"id": 7223, "ko": "지금 계약에 만족할 수 없거나,"}
{"id": 7224, "ko": "다른 구단에서 뛰고 싶다면"}
{"id": 7225, "ko": "FA를 선언하면 돼요."}
{"id": 7226, "ko": "그럼 먼저{D000}협상하고 올게요."}
{"id": 7227, "ko": "FA 협상 기간입니다."}
{"id": 7228, "ko": "괜찮으시면 FA 협상에 대해{D000}설명해 드릴까요?"}
{"id": 7229, "ko": "괜찮아요"}
{"id": 7230, "ko": "FA 협상은,"}
{"id": 7231, "ko": "먼저 제가{D000}지금까지 온 오퍼를{D000}보여 드립니다."}
{"id": 7232, "ko": "연봉과 계약 기간 외에"}
{"id": 7233, "ko": "옵션 조건도{D000}오퍼에 포함되어 있으니,"}
{"id": 7234, "ko": "잘 생각해서 계약할 팀을{D000}고르세요."}
{"id": 7235, "ko": "FA 협상 기간은 2주라서{D000}첫 주엔 계약을 미룰 수도{D000}있습니다."}
{"id": 7236, "ko": "둘째 주에 오는 오퍼는{D000}첫 주와는 달라집니다."}
{"id": 7237, "ko": "더 좋은 오퍼가 올지{D000}오퍼가 끊길지는{D000}알 수 없으니 주의하세요."}
{"id": 7238, "ko": "둘째 주가 끝날 때까지{D000}오퍼가 하나도 없으면{D000}게임 오버가 됩니다."}
{"id": 7239, "ko": "그럼 바로…{D000}지금까지 온{D000}오퍼를 살펴볼게요."}
{"id": 7240, "ko": "{D019}씨,{D000}안녕하세요."}
{"id": 7241, "ko": "그럼 바로{D000}이번 주 FA 오퍼를{D000}살펴볼게요."}
{"id": 7242, "ko": "이번 주 오퍼는{D000}이렇습니다."}
{"id": 7243, "ko": "이번 주에는 어느 팀에서도{D000}오퍼가 안 온 것 같아요…."}
{"id": 7244, "ko": "아직 다음 주가 있으니{D000}기대하며 기다려요."}
{"id": 7245, "ko": "그럼 실례하겠습니다."}
{"id": 7246, "ko": "{D019}씨에게{D000}새 오퍼가 도착했어요!"}
{"id": 7247, "ko": "FA 협상은 이번 주까지예요."}
{"id": 7248, "ko": "이 중에서 꼭 내년 시즌{D000}계약할 구단을 골라{D000}주세요."}
{"id": 7249, "ko": "어느 팀에서도 오퍼가{D000}안 온 것 같아요…."}
{"id": 7250, "ko": "{D019}씨,{D000}정말 말씀드리기 어렵지만,"}
{"id": 7251, "ko": "계약할 팀이 없어서{D000}올해로 은퇴하게 됩니다…"}
{"id": 7252, "ko": "그동안 정말 수고하셨습니다.{D000}제2의 인생도 힘내세요."}
{"id": 7253, "ko": "{D017}와{D000}이 조건으로 계약하시네요!"}
{"id": 7254, "ko": "그럼 바로 수속을{D000}밟고 올게요."}
{"id": 7255, "ko": "다음 기회에도 잘{D000}부탁드려요!"}
{"id": 7256, "ko": "이번 주는 계약 보류네요."}
{"id": 7257, "ko": "다음 주엔 더 좋은{D000}오퍼를 받을 수 있게{D000}힘써 볼게요!"}
{"id": 7258, "ko": "올해도 연봉 협상{D000}시기가 왔네요."}
{"id": 7259, "ko": "{D019}씨는 다년 계약을{D000}맺고 있어서,"}
{"id": 7260, "ko": "올해는 특별히{D000}협상할 게 없어요."}
{"id": 7261, "ko": "그럼 수속하고 올게요."}
{"id": 7262, "ko": "내년에도 꼭{D000}잘 부탁드려요!"}
{"id": 7263, "ko": "{D019}씨,{D000}올 한 해 수고하셨어요."}
{"id": 7264, "ko": "오늘은 올 시즌 계약 옵션{D000}확인차 왔습니다."}
{"id": 7265, "ko": "올해는{D02D}{D002}{D02A}을(를){D000}훌륭히 달성했네요!{D000}축하드려요!"}
{"id": 7266, "ko": "{D02D}{D003}{D02A}이(가){D000}구단에서 지급되니{D000}확인해 두세요."}
{"id": 7267, "ko": "그럼 내년에도 힘내세요!"}
{"id": 7268, "ko": "{D02D}{D003}{D02A}받았다."}
{"id": 7269, "ko": "올해는 {D02D}{D002}{D02A}을(를){D000}달성하지 못했네요…"}
{"id": 7270, "ko": "저도 아쉬워요."}
{"id": 7271, "ko": "내년엔 꼭 힘내요!"}
