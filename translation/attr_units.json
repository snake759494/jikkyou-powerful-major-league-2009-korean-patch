[{"src": "P1466", "off": 320, "n": 15, "jp": "いま選んだものを、購入するよ。"}, {"src": "P1466", "off": 392, "n": 18, "jp": "いま選んだものを、キャンセルするよ。"}, {"src": "P1466", "off": 464, "n": 18, "jp": "選んだものをぜんぶキャンセルしたよ。"}, {"src": "P1466", "off": 536, "n": 13, "jp": "買いものカゴに入れるわね。"}, {"src": "P1466", "off": 608, "n": 12, "jp": "まだ何も選んでいないよ。"}, {"src": "P1466", "off": 752, "n": 19, "jp": "そのアイテムは、まだ入荷していないよ。"}, {"src": "P1466", "off": 824, "n": 23, "jp": "そのアイテムは、買いものカゴに\n入っているよ。"}, {"src": "P1466", "off": 896, "n": 15, "jp": "そのアイテムは、売り切れだよ。"}, {"src": "P1466", "off": 1040, "n": 28, "jp": "全選手コンプリートおめでとう！\n選手カードは売り切れよ。"}, {"src": "P1466", "off": 1184, "n": 21, "jp": "新しい打撃フォームが\n使えるようになるよ。"}, {"src": "P1466", "off": 1256, "n": 21, "jp": "新しい投球フォームが\n使えるようになるよ。"}, {"src": "P1466", "off": 1328, "n": 17, "jp": "選手カードを\n買うことができるよ。"}, {"src": "P1466", "off": 1400, "n": 21, "jp": "新しいユニフォームが\n使えるようになるよ。"}, {"src": "P1466", "off": 1544, "n": 15, "jp": "投球フォームの種類を選んでね。"}, {"src": "P1466", "off": 1616, "n": 15, "jp": "打撃フォームの種類を選んでね。"}, {"src": "P1466", "off": 1688, "n": 13, "jp": "好きなフォームを選んでね。"}, {"src": "P1466", "off": 1760, "n": 13, "jp": "好きなフォームを選んでね。"}, {"src": "P1466", "off": 1904, "n": 15, "jp": "好きなユニフォームを選んでね。"}, {"src": "P1466", "off": 1976, "n": 18, "jp": "選手カードを１枚買うことができるよ。"}, {"src": "P1466", "off": 2048, "n": 18, "jp": "野手カードを１枚買うことができるよ。"}, {"src": "P1466", "off": 2120, "n": 18, "jp": "投手カードを１枚買うことができるよ。"}, {"src": "P1466", "off": 2192, "n": 12, "jp": "選手カード５枚入りだよ。"}, {"src": "P1466", "off": 2264, "n": 12, "jp": "野手カード５枚入りだよ。"}, {"src": "P1466", "off": 2336, "n": 12, "jp": "投手カード５枚入りだよ。"}, {"src": "P1466", "off": 2408, "n": 13, "jp": "選手カード１０枚入りだよ。"}, {"src": "P1466", "off": 2480, "n": 13, "jp": "野手カード１０枚入りだよ。"}, {"src": "P1466", "off": 2552, "n": 13, "jp": "投手カード１０枚入りだよ。"}, {"src": "P1466", "off": 2624, "n": 18, "jp": "選手カードどどーんと３０枚入りだよ。"}, {"src": "P1466", "off": 2912, "n": 29, "jp": "「選手エディット」モードで、\n選手をお好みに編集できるよ。"}, {"src": "P1466", "off": 2984, "n": 19, "jp": "地方ボールパークが使えるようにな